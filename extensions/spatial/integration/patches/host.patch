+#[async_trait]
+pub trait OAuthProvider: Send + Sync {
+    async fn azure_cli(&self, _config: &AuthConfig) -> ServiceResult<OAuthGrant> { Err(failure(ErrorCode::CapabilityUnavailable)) }
+    async fn device_begin(&self, config: &AuthConfig) -> ServiceResult<StandardDeviceAuthorizationResponse>;
+    async fn device_finish(&self, config: &AuthConfig, device: StandardDeviceAuthorizationResponse, signal: CancellationSignal) -> ServiceResult<OAuthGrant>;
+    async fn client_credentials(&self, config: &AuthConfig, secret: &Secret) -> ServiceResult<OAuthGrant>;
+    async fn refresh(&self, config: &AuthConfig, refresh: &Secret, previous_principal: Option<&str>) -> ServiceResult<OAuthGrant>;
+}
