+        }
+        output.snapshot = Some(snapshot);
+        output.data = value.get("data").cloned().unwrap_or(Value::Null);
+    } else { output.data = value.get("data").cloned().unwrap_or(value); }
+    validate_output_metadata(&output)?;
+    Ok(output)
+}
