@@ -0,0 +1,102 @@
+use std::{path::PathBuf, sync::Arc, time::Duration};
+use async_trait::async_trait;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use crate::{ai_approval::{self, ApprovalDecision, PendingApproval}, persistence};
+use crate::services::{backend::SavedConnection, contracts::{ErrorCode, Operation, ServiceRequest}, dispatch::{CallerContext, CallerTransport}, error::{failure, ServiceResult}, policy::{ApprovalBackend, ApprovalGrant}, security::value_hash, storage::{now_ms, PrivateStore}};
+
+const CREATE_SCOPE: &str = "__connection_create__";
+#[derive(Serialize, Deserialize)]
+struct ApprovalBinding { caller_id:String, owner_instance_id:String, connection_id:String, request_id:String, request_hash:String, created_at_ms:u64, deadline_at_ms:u64, pending:PendingApproval }
+
+pub struct ServiceApprovals { profile:PathBuf, bindings:PrivateStore, local_caller_id:String }
+impl ServiceApprovals {
+    pub fn new(profile:PathBuf, local_caller_id:String) -> ServiceResult<Arc<Self>> { Ok(Arc::new(Self { bindings:PrivateStore::new(profile.join("service-approval-bindings-v1"), 1024*1024)?, profile, local_caller_id })) }
+    pub fn profile(&self) -> &std::path::Path { &self.profile }
+    fn id(id:&str) -> ServiceResult<()> { let parsed=uuid::Uuid::parse_str(id).map_err(|_| failure(ErrorCode::WriteNotAllowed))?; if parsed.to_string()!=id || parsed.get_version_num()!=4 { return Err(failure(ErrorCode::WriteNotAllowed)); } Ok(()) }
+    fn path(&self,id:&str,suffix:&str) -> ServiceResult<PathBuf> { Self::id(id)?; Ok(self.profile.join("pending_approvals").join(format!("{id}.{suffix}.json"))) }
+    fn read_pending(&self,id:&str) -> ServiceResult<Option<PendingApproval>> {
+        let Some(bytes)=persistence::service_read_file(&self.path(id,"pending")?,1024*1024,true)? else{return Ok(None)};
+        let parsed:PendingApproval=serde_json::from_slice(&bytes).map_err(|_|failure(ErrorCode::WriteNotAllowed))?;
+        if ai_approval::read_pending_in(&self.profile,id).map_err(|_|failure(ErrorCode::WriteNotAllowed))?.as_ref()!=Some(&parsed) {return Err(failure(ErrorCode::WriteNotAllowed));} Ok(Some(parsed))
+    }
+    fn read_decision(&self,id:&str) -> ServiceResult<Option<ApprovalDecision>> {
+        let Some(bytes)=persistence::service_read_file(&self.path(id,"decision")?,16*1024,true)? else{return Ok(None)};
+        let parsed:ApprovalDecision=serde_json::from_slice(&bytes).map_err(|_|failure(ErrorCode::WriteNotAllowed))?;
+        if ai_approval::read_decision_in(&self.profile,id).map_err(|_|failure(ErrorCode::WriteNotAllowed))?.as_ref()!=Some(&parsed) {return Err(failure(ErrorCode::WriteNotAllowed));} Ok(Some(parsed))
+    }
+    fn cleanup_locked(&self,id:&str) { let _=self.bindings.remove(id);for suffix in ["pending","decision"] {if let Ok(path)=self.path(id,suffix){let _=std::fs::remove_file(path);}} }
+    fn cleanup(&self,id:&str) {if let Ok(_lock)=self.bindings.lock(){self.cleanup_locked(id);} }
+    pub fn approve_pending(&self,id:&str,decision:&ApprovalDecision,caller:&CallerContext) -> ServiceResult<()> {
+        Self::id(id)?; if caller.caller_id!=self.local_caller_id || !matches!(caller.transport,CallerTransport::Gui|CallerTransport::Cli) {return Err(failure(ErrorCode::PermissionDenied));}
+        let _lock=self.bindings.lock()?;
+        let binding=self.bindings.read::<ApprovalBinding>(id)?.ok_or_else(||failure(ErrorCode::WriteNotAllowed))?;
+        if binding.caller_id!=caller.caller_id || binding.deadline_at_ms<=now_ms() || self.read_pending(id)?.as_ref()!=Some(&binding.pending) || self.read_decision(id)?.is_some(){return Err(failure(ErrorCode::WriteNotAllowed));}
+        validate_decision(id,decision,&binding)?;
+        persistence::service_write_atomic(&self.path(id,"decision")?,&serde_json::to_vec(decision).map_err(|_|failure(ErrorCode::WriteNotAllowed))?)
+    }
+    async fn wait(&self,connection:&SavedConnection,caller:&CallerContext,request:&ServiceRequest,request_hash:&str) -> ServiceResult<ApprovalGrant> {
+        if caller.caller_id!=self.local_caller_id || request_hash!=value_hash(&serde_json::to_value(request).map_err(|_|failure(ErrorCode::WriteNotAllowed))?) {return Err(failure(ErrorCode::WriteNotAllowed));}
+        let scope=request.connection_id.as_deref().unwrap_or(CREATE_SCOPE);
+        if connection.id!=scope {return Err(failure(ErrorCode::WriteNotAllowed));}
+        let id=uuid::Uuid::new_v4().to_string(); let created=now_ms(); let deadline=created.saturating_add(request.deadline_ms);
+        let pending=PendingApproval {id:id.clone(),created_at:chrono::Utc::now().to_rfc3339(),session_id:caller.owner_instance_id.clone(),connection_id:request.connection_id.clone().unwrap_or_default(),connection_name:connection.name.clone(),query:approval_display(request)?,query_kind:format!("service:{}",serde_json::to_value(request.operation).map_err(|_|failure(ErrorCode::WriteNotAllowed))?.as_str().ok_or_else(||failure(ErrorCode::WriteNotAllowed))?),client_hint:Some("service".into()),explain_plan:None,explain_error:None};
+        let binding=ApprovalBinding {caller_id:caller.caller_id.clone(),owner_instance_id:caller.owner_instance_id.clone(),connection_id:scope.into(),request_id:request.request_id.clone(),request_hash:request_hash.into(),created_at_ms:created,deadline_at_ms:deadline,pending};
+        let _cleanup=ApprovalCleanup {approvals:self,id:&id};
+        {
+            let _lock=self.bindings.lock()?;
+            for old in self.bindings.ids()? {if let Some(old_binding)=self.bindings.read::<ApprovalBinding>(&old)?{if old_binding.deadline_at_ms<=created{self.cleanup_locked(&old);}}}
+            if self.bindings.ids()?.len()>=64{return Err(failure(ErrorCode::ResourceLimit));}
+            self.bindings.write(&id,&binding)?;
+            persistence::service_write_atomic(&self.path(&id,"pending")?,&serde_json::to_vec(&binding.pending).map_err(|_|failure(ErrorCode::WriteNotAllowed))?).map_err(|_|failure(ErrorCode::WriteNotAllowed))?;
+        }
+        loop {
+            if now_ms()>=deadline{return Err(failure(ErrorCode::DeadlineExceeded));}
+            {
+                let _lock=self.bindings.lock()?;
+                let current=self.bindings.read::<ApprovalBinding>(&id)?.ok_or_else(||failure(ErrorCode::WriteNotAllowed))?;
+                if current.caller_id!=caller.caller_id || current.owner_instance_id!=caller.owner_instance_id || current.connection_id!=scope || current.request_id!=request.request_id || current.request_hash!=request_hash || current.created_at_ms!=created || current.deadline_at_ms!=deadline || current.pending!=binding.pending || self.read_pending(&id)?.as_ref()!=Some(&binding.pending) {return Err(failure(ErrorCode::WriteNotAllowed));}
+                if let Some(decision)=self.read_decision(&id)? {
+                    validate_decision(&id,&decision,&current)?;
+                    self.cleanup_locked(&id);
+                    if decision.decision!="approve"{return Err(failure(ErrorCode::WriteNotAllowed));}
+                    return Ok(ApprovalGrant {approval_id:id.clone(),connection_id:scope.into(),caller_id:caller.caller_id.clone(),owner_instance_id:caller.owner_instance_id.clone(),request_id:request.request_id.clone(),request_hash:request_hash.into()});
+                }
+            }
+            tokio::time::sleep(Duration::from_millis(20).min(Duration::from_millis(deadline.saturating_sub(now_ms())))).await;
+        }
+    }
+    pub async fn configuration(&self,caller:&CallerContext,request:&ServiceRequest) -> ServiceResult<()> {
+        let scope=request.connection_id.as_deref().unwrap_or(CREATE_SCOPE);
+        let connection=SavedConnection {id:scope.into(),name:request.input["name"].as_str().unwrap_or(scope).into(),driver:String::new(),settings:Value::Null,credential_ref:None,version:0,allow_writes:false,auth_revision:String::new()};
+        let hash=value_hash(&serde_json::to_value(request).map_err(|_|failure(ErrorCode::WriteNotAllowed))?);
+        self.wait(&connection,caller,request,&hash).await.map(|_|())
+    }
+}
+struct ApprovalCleanup<'a> {approvals:&'a ServiceApprovals,id:&'a str}
+impl Drop for ApprovalCleanup<'_> {fn drop(&mut self){self.approvals.cleanup(self.id);}}
+#[async_trait]
+impl ApprovalBackend for ServiceApprovals {async fn consume(&self,connection:&SavedConnection,caller:&CallerContext,request:&ServiceRequest,request_hash:&str)->ServiceResult<ApprovalGrant>{self.wait(connection,caller,request,request_hash).await}}
+
+fn validate_decision(id:&str,decision:&ApprovalDecision,binding:&ApprovalBinding)->ServiceResult<()> {
+    let timestamp=chrono::DateTime::parse_from_rfc3339(&decision.decided_at).map_err(|_|failure(ErrorCode::WriteNotAllowed))?.timestamp_millis();
+    if decision.approval_id!=id || !matches!(decision.decision.as_str(),"approve"|"deny") || decision.edited_query.is_some() || timestamp<0 || now_ms()>=binding.deadline_at_ms || (timestamp as u64)<binding.created_at_ms || (timestamp as u64)>binding.deadline_at_ms || (timestamp as u64)>now_ms().saturating_add(5000) || decision.reason.as_ref().is_some_and(|reason|reason.len()>4096) {return Err(failure(ErrorCode::WriteNotAllowed));} Ok(())
+}
+fn approval_display(request:&ServiceRequest)->ServiceResult<String> {
+    if request.operation==Operation::ConnectionCreate { crate::services::security::validate_settings(&request.input["settings"])?; }
+    if request.operation==Operation::ConnectionUpdate { crate::services::security::validate_settings(&request.input["patch"])?; }
+    let operation=serde_json::to_value(request.operation).map_err(|_|failure(ErrorCode::WriteNotAllowed))?;
+    let input=match request.operation {
+        Operation::DocumentCreate|Operation::DocumentReplace|Operation::DocumentDelete|Operation::RowInsert|Operation::RowUpdate|Operation::RowDelete=>{
+            let mut target=serde_json::Map::new();for field in ["database","schema","table","container","identity","partition_key","if_match"]{if let Some(value)=request.input.get(field){target.insert(field.into(),value.clone());}}
+            if request.operation==Operation::DocumentCreate {if let Some(id)=request.input["document"].get("id"){target.insert("id".into(),id.clone());}}
+            let body=request.input.get("document").or_else(||request.input.get("values")).or_else(||request.input.get("changes"));
+            let fields=body.and_then(Value::as_object).map(|body|body.keys().cloned().collect::<Vec<_>>()).unwrap_or_default();
+            json!({"target":target,"body_hash":body.map(value_hash),"fields":fields,"change_count":body.map(|body|body.as_object().map(|body|body.len()).or_else(||body.as_array().map(|body|body.len())).unwrap_or(1)).unwrap_or(0)})
+        }
+        Operation::CredentialImport=>json!({"connection_id":request.connection_id,"slot":request.input["slot"],"input_channel":request.input["input_channel"],"persistence":request.input["persistence"]}),
+        _=>request.input.clone(),
+    };
+    let display=serde_json::to_string(&json!({"operation":operation,"input":input})).map_err(|_|failure(ErrorCode::WriteNotAllowed))?;
+    if display.len()>512*1024 {return Err(failure(ErrorCode::ResourceLimit));} Ok(display)
+}
