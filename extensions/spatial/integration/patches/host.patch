+#[test]
+fn 모든_operation의_입력_스키마를_레지스트리에서_얻는다() {
+    // given
+    let validator = SchemaValidator::new().unwrap();
+    let names = validator.operation_names();
+
+    // when
+    let actual: Vec<Value> = names.iter().map(|name| validator.input_schema(serde_json::from_value(json!(name)).unwrap())).collect();
+
+    // then
+    assert_eq!(names.len(), 49);
+    assert!(actual.iter().all(|schema| schema["additionalProperties"] == false));
+}
+
+#[tokio::test]
+async fn 연결되지_않은_핸들러는_미지원_오류를_반환한다() {
+    // given
+    let dispatcher = ServiceDispatcher::new().unwrap();
+    let request = dispatcher.validator.decode_request(&json!({"protocol_version":1,"operation":"connection.list","request_id":"unavailable","input":{}})).unwrap();
+    let caller = CallerContext { transport: CallerTransport::Cli, caller_id: "test".into(), owner_instance_id: "owner".into() };
+
+    // when
+    let actual = dispatcher.dispatch(&request, &caller).await;
+
+    // then
+    assert_eq!(actual.status, JobStatus::Failed);
+    assert_eq!(actual.error.as_ref().unwrap().code, ErrorCode::CapabilityUnavailable);
+    assert_eq!(actual.error.as_ref().unwrap().outcome, Outcome::NotStarted);
+    assert_eq!(actual.data, Value::Null);
+    assert!(dispatcher.validator.validate_response(&serde_json::to_value(actual).unwrap()).is_ok());
+}
