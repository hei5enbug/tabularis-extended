+async fn invalidate_after_delete(backend:&RegistryDriverBackend,resolver:&DeletedResolver,connection:&SavedConnection)->Value {
+    for id in ["conn-a","conn-b"] {
+        let mut connection=connection.clone();connection.id=id.into();
+        let mut request=request(json!({}));request.operation=Operation::ConnectionTest;request.connection_id=Some(id.into());
+        backend.execute(&connection,&request,context(id,"test")).await.unwrap();
+    }
+    resolver.deleted.store(true,std::sync::atomic::Ordering::SeqCst);
