+use std::sync::Arc;
+use serde_json::Value;
+use tauri::Manager;
+use tauri_plugin_dialog::DialogExt;
+use crate::{service_native::{NativeCore,WindowAuthority,window_authority},services::{contracts::ServiceResponse,dispatch::CallerTransport,error::{failure,redact_error,ServiceResult},contracts::ErrorCode,local_ipc::GuiApplyAck,backend::CancellationSignal}};
+
+fn window_core<R:tauri::Runtime>(window:&tauri::WebviewWindow<R>)->ServiceResult<(Arc<NativeCore>,WindowAuthority)> {
+    let app=window.app_handle();let url=window.url().map_err(|_|failure(ErrorCode::PermissionDenied))?;
+    let authority=window_authority(window.label(),url.as_str(),app.config().build.dev_url.as_ref().map(|url|url.as_str()),app.get_webview_window(window.label()).is_some())?;
+    let core=app.try_state::<Arc<NativeCore>>().ok_or_else(||failure(ErrorCode::CapabilityUnavailable))?.inner().clone();Ok((core,authority))
+}
+pub fn authorize_gui<R:tauri::Runtime>(window:&tauri::WebviewWindow<R>,main_only:bool)->ServiceResult<()> {
+    let (_,authority)=window_core(window)?;if main_only {authority.main_only()?;}Ok(())
+}
+#[tauri::command]
+pub async fn service_call<R:tauri::Runtime>(window:tauri::WebviewWindow<R>,request:Value)->ServiceResult<ServiceResponse> {
+    let (core,authority)=window_core(&window)?;authority.operation(core.decode(&request)?.operation)?;core.transport.submit(request,core.caller(CallerTransport::Gui)?).await.map_err(redact_error)
