+            }
+            ArtifactResource::Chunk { id, offset, limit } => {
+                let raw = self.artifacts.read_chunk(&id, caller, offset, limit).await.map_err(redact_error)?;
+                if serde_json::to_vec(&raw).map_err(|_| failure(ErrorCode::ResourceLimit))?.len() > 96 * 1024 { return Err(failure(ErrorCode::ResourceLimit)); }
+                let chunk: Chunk = serde_json::from_value(raw).map_err(|_| failure(ErrorCode::InvalidArgument))?;
+                let bytes = STANDARD.decode(&chunk.bytes_base64).map_err(|_| failure(ErrorCode::InvalidArgument))?;
+                let hex = |value: &str| value.len() == 64 && value.bytes().all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte));
