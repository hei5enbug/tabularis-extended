+        validate_output_metadata(&output).map_err(|mut error| { if !context.read_only { error.outcome=Outcome::Applied; } error })?;
+        Ok(output)
+    }
+    async fn continue_cursor(&self, connection: &SavedConnection, state: &CursorState, mut context: DriverContext) -> ServiceResult<DriverOutput> {
+        if !self.bounded_capabilities(connection, &mut context).await?.query_page { return Err(failure(ErrorCode::CapabilityUnavailable)); }
+        let query = state.native_state.get("query").ok_or_else(|| failure(ErrorCode::InvalidPageToken))?;
+        let cursor = json!({"binding":{"sdk_version":state.binding.sdk_version,"container_rid":state.binding.container_rid,"endpoint_identity":state.binding.endpoint_identity,"partition_hash":state.binding.partition_hash},"native_state":state.native_state,"tail":state.tail,"columns":state.columns,"page_size":state.page_size,"expires_at_ms":state.expires_at_ms});
+        let value = self.invoke(connection, ServiceRpcMethod::CosmosQueryPage, json!({"query":query,"cursor_state":cursor}), explicit_database(query), context).await?;
+        let mut output = native_output(value, connection, query)?;
+        if output.snapshot.is_none() { return Err(failure(ErrorCode::InvalidArgument)); }
+        output.warnings.push("cosmos_read_only_database_permissions_unverified".into());
+        validate_output_metadata(&output)?;
+        Ok(output)
+    }
+    async fn cancel(&self, connection_id: &str, request_id: &str) -> ServiceResult<()> {
+        let driver = self.active.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.get(&(connection_id.into(), request_id.into())).cloned();
+        if let Some(driver) = driver { driver.service_cancel(connection_id, request_id).await?; }
+        Ok(())
+    }
+    async fn reserve_session(&self, connection: &SavedConnection, database: &str, mut context: DriverContext) -> ServiceResult<String> {
+        if context.session_handle.is_some() { return Err(failure(ErrorCode::InvalidArgument)); }
+        let permit = self.session_slots.clone().try_acquire_owned().map_err(|_| failure(ErrorCode::ResourceLimit))?;
+        if !self.bounded_capabilities(connection, &mut context).await?.sessions { return Err(failure(ErrorCode::UnsupportedOperation)); }
