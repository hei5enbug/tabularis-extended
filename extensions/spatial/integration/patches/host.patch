+impl ServiceTransport {
+    pub fn tools(&self) -> ServiceResult<Value> {
+        let source: Value = serde_json::from_str(REQUEST_SCHEMA).map_err(|_| failure(ErrorCode::CapabilityUnavailable))?;
+        let mut tools = Vec::new();
+        for name in self.validator.operation_names().into_iter().chain(std::iter::once("query.execute_write".into())) {
+            let operation = if name == "query.execute_write" { "query.execute" } else { &name };
+            let schema=operation_schema(&source,operation)?;
+            tools.push(json!({"name":name,"description":format!("Common service {name}"),"inputSchema":schema}));
+        }
+        if let Some(legacy) = self.legacy.get() {
+            let additional = legacy.tools();
+            let additional = additional["tools"].as_array().ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+            let mut names: std::collections::HashSet<String> = tools.iter().filter_map(|tool| tool["name"].as_str().map(str::to_owned)).collect();
+            for tool in additional {
+                let name = tool["name"].as_str().filter(|name| !name.is_empty() && name.len() <= 128 && !name.chars().any(char::is_control)).ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+                if !names.insert(name.into()) { return Err(failure(ErrorCode::InvalidArgument)); }
+                tools.push(tool.clone());
+            }
+        }
+        let value = json!({"tools":tools});
+        if serde_json::to_vec(&value).map_err(|_| failure(ErrorCode::ResourceLimit))?.len() > request::MAX_FRAME_BYTES { return Err(failure(ErrorCode::ResourceLimit)); }
+        Ok(value)
+    }
+
+    pub async fn call_tool(self: &Arc<Self>, name: &str, arguments: Value, mut caller: CallerContext, signal: Option<CancellationSignal>) -> ServiceResult<Value> {
+        caller.transport = CallerTransport::Mcp;
+        request::validate_caller(&caller)?;
+        let alias = name == "query.execute_write";
+        let operation = if alias { "query.execute" } else { name };
+        if !self.validator.operation_names().iter().any(|name| name == operation) {
+            if let Some(legacy) = self.legacy.get() {
+                if let Some(value) = legacy.call(name, arguments, &caller).await { return Ok(value); }
+            }
+            return Err(failure(ErrorCode::UnsupportedOperation));
+        }
+        let decoded = request::decode(&self.validator, &arguments)?;
+        if serde_json::to_value(decoded.operation).ok().as_ref().and_then(Value::as_str) != Some(operation) { return Err(failure(ErrorCode::InvalidArgument)); }
+        if decoded.operation == Operation::CredentialImport { return Err(failure(ErrorCode::PermissionDenied)); }
+        let response = match self.run_one(arguments, caller, alias, signal).await { Ok(response) => response, Err(error) => request::error_response(&decoded, error) };
+        Ok(tool_result(decoded.operation, &response))
+    }
