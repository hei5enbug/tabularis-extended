+    assert_eq!(harness.driver.cancels.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn 종료된_읽기는_interrupted로_기록된다() {
+    // given
+    let directory = TestDirectory::new(); let manager = JobManager::new("owner".into(), directory.0.clone()).unwrap(); let lease = manager.begin(&query("SELECT 1"), &caller(), false, false).await.unwrap(); let id = lease.id();
+
+    // when
+    drop(lease);
+
+    // then
+    assert_eq!(manager.get(&id, "owner", &caller()).unwrap().status, JobStatus::Interrupted);
+    assert_eq!(manager.active_count(), 0);
+}
+
+#[tokio::test]
+async fn 응답을_받지_못한_쓰기는_outcome_unknown으로_기록된다() {
+    // given
+    let directory = TestDirectory::new(); let manager = JobManager::new("owner".into(), directory.0.clone()).unwrap(); let lease = manager.begin(&query("write"), &caller(), true, false).await.unwrap(); let id = lease.id(); lease.mark_write_dispatched().unwrap();
+
+    // when
+    drop(lease);
+
+    // then
+    assert_eq!(manager.get(&id, "owner", &caller()).unwrap().status, JobStatus::OutcomeUnknown);
+}
+
+#[tokio::test]
+async fn 재시작_복구는_진행중인_조회와_쓰기를_구분한다() {
+    // given
+    let directory = TestDirectory::new(); let manager = JobManager::new("owner".into(), directory.0.clone()).unwrap(); let read = manager.begin(&query("read"), &caller(), false, false).await.unwrap(); let write = manager.begin(&query("write"), &caller(), true, false).await.unwrap(); write.mark_write_dispatched().unwrap(); let read_id = read.id(); let write_id = write.id();
+
+    // when
+    manager.recover_owner("owner").unwrap();
+
+    // then
+    assert_eq!(manager.get(&read_id, "owner", &caller()).unwrap().status, JobStatus::Interrupted);
+    assert_eq!(manager.get(&write_id, "owner", &caller()).unwrap().status, JobStatus::OutcomeUnknown);
+}
+
+async fn concurrent_queries(harness: &Harness, session_id: Option<String>) -> Vec<ServiceResponse> {
+    let mut tasks = tokio::task::JoinSet::new();
+    for index in 0..20 {
+        let mut input = query("slow"); input.session_id = session_id.clone(); if session_id.is_none() && index % 2 == 1 { input.connection_id = Some("conn-b".into()); }
+        let runtime = harness.runtime.clone(); tasks.spawn(async move { runtime.call_validated(&input, &caller()).await });
+    }
+    let mut responses = Vec::new(); while let Some(response) = tasks.join_next().await { responses.push(response.unwrap()); } responses
+}
+
+#[tokio::test]
+async fn 서로_다른_연결은_전역_여덟_작업_상한_안에서_병렬로_실행된다() {
+    // given
+    let harness = Harness::new();
+
+    // when
+    let actual = concurrent_queries(&harness, None).await;
+
+    // then
+    assert!(actual.iter().all(|response| response.status == JobStatus::Succeeded));
+    assert!(harness.driver.peak.load(Ordering::SeqCst) <= 8);
+    assert!(harness.driver.peak.load(Ordering::SeqCst) > 4);
+    assert_eq!(harness.runtime.jobs.active_count(), 0);
+}
