+    let end;
+    while ((end = this.buffer.indexOf(10)) !== -1) {
+      const line = this.buffer.subarray(0, end);
+      this.buffer = this.buffer.subarray(end + 1);
+      if (!line.length) continue;
+      try {
+        const value = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(line));
