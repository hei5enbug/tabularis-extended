+        if !self.bounded_capabilities(connection, &mut context).await?.spatial { return Err(failure(ErrorCode::CapabilityUnavailable)); }
+        let database = explicit_database(&input).map(str::to_owned);
+        self.invoke(connection, method, input, database.as_deref(), context).await
+    }
+
+}
+
+#[async_trait]
+impl DriverBackend for RegistryDriverBackend {
+    async fn supports(&self, connection: &SavedConnection, operation: Operation) -> ServiceResult<bool> {
+        let capabilities = match self.capabilities(connection).await { Ok(capabilities) => capabilities, Err(error) if error.code == ErrorCode::CapabilityUnavailable => return Ok(false), Err(error) => return Err(error) };
+        if matches!(operation, Operation::SessionOpen | Operation::SessionCommit | Operation::SessionRollback | Operation::SessionClose) { return Ok(capabilities.sessions); }
+        Ok(operation_method(operation, capabilities.documents).is_some_and(|method| capabilities.supports(method)))
+    }
+    async fn read_only_guarantee(&self, connection: &SavedConnection) -> ServiceResult<ReadOnlyGuarantee> {
+        Ok(match self.capabilities(connection).await?.read_only {
+            DriverServiceReadOnly::ReadOnlyTransaction => ReadOnlyGuarantee::ReadOnlyTransaction,
+            DriverServiceReadOnly::RestrictedDatabasePrincipal => ReadOnlyGuarantee::RestrictedDatabasePrincipal,
+            DriverServiceReadOnly::ReadOnlySdkOperations => ReadOnlyGuarantee::ReadOnlySdkOperations,
+            DriverServiceReadOnly::Unavailable => ReadOnlyGuarantee::Unavailable,
+        })
+    }
+    async fn execute(&self, connection: &SavedConnection, request: &ServiceRequest, mut context: DriverContext) -> ServiceResult<DriverOutput> {
+        let capabilities = self.bounded_capabilities(connection, &mut context).await?;
+        let method = operation_method(request.operation, capabilities.documents).ok_or_else(|| failure(ErrorCode::UnsupportedOperation))?;
+        if !capabilities.supports(method) { return Err(failure(ErrorCode::CapabilityUnavailable)); }
+        if request.operation == Operation::QueryExecute && request.input["language"] != if capabilities.documents { "cosmos_sql" } else { "sql" } { return Err(failure(ErrorCode::UnsupportedOperation)); }
