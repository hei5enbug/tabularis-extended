+    // given
+    let directory = TestDirectory::new(); let manager = JobManager::new("owner".into(), directory.0.clone()).unwrap(); let lease = manager.begin(&query("SELECT 1"), &caller(), false, false).await.unwrap();
+
+    // when
+    let actual = manager.cancel(&lease.id(), "owner", &caller()).unwrap();
