+async fn wait_full_queue(driver:&RpcDriver) {
+    tokio::time::timeout(Duration::from_secs(2),async {
+        loop {
+            let stats=driver.process.send_request("fixture_stats",json!({}),Some(Duration::from_secs(1))).await.unwrap();
+            if stats["active"].as_array().unwrap().len()==64 {break;}
+            tokio::time::sleep(Duration::from_millis(2)).await;
+        }
+    }).await.unwrap();
+}
+async fn full_queue_control(driver:Arc<RpcDriver>)->(ServiceError,ServiceResult<Value>,Value) {
+    let opened=driver.service_call(ServiceRpcMethod::SessionOpen,&params(&driver.manifest.id),&context("session","open"),json!({"database":"synthetic","mode":"read_only"})).await.unwrap();
+    let mut tasks=Vec::new();let mut signals=Vec::new();
+    for index in 0..64 {
+        let mut context=context("conn",&format!("queued-{index}"));context.deadline_ms=120000;
+        signals.push(context.signal.clone());
+        tasks.push(tokio::spawn({let driver=driver.clone();async move {driver.service_call(ServiceRpcMethod::ExactQuery,&params(&driver.manifest.id),&context,query("wait_ack")).await}}));
+    }
+    wait_full_queue(&driver).await;
+    let mut extra=context("conn","extra");extra.deadline_ms=25;
+    let denied=driver.service_call(ServiceRpcMethod::ExactQuery,&params(&driver.manifest.id),&extra,query("SELECT 1")).await.unwrap_err();
+    let minimal=ConnectionParams {driver:driver.manifest.id.clone(),connection_id:Some("conn".into()),..ConnectionParams::default()};
+    driver.service_call(ServiceRpcMethod::InvalidateAuth,&minimal,&context("conn","invalidate"),json!({})).await.unwrap();
+    let mut discard=context("session","discard");discard.session_handle=Some(opened["session_handle"].as_str().unwrap().into());
+    driver.service_call(ServiceRpcMethod::SessionDiscard,&params(&driver.manifest.id),&discard,json!({})).await.unwrap();
+    driver.service_cancel("conn","queued-0").await.unwrap();
+    let first=tasks.remove(0).await.unwrap();
+    for signal in signals.iter().skip(1) {signal.cancel();}
+    for task in tasks {let _=task.await.unwrap();}
+    let stats=driver.service_call(ServiceRpcMethod::Test,&params(&driver.manifest.id),&context("conn","stats"),json!({})).await.unwrap();
+    driver.shutdown().await;
+    (denied,first,stats)
+}
+#[tokio::test]
+async fn 네이티브_호출_상한에서_추가_SQL은_송신하지_않고_취소_제어는_계속_동작한다() {
+    // given
+    let driver=Arc::new(child_driver("bounded-pending","native",json!({})).await);
+    driver.service_capabilities().await.unwrap();
+    // when
+    let (denied,cancelled,stats)=full_queue_control(driver).await;
+    // then
+    assert_eq!(denied.code,ErrorCode::DeadlineExceeded);
+    assert_eq!(denied.outcome,Outcome::NotStarted);
+    assert!(cancelled.is_ok());
+    assert_eq!(stats["queries"],64);
+}
