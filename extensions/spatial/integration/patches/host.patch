+#[test]
+fn 배포_호스트_버전과_컴파일러_최소_버전은_다섯_메타데이터에_일치한다() {
+    // given
+    let package: Value = serde_json::from_str(include_str!("../../../package.json")).expect("package metadata");
+    let config: Value = serde_json::from_str(include_str!("../../tauri.conf.json")).expect("Tauri metadata");
+    let cargo = include_str!("../../Cargo.toml");
+    let lock = include_str!("../../Cargo.lock");
+    let frontend = include_str!("../../../src/version.ts");
+    // when
+    let actual = (
+        package["version"].as_str(), config["version"].as_str(), env!("CARGO_PKG_VERSION"),
+        cargo.contains(&format!("version = \"{HOST_VERSION}\"")),
+        cargo.contains("rust-version = \"1.96.0\""),
+        lock.contains(&format!("name = \"tabularis\"\nversion = \"{HOST_VERSION}\"")),
+        frontend.contains(&format!("APP_VERSION = \"{HOST_VERSION}\"")),
+        runtime_version::evaluate_min_runtime_version("cosmos-nosql", Some(HOST_VERSION), runtime_version::HOST_VERSION, false),
+    );
+    // then
+    assert_eq!(actual.0, Some(HOST_VERSION));
+    assert_eq!(actual.1, Some(HOST_VERSION));
+    assert_eq!(actual.2, HOST_VERSION);
+    assert!(actual.3 && actual.4 && actual.5 && actual.6);
+    assert_eq!(actual.7, runtime_version::RuntimeVersionVerdict::Compatible);
+}
