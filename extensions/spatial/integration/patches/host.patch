+  expect(state.contexts.filter((item) => item.name === "row-editor-sidebar.header.actions" || item.name === "row-edit-modal.footer.before").every((item) => item.context.resultRowOrdinal === 307 && item.context.rowIndex === 307 && item.context.resultId === "snapshot-a")).toBe(true);
+  expect(screen.getByLabelText("label")).toBeDisabled();
