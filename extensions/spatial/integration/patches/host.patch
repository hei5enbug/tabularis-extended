+it("서비스 승인은 수정 SQL을 보내지 않고 원래 승인 ID를 사용한다", async () => {
+  // Given
+  vi.mocked(invoke).mockResolvedValueOnce([{ id: "approval-a", queryKind: "service:query.execute" }]).mockResolvedValue(null);
