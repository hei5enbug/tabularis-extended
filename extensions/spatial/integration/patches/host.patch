+#[async_trait]
+impl LegacyMcpBackend for NativeLegacyMcp {
+    fn tools(&self)->Value {super::handle_list_tools(&crate::config::AppConfig::default()).unwrap_or_else(|_|json!({"tools":[]}))}
+    async fn call(&self,name:&str,arguments:Value,caller:&CallerContext)->Option<Value> {
+        if !matches!(name,"list_connections"|"list_databases"|"list_tables"|"describe_table"|"run_query"){return None;}
+        let result=async {let args=arguments.as_object().ok_or_else(||failure(ErrorCode::InvalidArgument))?;let format=self.format(args)?;match self.common(name,args,caller).await?{Some(summary)=>{let mut output=super::tool_result(&summary,format).map_err(|_|failure(ErrorCode::ResourceLimit))?;output["structuredContent"]=summary;if serde_json::to_vec(&output).map_err(|_|failure(ErrorCode::ResourceLimit))?.len()>64*1024{return Err(failure(ErrorCode::ResourceLimit));}Ok(output)},None=>Ok(self.legacy("tools/call",json!({"name":name,"arguments":arguments})).await)}}.await;
+        Some(match result {Ok(value)=>value,Err(error)=>json!({"isError":true,"content":[{"type":"text","text":"Service request failed"}],"structuredContent":{"error":redact_error(error)}})})
+    }
+    async fn read(&self,uri:&str,caller:&CallerContext)->Option<Value> {
+        let name=if uri=="tabularis://connections"{Some(("list_connections",json!({})))}else{uri.strip_prefix("tabularis://").and_then(|rest|rest.strip_suffix("/schema")).filter(|id|!id.contains('/')&&!id.is_empty()).map(|id|("list_tables",json!({"connection_id":id})))};
+        let (name,args)=name?;
+        let result=self.common(name,args.as_object().expect("resource arguments"),caller).await;
+        Some(match result {Ok(Some(summary))=>json!({"contents":[{"uri":uri,"mimeType":"application/json","text":summary.to_string()}]}),Ok(None)=>self.legacy("resources/read",json!({"uri":uri})).await,Err(error)=>json!({"contents":[{"uri":uri,"mimeType":"application/json","text":json!({"error":redact_error(error)}).to_string()}]})})
+    }
+    async fn list_resources(&self,caller:&CallerContext)->Option<Value> {
+        let result=async {let core=self.core()?;let connections=core.platform.runtime.connections.list().await?;let mut resources=vec![json!({"uri":"tabularis://connections","name":"Connections List","mimeType":"application/json"})];for connection in connections {if core.platform.runtime.policy.permission(&connection,caller).await.is_ok(){resources.push(json!({"uri":format!("tabularis://{}/schema",connection.id),"name":connection.name,"mimeType":"application/json"}));}}Ok::<_,crate::services::contracts::ServiceError>(json!({"resources":resources}))}.await;
+        Some(result.unwrap_or_else(|error|json!({"resources":[],"error":redact_error(error)})))
+    }
+}
+fn sample(value:&Value,budget:&mut usize,depth:usize,truncated:&mut bool)->Value {
+    if depth>16||*budget<64 {*truncated=true;return Value::Null;}
+    *budget-=32;
+    match value {
+        Value::String(text)=>{let mut end=text.len().min((*budget).min(1024));while !text.is_char_boundary(end){end-=1;}*budget=budget.saturating_sub(end);*truncated|=end<text.len();json!(&text[..end])},
+        Value::Array(values)=>{*truncated|=values.len()>5;Value::Array(values.iter().take(5).map(|value|sample(value,budget,depth+1,truncated)).collect())},
+        Value::Object(object)=>{let mut output=Map::new();for (key,value) in object.iter().take(64){if matches!(key.as_str(),"coordinates"|"native_state"|"tail"){*truncated=true;continue;}
+            if *budget<key.len()+64{*truncated=true;break;}*budget-=key.len();output.insert(key.clone(),sample(value,budget,depth+1,truncated));}*truncated|=object.len()>64;Value::Object(output)},_=>value.clone()
+    }
+}
+fn summary(response:&ServiceResponse)->Value {
+    let mut budget=12*1024;let mut truncated=false;let data=sample(&response.data,&mut budget,0,&mut truncated);
+    json!({"request_id":response.request_id,"connection_id":response.connection_id,"status":response.status,"job_id":response.job_id,"result_id":response.result_id,"data":data,"page":response.page,"limits":response.limits,"warnings":response.warnings.iter().take(16).collect::<Vec<_>>(),"presentation_truncated":truncated})
+}
