+async fn cancel_one_connection(harness: &Harness, first: ServiceRequest, second: ServiceRequest, gates: (Arc<TestGate>,Arc<TestGate>)) -> (ServiceResponse,ServiceResponse,ServiceResponse,JobStatus) {
+    let a=harness.runtime.submit(first,caller()).await; let b=harness.runtime.submit(second,caller()).await;
+    tokio::join!(gates.0.wait_entered(),gates.1.wait_entered());
+    let cancelled=harness.call(&request(Operation::JobCancel,json!({"job_id":a.job_id,"owner_instance_id":"owner"}))).await;
+    let b_running=harness.runtime.jobs.get(b.job_id.as_deref().unwrap(),"owner",&caller()).unwrap().status;
+    gates.1.release();
+    (cancelled,terminal(harness,a.job_id.as_deref().unwrap()).await,terminal(harness,b.job_id.as_deref().unwrap()).await,b_running)
+}
