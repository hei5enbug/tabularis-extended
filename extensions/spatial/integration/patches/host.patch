diff --git a/src-tauri/src/services/spatial/tests/spatial_support.rs b/src-tauri/src/services/spatial/tests/spatial_support.rs
new file mode 100644
index 0000000000000000000000000000000000000000..530cc5f8a4f67db3620fd7632bbafd08ad9ef749
--- /dev/null
+++ b/src-tauri/src/services/spatial/tests/spatial_support.rs
@@ -0,0 +1,152 @@
+use std::{sync::{Arc, Mutex, atomic::{AtomicUsize, Ordering}}, collections::VecDeque};
+use async_trait::async_trait;
+use serde_json::{json, Value};
+use crate::{drivers::driver_trait::ServiceRpcMethod, services::{backend::{DriverContext, SavedConnection}, contracts::{ErrorCode, Operation, ServiceRequest, ServiceResponse}, error::{failure, ServiceResult}, results::{ResultKind, ResultSet, ResultSnapshot}}};
+use super::super::{SpatialDataDomain, SpatialDriverBackend};
+use super::support;
+
+pub struct Spatial { pub calls: Mutex<Vec<(String, ServiceRpcMethod, Value)>>, pub responses: Mutex<VecDeque<ServiceResult<Value>>>, pub mode: AtomicUsize, pub gate: Mutex<Option<Arc<tokio::sync::Barrier>>>, pub entered: AtomicUsize, pub cancelled: Mutex<Vec<(String,String)>> }
+impl Spatial { pub fn new() -> Arc<Self> { Arc::new(Self { calls: Mutex::new(vec![]), responses: Mutex::new(VecDeque::new()), mode: AtomicUsize::new(0), gate: Mutex::new(None), entered: AtomicUsize::new(0), cancelled: Mutex::new(vec![]) }) } }
+#[async_trait]
+impl SpatialDriverBackend for Spatial {
+    async fn call(&self, connection: &SavedConnection, method: ServiceRpcMethod, input: Value, context: DriverContext) -> ServiceResult<Value> {
+        self.calls.lock().unwrap().push((connection.id.clone(),method,input.clone()));self.entered.fetch_add(1,Ordering::SeqCst);
+        assert!(context.read_only);assert!(context.session_handle.is_none());assert_eq!(context.connection_id,connection.id);
+        let gate=self.gate.lock().unwrap().clone();if let Some(gate)=gate {tokio::select!{_=gate.wait()=>{},_=context.signal.cancelled()=>return Err(failure(ErrorCode::Cancelled))}}
+        if let Some(response)=self.responses.lock().unwrap().pop_front(){return response;}
+        match method {
+            ServiceRpcMethod::SpatialTransformValues => {
+                let values=input["values"].as_array().unwrap();let mode=self.mode.load(Ordering::SeqCst);
+                if mode==1&&values.len()>1{return Err(failure(ErrorCode::ResourceLimit));}
+                let geometries=values.iter().map(|value|if value.is_null()||value["is_empty"]==true {Value::Null}else{json!({"type":"Point","coordinates":[1,2]})}).collect::<Vec<_>>();
+                Ok(json!({"geometries":geometries,"feature_errors":[],"warnings":[],"limits":{"truncated":false,"reasons":[]}}))
+            }
+            ServiceRpcMethod::SpatialColumns => Ok(json!({"columns":[{"column":"geom","column_index":1,"native_type":"geometry","srid":4326,"srid_status":"known","nullable":true,"primary_key":["id"]}]})),
+            ServiceRpcMethod::SpatialReadFeature => Ok(json!({"row":{"id":1,"name":"new"},"identity":input["identity"],"source":"current_row"})),
+            _=>Err(failure(ErrorCode::UnsupportedOperation)),
+        }
+    }
+    async fn cancel(&self,connection:&str,request:&str)->ServiceResult<()> {self.cancelled.lock().unwrap().push((connection.into(),request.into()));Ok(())}
