+struct ValidationGate { calls:AtomicUsize, entered:tokio::sync::Notify, release:tokio::sync::Semaphore }
+impl ValidationGate { fn new()->Self {Self {calls:AtomicUsize::new(0),entered:tokio::sync::Notify::new(),release:tokio::sync::Semaphore::new(0)}} }
+#[async_trait]
+impl crate::service_platform::connections::PreparationHook for ValidationGate {
+    async fn before_validation(&self){if self.calls.fetch_add(1,Ordering::SeqCst)==1 {self.entered.notify_one();self.release.acquire().await.unwrap().forget();}}
+}
+async fn cancel_during_preparation(harness:&Harness,request:ServiceRequest,gate:&ValidationGate)->JobRecord {
+    let gui=caller(CallerTransport::Gui);let connection_id=request.connection_id.clone();let queued=harness.runtime.submit(request,gui.clone()).await;
+    tokio::time::timeout(Duration::from_secs(2),gate.entered.notified()).await.unwrap();
+    let job_id=queued.job_id.unwrap();let mut cancel=request_for_cancel(&job_id);cancel.connection_id=connection_id;
+    let response=harness.runtime.call_validated(&cancel,&gui).await;assert_eq!(response.status,JobStatus::Succeeded);
+    gate.release.add_permits(1);
+    tokio::time::timeout(Duration::from_secs(2),async {loop {let record=harness.runtime.jobs.get(&job_id,"platform-owner",&gui).unwrap();if record.response.is_some(){return record;}tokio::time::sleep(Duration::from_millis(5)).await;}}).await.unwrap()
+}
