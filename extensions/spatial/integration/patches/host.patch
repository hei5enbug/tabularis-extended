+pub struct AzureOAuthProvider { http: Arc<dyn OAuthHttpBackend>, principal: Arc<dyn PrincipalResolver> }
+impl AzureOAuthProvider { pub fn new(http: Arc<dyn OAuthHttpBackend>, principal: Arc<dyn PrincipalResolver>) -> Self { Self { http, principal } } }
+
+#[derive(Clone, Serialize, Deserialize)]
+struct EntraExtraFields { #[serde(default)] id_token: Option<String> }
+impl fmt::Debug for EntraExtraFields { fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result { formatter.write_str("EntraExtraFields([redacted])") } }
+impl ExtraTokenFields for EntraExtraFields {}
+type EntraTokenResponse = StandardTokenResponse<EntraExtraFields, BasicTokenType>;
+type EntraClient = Client<BasicErrorResponse, EntraTokenResponse, BasicTokenIntrospectionResponse, StandardRevocableToken, BasicRevocationErrorResponse, EndpointNotSet, EndpointNotSet, EndpointNotSet, EndpointNotSet, EndpointSet>;
+
+fn client(config: &AuthConfig) -> ServiceResult<EntraClient> {
+    Ok(Client::<BasicErrorResponse, EntraTokenResponse, BasicTokenIntrospectionResponse, StandardRevocableToken, BasicRevocationErrorResponse>::new(ClientId::new(config.client_id.clone())).set_auth_type(AuthType::RequestBody).set_token_uri(TokenUrl::new(format!("https://login.microsoftonline.com/{}/oauth2/v2.0/token", config.tenant_id)).map_err(|_| failure(ErrorCode::InvalidArgument))?))
+}
+
+impl AzureOAuthProvider {
+    async fn grant(&self, config: &AuthConfig, token: EntraTokenResponse, previous: Option<&str>) -> ServiceResult<OAuthGrant> {
+        let expiry = token.expires_in().ok_or_else(|| failure(ErrorCode::AuthExpired))?;
+        let access_token = Secret::new(token.access_token().secret().as_bytes().to_vec())?;
+        let id_token = token.extra_fields().id_token.as_ref().map(|token| Secret::new(token.as_bytes().to_vec())).transpose()?;
+        let principal_id = self.principal.resolve(config, id_token.as_ref(), previous).await?;
+        if principal_id.is_empty() || principal_id.len() > 256 { return Err(failure(ErrorCode::AuthRequired)); }
+        Ok(OAuthGrant { access_token, refresh_token: token.refresh_token().map(|token| Secret::new(token.secret().as_bytes().to_vec())).transpose()?, expires_at_ms: now_ms().saturating_add(expiry.as_millis().min(u64::MAX as u128) as u64), principal_id })
+    }
+}
+
+#[async_trait]
+impl OAuthProvider for AzureOAuthProvider {
+    async fn azure_cli(&self, config: &AuthConfig) -> ServiceResult<OAuthGrant> { super::azure_cli::acquire(config).await }
+    async fn device_begin(&self, config: &AuthConfig) -> ServiceResult<StandardDeviceAuthorizationResponse> {
+        config.validate()?;
+        let client = client(config)?.set_device_authorization_url(DeviceAuthorizationUrl::new(format!("https://login.microsoftonline.com/{}/oauth2/v2.0/devicecode", config.tenant_id)).map_err(|_| failure(ErrorCode::InvalidArgument))?);
+        let http = OAuthHttpClient { backend: self.http.clone() };
+        client.exchange_device_code().add_scope(Scope::new(config.scope.clone())).add_scope(Scope::new("openid".into())).add_scope(Scope::new("profile".into())).add_scope(Scope::new("offline_access".into())).request_async(&http).await.map_err(|_| failure(ErrorCode::InteractionRequired))
+    }
+    async fn device_finish(&self, config: &AuthConfig, device: StandardDeviceAuthorizationResponse, signal: CancellationSignal) -> ServiceResult<OAuthGrant> {
+        config.validate()?;
+        let client = client(config)?;
+        let http = OAuthHttpClient { backend: self.http.clone() };
+        let token = tokio::select! {
+            _ = signal.cancelled() => return Err(failure(ErrorCode::Cancelled)),
+            token = client.exchange_device_access_token(&device).request_async(&http, tokio::time::sleep, Some(Duration::from_secs(15 * 60))) => token.map_err(|_| failure(ErrorCode::InteractionRequired))?,
+        };
+        self.grant(config, token, None).await
+    }
+    async fn client_credentials(&self, config: &AuthConfig, secret: &Secret) -> ServiceResult<OAuthGrant> {
+        config.validate()?;
+        let client = client(config)?.set_client_secret(ClientSecret::new(secret.expose().into()));
+        let http = OAuthHttpClient { backend: self.http.clone() };
+        let token = client.exchange_client_credentials().add_scope(Scope::new(config.scope.clone())).request_async(&http).await.map_err(|_| failure(ErrorCode::AuthRequired))?;
+        self.grant(config, token, None).await
+    }
+    async fn refresh(&self, config: &AuthConfig, refresh: &Secret, previous_principal: Option<&str>) -> ServiceResult<OAuthGrant> {
+        config.validate()?;
+        let client = client(config)?;
+        let http = OAuthHttpClient { backend: self.http.clone() };
+        let refresh = RefreshToken::new(refresh.expose().into());
+        let token = client.exchange_refresh_token(&refresh).add_scope(Scope::new(config.scope.clone())).add_scope(Scope::new("openid".into())).add_scope(Scope::new("profile".into())).add_scope(Scope::new("offline_access".into())).request_async(&http).await.map_err(|_| failure(ErrorCode::AuthExpired))?;
+        self.grant(config, token, previous_principal).await
+    }
+}
