+            let count:i64=client.query_one(query,&[&a,&b]).await.map_err(|e|format!("owned observation {e}"))?.get(0);
+            if count==2 {return Ok(count as usize);}
+            tokio::time::sleep(std::time::Duration::from_millis(10)).await;
+        }
+    }).await.map_err(|_|"owned blocked observation deadline".to_string())?
+}
