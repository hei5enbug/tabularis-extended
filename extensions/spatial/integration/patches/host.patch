+        if value["session_handle"] != handle || value["in_transaction"] != false || !value["rollback_confirmed"].is_boolean() || (finish == SessionFinish::Rollback && value["rollback_confirmed"] != true) { let mut error = failure(ErrorCode::OutcomeUnknown); error.outcome = Outcome::Unknown; return Err(error); }
