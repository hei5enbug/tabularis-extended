+pub enum ArtifactResource { Metadata { id: String }, Chunk { id: String, offset: u64, limit: usize } }
+pub enum ResourceRead { NotHandled, Content(Value) }
+
+impl ArtifactResource {
+    pub fn parse(uri: &str) -> ServiceResult<Option<Self>> {
+        let Some(rest) = uri.strip_prefix("tabularis://artifact/") else {
+            if uri.starts_with("tabularis://artifact") { return Err(failure(ErrorCode::InvalidArgument)); }
+            return Ok(None);
+        };
+        if uri.len() > 512 || rest.contains(['#', '%', '/', '\\', '@']) { return Err(failure(ErrorCode::InvalidArgument)); }
+        let (id, query) = rest.split_once('?').map_or((rest, None), |(id, query)| (id, Some(query)));
+        artifact_id(id)?;
+        let Some(query) = query else { return Ok(Some(Self::Metadata { id: id.into() })); };
+        let mut offset = None;
+        let mut limit = None;
+        for field in query.split('&') {
+            let (name, value) = field.split_once('=').ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+            if value.is_empty() || !value.bytes().all(|byte| byte.is_ascii_digit()) { return Err(failure(ErrorCode::InvalidArgument)); }
+            match name {
+                "offset" if offset.is_none() => offset = Some(value.parse::<u64>().map_err(|_| failure(ErrorCode::InvalidArgument))?),
+                "limit" if limit.is_none() => limit = Some(value.parse::<usize>().map_err(|_| failure(ErrorCode::InvalidArgument))?),
+                _ => return Err(failure(ErrorCode::InvalidArgument)),
+            }
+        }
+        let limit = limit.filter(|limit| (1..=65536).contains(limit)).ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+        Ok(Some(Self::Chunk { id: id.into(), offset: offset.ok_or_else(|| failure(ErrorCode::InvalidArgument))?, limit }))
+    }
+}
