+fn derived_fixture_parity(h:&Harness)->(Vec<String>,usize,usize,usize) {
+    let tools=h.transport.tools().unwrap();let bytes=serde_json::to_vec(&tools).unwrap().len();
+    let fixtures:Value=serde_json::from_str(super::super::contracts::VALIDATION_FIXTURES).unwrap();
+    let mut differences=Vec::new();let mut cases=0;let mut other_operations=0;
+    for tool in tools["tools"].as_array().unwrap() {
+        let operation=tool["inputSchema"]["properties"]["operation"]["const"].as_str().unwrap();
+        let validator=jsonschema::JSONSchema::options().with_draft(jsonschema::Draft::Draft7).compile(&tool["inputSchema"]).unwrap();
+        for fixture in fixtures.as_array().unwrap().iter().filter(|fixture|fixture["schema"]=="request") {
+            let value=&fixture["value"];let canonical=h.transport.validator.validate_request(value).is_ok();
+            let matches=value["operation"]==operation;let expected=canonical&&matches;let actual=validator.is_valid(value);cases+=1;
+            if actual!=expected || canonical!=fixture["valid"].as_bool().unwrap(){differences.push(format!("{}:{}",tool["name"],fixture["name"]));}
+            if canonical&&!matches&&!actual{other_operations+=1;}
+        }
+    }
+    println!("derived_tools_bytes={bytes} fixture_comparisons={cases} other_operation_rejections={other_operations}");
+    (differences,bytes,cases,other_operations)
