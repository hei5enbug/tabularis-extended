+#[tokio::test]
+async fn 현재_연결_권한이_없으면_취소_신호를_보내지_않는다() {
+    // given
+    let harness = Harness::new(); let lease = harness.runtime.jobs.begin(&query("SELECT 1"), &caller(), false, false).await.unwrap(); harness.policy.allowed.store(false, Ordering::SeqCst);
+    let input = request(Operation::JobCancel, json!({"job_id":lease.id(),"owner_instance_id":"owner"}));
