+fn guard_path(path: &Path, private: bool, directory: bool) -> ServiceResult<()> {
+    let metadata = match fs::symlink_metadata(path) { Ok(metadata) => metadata, Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(()), Err(_) => return Err(failure(ErrorCode::PermissionDenied)) };
+    if metadata.file_type().is_symlink() || (directory && !metadata.is_dir()) || (!directory && !metadata.is_file()) { return Err(failure(ErrorCode::PermissionDenied)); }
+    #[cfg(unix)] { use std::os::unix::fs::MetadataExt; if metadata.uid() != unsafe { libc::geteuid() } || (private && metadata.mode() & 0o077 != 0) { return Err(failure(ErrorCode::PermissionDenied)); } }
+    #[cfg(windows)] { use std::os::windows::fs::MetadataExt; if metadata.file_attributes() & 0x400 != 0 { return Err(failure(ErrorCode::PermissionDenied)); } }
+    Ok(())
+}
+
+fn secure_parent(path: &Path) -> ServiceResult<()> {
+    let parent = path.parent().ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+    guard_path(parent, false, true)?;
+    fs::create_dir_all(parent).map_err(|_| failure(ErrorCode::ResourceLimit))?;
+    #[cfg(unix)] { use std::os::unix::fs::PermissionsExt; fs::set_permissions(parent, fs::Permissions::from_mode(0o700)).map_err(|_| failure(ErrorCode::PermissionDenied))?; }
+    #[cfg(windows)] { crate::services::storage::protect_windows_path(parent, true)?; }
+    Ok(())
+}
+
+fn open_guarded(path: &Path, write: bool, create: bool) -> ServiceResult<File> {
+    guard_path(path, false, false)?;
+    let mut options = OpenOptions::new(); options.read(true).write(write).create_new(create);
+    #[cfg(unix)] { use std::os::unix::fs::OpenOptionsExt; options.mode(0o600).custom_flags(libc::O_NOFOLLOW); }
+    #[cfg(windows)] { use std::os::windows::fs::OpenOptionsExt; options.custom_flags(0x00200000); }
+    let file = options.open(path).map_err(|_| failure(ErrorCode::PermissionDenied))?;
+    if !file.metadata().map_err(|_| failure(ErrorCode::PermissionDenied))?.is_file() { return Err(failure(ErrorCode::PermissionDenied)); }
+    #[cfg(windows)] { crate::services::storage::protect_windows_path(path, false)?; }
+    Ok(file)
+}
