+const state = vi.hoisted(() => ({ contexts: [] as { name: string; context: SlotContext }[], grids: [] as ComponentProps<typeof DataGrid>[], update: vi.fn() }));
+vi.mock("../../../src/components/ui/DataGrid", () => ({ DataGrid: (props: ComponentProps<typeof DataGrid>) => { state.grids.push(props); return <div data-testid="snapshot-grid" />; } }));
+vi.mock("../../../src/components/ui/SlotAnchor", () => ({ SlotAnchor: (props: { name: string; context: SlotContext }) => { state.contexts.push(props); return <span data-slot={props.name} />; } }));
+vi.mock("../../../src/hooks/useRowEditor", () => ({ useRowEditor: ({ initialData }: { initialData: Record<string, unknown> }) => ({ editedData: initialData, updateField: state.update }) }));
+vi.mock("../../../src/components/ui/FieldEditor", () => ({ FieldEditor: (props: { name: string; value: unknown; onChange: (value: unknown) => void }) => <input aria-label={props.name} value={String(props.value)} onChange={(event) => props.onChange(event.target.value)} /> }));
+const envelope: ServiceResponse = { protocol_version: 1, request_id: "req", connection_id: "conn-origin", status: "succeeded", job_id: null, result_id: "snapshot-a", data: { kind: "tabular", columns: [{ name: "label", column_index: 0 }], rows: [["<img src=x onerror=alert(1)>"]], result_set_index: 1, result_set_count: 2, offset: 300, result_revision: "rev-a" }, page: { has_more: false, next_token: null, resume_mode: "materialized" }, limits: { truncated: false, reasons: [] }, metrics: { elapsed_ms: 1, request_charge: null, retry_count: 0 }, warnings: [], error: null };
+
+it.each([false, true])("일반과 compact 결과는 snapshot 연결과 집합 참조를 그대로 grid에 전달한다 (%s)", (compact) => {
