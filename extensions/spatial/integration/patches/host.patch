+}
+fn mismatch_scenario(store:&ResultStore,token:&str)->Vec<ErrorCode>{
+    let mut bindings=vec![];for field in 0..9 {let mut value=binding();match field {0=>value.connection_id="other".into(),1=>value.permission_scope="other".into(),2=>value.auth_revision="other".into(),3=>value.query_hash="other".into(),4=>value.result_revision="other".into(),5=>value.sdk_version=Some("other".into()),6=>value.container_rid=Some("other".into()),7=>value.endpoint_identity=Some("other".into()),_=>value.partition_hash=Some("other".into())}bindings.push(value);}
+    bindings.iter().map(|binding|store.begin_spatial_next(token,binding).err().unwrap().code).collect()
