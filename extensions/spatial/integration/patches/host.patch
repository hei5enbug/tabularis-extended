+}
+struct TauriPublisher<R:tauri::Runtime> { app:tauri::AppHandle<R>, subscriptions:RendererSubscriptions }
+impl<R:tauri::Runtime> GuiPublisher for TauriPublisher<R> {
+    fn renderer_subscriptions(&self) -> Option<&RendererSubscriptions> { Some(&self.subscriptions) }
+    fn publish(&self, request:&GuiApplyRequest)->ServiceResult<()> {
+        self.app.get_webview_window("main").ok_or_else(||failure(ErrorCode::GuiUnavailable))?.emit("service-map-apply",request).map_err(|_|failure(ErrorCode::GuiUnavailable))
+    }
