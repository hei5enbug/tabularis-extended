+fn child_reservation() -> Option<ErrorCode> {
+    let root = PathBuf::from(std::env::var("TABULARIS_H3C1_CHILD_ROOT").expect("Missing isolated child fixture."));
+    let mut line = String::new();
+    std::io::stdin().read_line(&mut line).unwrap();
+    let store = ArtifactStore::with_limits(root, ArtifactLimits { max_payload_bytes: 48, max_profile_bytes: 64, max_entries: 1, ..ArtifactLimits::default() }).unwrap();
+    let writer = store.reserve(binding(), "child.geojson".into(), 48, now_ms() + ACTIVE_MS);
+    let error = writer.as_ref().err().map(|error| error.code);
+    println!("H3C1_{}", if error.is_none() { "RESERVED" } else { "DENIED" });
+    std::io::stdout().flush().unwrap();
+    line.clear();
+    std::io::stdin().read_line(&mut line).unwrap();
+    drop(writer);
+    error
+}
