+            let _ = driver.service_call(ServiceRpcMethod::InvalidateAuth, &params, &context, json!({})).await;
+            driver.invalidate_connection_metadata(Some(connection_id)).await;
+        }
+    }
+}
+
+fn context_deadline(context: &DriverContext) -> ServiceResult<tokio::time::Instant> {
+    if context.deadline_ms == 0 || context.deadline_ms > 120_000 { return Err(failure(ErrorCode::InvalidArgument)); }
+    if context.signal.is_cancelled() { return Err(failure(ErrorCode::Cancelled)); }
+    Ok(tokio::time::Instant::now() + Duration::from_millis(context.deadline_ms))
+}
+fn remaining_ms(deadline: tokio::time::Instant) -> ServiceResult<u64> {
+    let remaining = deadline.saturating_duration_since(tokio::time::Instant::now()).as_millis() as u64;
+    if remaining == 0 { Err(failure(ErrorCode::DeadlineExceeded)) } else { Ok(remaining) }
+}
+fn explicit_database(input: &Value) -> Option<&str> { input.get("database").and_then(Value::as_str).or_else(|| input.get("table").and_then(|table| table.get("database")).and_then(Value::as_str)).or_else(|| input.get("query").and_then(|query| query.get("database")).and_then(Value::as_str)) }
+fn auth_identity(context: &DriverContext) -> String { match &context.transient_auth { Some(TransientAuth::AccountKey { identity, .. } | TransientAuth::DbPassword { identity, .. }) => identity.clone(), Some(TransientAuth::EntraToken { tenant_id, client_id, principal_id, scope, .. }) => value_hash(&json!({"tenant_id":tenant_id,"client_id":client_id,"principal_id":principal_id,"scope":scope})), None => String::new() } }
+fn operation_method(operation: Operation, documents: bool) -> Option<ServiceRpcMethod> {
+    Some(match operation {
+        Operation::ConnectionTest => if documents { ServiceRpcMethod::CosmosTest } else { ServiceRpcMethod::Test },
+        Operation::QueryExecute => if documents { ServiceRpcMethod::CosmosQuery } else { ServiceRpcMethod::ExactQuery },
+        Operation::QueryNext if documents => ServiceRpcMethod::CosmosQueryPage,
+        Operation::CatalogDatabases if documents => ServiceRpcMethod::CosmosDatabases,
+        Operation::CatalogObjects if documents => ServiceRpcMethod::CosmosTables,
+        Operation::CatalogDescribe if documents => ServiceRpcMethod::CosmosColumns,
+        Operation::CatalogDatabases | Operation::CatalogSchemas | Operation::CatalogObjects | Operation::CatalogDescribe if !documents => ServiceRpcMethod::Catalog,
+        Operation::RowInsert | Operation::RowUpdate | Operation::RowDelete if !documents => ServiceRpcMethod::Row,
+        Operation::DocumentRead if documents => ServiceRpcMethod::DocumentRead,
+        Operation::DocumentCreate if documents => ServiceRpcMethod::DocumentCreate,
+        Operation::DocumentReplace if documents => ServiceRpcMethod::DocumentReplace,
+        Operation::DocumentDelete if documents => ServiceRpcMethod::DocumentDelete,
+        _ => return None,
+    })
+}
+
+fn empty_output() -> DriverOutput { DriverOutput { data: Value::Null, snapshot: None, cursor: None, confirmed_cancelled: false, session_closed: false, metrics: Metrics::default(), limits: Limits::default(), warnings: vec![] } }
+fn warnings(value: &Value) -> Vec<String> { value.as_array().map(|warnings| warnings.iter().filter_map(Value::as_str).filter(|warning| !warning.is_empty() && warning.len() <= 128 && warning.bytes().all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'_')).map(str::to_owned).collect()).unwrap_or_default() }
+fn validate_output_metadata(output: &DriverOutput) -> ServiceResult<()> {
+    let safe_integer = |value: u64| value <= 9_007_199_254_740_991;
+    if !safe_integer(output.metrics.elapsed_ms) || !safe_integer(output.metrics.retry_count) || output.metrics.request_charge.is_some_and(|charge| !charge.is_finite() || charge < 0.0) { return Err(failure(ErrorCode::InvalidArgument)); }
+    let reason = |value: &String| !value.is_empty() && value.len() <= 128 && value.bytes().all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'_');
+    if !output.limits.reasons.iter().all(reason) || output.snapshot.as_ref().is_some_and(|snapshot| !snapshot.limits.reasons.iter().all(reason)) { return Err(failure(ErrorCode::InvalidArgument)); }
+    let snapshot = output.snapshot.as_ref().map(|snapshot| json!({"limits":snapshot.limits,"warnings":snapshot.warnings}));
+    let envelope = json!({"metrics":output.metrics,"limits":output.limits,"warnings":output.warnings,"snapshot_metadata":snapshot});
+    if serde_json::to_vec(&envelope).map_err(|_| failure(ErrorCode::ResourceLimit))?.len() > 32 * 1024 { return Err(failure(ErrorCode::ResourceLimit)); }
+    Ok(())
+}
+fn sql_output(value: Value) -> ServiceResult<DriverOutput> {
+    let mut pending = vec![&value]; let mut sets = Vec::new(); let mut rows_total = 0usize;
+    let mut limits = Limits::default(); let mut all_warnings = Vec::new();
+    while let Some(set) = pending.pop() {
