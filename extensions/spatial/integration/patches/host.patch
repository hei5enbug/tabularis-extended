+            let mut interval = tokio::time::interval(Duration::from_secs(1)); interval.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip); let mut ticks = 0u32;
+            loop {
+                interval.tick().await;
+                let Some(runtime) = runtime.upgrade() else { break; };
+                if runtime.stopping.load(Ordering::SeqCst) { break; }
+                let context = DriverContext { connection_id: String::new(), request_id: format!("maintenance-{}",uuid::Uuid::new_v4()), deadline_ms: 30000, signal: Default::default(), transient_auth: None, read_only: true, session_handle: None };
+                let _ = runtime.sessions.expire_idle(context).await;
+                ticks += 1;
+                if ticks % 30 == 0 { let _ = runtime.results.cleanup(); }
+            }
+        });
+        self.tasks.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.insert("maintenance".into(), task);
+        Ok(())
+    }
+}
+
+struct SecretInputCleanup<'a> { inputs: &'a SecretInputs, caller: &'a CallerContext, request: &'a ServiceRequest }
+async fn before_publication<T>(lease: &JobLease, action: impl std::future::Future<Output = ServiceResult<T>>) -> ServiceResult<T> {
+    let signal = lease.signal();
+    tokio::select! { biased; _ = signal.cancelled() => Err(failure(ErrorCode::Cancelled)), result = action => result }
+}
+impl Drop for SecretInputCleanup<'_> { fn drop(&mut self) { if self.request.operation == Operation::CredentialImport { self.inputs.discard(self.caller, &self.request.request_id); } } }
+
+#[async_trait]
+impl ServiceHandler for ServiceRuntime {
+    async fn call(&self, request: &ServiceRequest, caller: &CallerContext) -> ServiceResponse { self.call_validated(request, caller).await }
+    fn rejected(&self,request:&ServiceRequest,caller:&CallerContext) { if request.operation==Operation::CredentialImport { self.secret_inputs.discard(caller,&request.request_id); } }
+}
+
+fn success(request: &ServiceRequest, data: Value) -> ServiceResponse {
+    ServiceResponse { protocol_version: 1, request_id: request.request_id.clone(), connection_id: request.connection_id.clone(), status: JobStatus::Succeeded, job_id: None, result_id: None, data, page: Page::default(), limits: Limits::default(), metrics: Metrics::default(), warnings: Vec::new(), error: None }
+}
+fn error_response(request: &ServiceRequest, error: super::contracts::ServiceError) -> ServiceResponse {
+    let error = redact_error(error); let mut response = ServiceResponse::failure(request, error.code, &error.message);
+    response.status = if error.outcome == Outcome::Unknown { JobStatus::OutcomeUnknown } else if error.code == ErrorCode::Cancelled { JobStatus::Cancelled } else { JobStatus::Failed }; response.error = Some(error); response
+}
+fn from_page(request: &ServiceRequest, page: StoredPage) -> ServiceResponse { let mut response = success(request, page.data); response.result_id = page.result_id; response.page = page.page; response.limits = page.limits; response.metrics = page.metrics; response.warnings = page.warnings; response }
+fn string<'a>(value: &'a Value, key: &str) -> ServiceResult<&'a str> { value[key].as_str().ok_or_else(|| failure(ErrorCode::InvalidArgument)) }
+fn integer(value: &Value, key: &str) -> ServiceResult<usize> { value[key].as_u64().and_then(|value| usize::try_from(value).ok()).ok_or_else(|| failure(ErrorCode::InvalidArgument)) }
+fn public_connection(connection: &SavedConnection) -> Value { json!({"connection_id":connection.id,"name":connection.name,"driver":connection.driver,"settings":sanitized_settings(&connection.settings),"credential_ref":connection.credential_ref,"version":connection.version,"allow_writes":connection.allow_writes}) }
+fn authorize_binding(binding: &CursorBinding, connection: &SavedConnection, permission: &PermissionScope) -> ServiceResult<()> { if binding.connection_id != connection.id || binding.permission_scope != permission.identity || binding.auth_revision != connection.auth_revision { Err(failure(ErrorCode::InvalidPageToken)) } else { Ok(()) } }
+
+pub fn validate_connection_configuration(driver: &str, settings: &Value) -> ServiceResult<()> {
+    validate_settings(settings)?;
+    if !settings.is_object() { return Err(failure(ErrorCode::InvalidArgument)); }
+    let extra = settings.get("extra").unwrap_or(settings);
+    for host in [settings.get("host"), extra.get("host")].into_iter().flatten().filter_map(Value::as_str) { if host.contains("://") || host.contains(['@','/','?','#']) || host.chars().any(char::is_whitespace) || host.chars().any(char::is_control) { return Err(failure(ErrorCode::InvalidArgument)); } }
+    if matches!(extra["auth_mode"].as_str(), Some("entra_user" | "entra_service_principal")) {
+        if uuid::Uuid::parse_str(extra["tenant_id"].as_str().unwrap_or("")).is_err() || uuid::Uuid::parse_str(extra["client_id"].as_str().unwrap_or("")).is_err() { return Err(failure(ErrorCode::InvalidArgument)); }
+        if extra.get("username").is_some_and(|value| !value.is_null()) || extra["integrated"] == true { return Err(failure(ErrorCode::InvalidArgument)); }
+    }
+    if extra.get("auth_source").is_some() {
+        if !matches!(extra["auth_source"].as_str(), Some("oauth" | "azure_cli")) || (extra["auth_source"] == "azure_cli" && (!matches!(driver, "sqlserver" | "cosmos-nosql") || extra["auth_mode"] != "entra_user" || extra["client_id"] != super::azure_cli::CLIENT_ID)) { return Err(failure(ErrorCode::InvalidArgument)); }
+    }
+    if driver == "cosmos-nosql" {
+        let endpoint = settings["endpoint"].as_str().or_else(|| extra["endpoint"].as_str()).unwrap_or("");
+        let url = reqwest::Url::parse(endpoint).map_err(|_| failure(ErrorCode::InvalidArgument))?;
+        if url.scheme() != "https" || !url.username().is_empty() || url.password().is_some() || url.host_str().is_none_or(|host| !host.ends_with(".documents.azure.com")) || url.port().is_some_and(|port| port != 443) || url.path() != "/" || url.query().is_some() || url.fragment().is_some() { return Err(failure(ErrorCode::InvalidArgument)); }
+        if !matches!(extra["auth_mode"].as_str(), Some("account_key" | "entra_user" | "entra_service_principal")) { return Err(failure(ErrorCode::InvalidArgument)); }
+    }
+    if settings["host"].as_str().is_some_and(|host| host.ends_with(".database.windows.net")) {
+        if settings["ssl_mode"] != "verify-full" || extra["trust_server_certificate"] == true || settings["database"].as_str().is_none_or(str::is_empty) { return Err(failure(ErrorCode::TlsValidationFailed)); }
+    }
+    Ok(())
+}
