+
+struct MockHttp { responses: Mutex<VecDeque<(u16, Value)>>, requests: Mutex<Vec<(String, String)>> }
+impl MockHttp { fn new(responses: Vec<(u16, Value)>) -> Self { Self { responses: Mutex::new(responses.into()), requests: Mutex::new(vec![]) } } }
+#[async_trait]
+impl OAuthHttpBackend for MockHttp {
+    async fn send(&self, request: oauth2::HttpRequest) -> Result<oauth2::HttpResponse, OAuthTransportError> {
+        self.requests.lock().unwrap().push((request.uri().to_string(), String::from_utf8(request.body().clone()).unwrap()));
+        let (status, body) = self.responses.lock().unwrap().pop_front().ok_or(OAuthTransportError)?;
+        oauth2::http::Response::builder().status(status).header("content-type","application/json").body(serde_json::to_vec(&body).unwrap()).map_err(|_| OAuthTransportError)
+    }
+}
+fn token(config: &AuthConfig, altered: Option<(&str, Value)>, algorithm: &str) -> String {
+    let now = now_ms()/1000; let mut claims = json!({"iss":format!("https://login.microsoftonline.com/{}/v2.0",config.tenant_id),"aud":config.client_id,"tid":config.tenant_id,"oid":"11111111-1111-4111-8111-111111111111","sub":"subject","exp":now+3600,"nbf":now-1,"iat":now-1});
+    if let Some((key, value)) = altered { claims[key] = value; }
+    format!("{}.{}.{}",URL_SAFE_NO_PAD.encode(serde_json::to_vec(&json!({"alg":algorithm})).unwrap()), URL_SAFE_NO_PAD.encode(serde_json::to_vec(&claims).unwrap()),URL_SAFE_NO_PAD.encode(vec![1;256]))
+}
+fn provider(http: Arc<MockHttp>) -> AzureOAuthProvider { AzureOAuthProvider::new(http, Arc::new(MicrosoftPrincipalResolver)) }
