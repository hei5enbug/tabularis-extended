+pub struct SignalGate {
+    pub count: AtomicUsize,
+    entered: tokio::sync::Notify,
+    released: tokio::sync::Semaphore,
+}
+impl SignalGate {
+    pub fn new() -> Arc<Self> {
+        Arc::new(Self { count: AtomicUsize::new(0), entered: tokio::sync::Notify::new(), released: tokio::sync::Semaphore::new(0) })
+    }
+    pub async fn wait(&self) {
+        self.count.fetch_add(1, Ordering::SeqCst);
+        self.entered.notify_waiters();
+        self.released.acquire().await.unwrap().forget();
+    }
+    pub async fn entered(&self, count: usize) {
+        tokio::time::timeout(std::time::Duration::from_secs(5), async {
+            loop {
+                let notified = self.entered.notified();
+                if self.count.load(Ordering::SeqCst) >= count { break; }
+                notified.await;
+            }
+        }).await.unwrap();
+    }
+    pub fn release(&self) { self.released.add_permits(1); }
