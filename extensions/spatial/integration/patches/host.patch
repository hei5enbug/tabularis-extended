+#[async_trait]
+pub trait PrincipalResolver: Send + Sync {
+    async fn resolve(&self, config: &AuthConfig, id_token: Option<&Secret>, previous: Option<&str>) -> ServiceResult<String>;
+}
+
+pub struct MicrosoftPrincipalResolver;
+#[async_trait]
+impl PrincipalResolver for MicrosoftPrincipalResolver {
+    async fn resolve(&self, config: &AuthConfig, id_token: Option<&Secret>, previous: Option<&str>) -> ServiceResult<String> {
+        if config.mode == "entra_service_principal" { return Ok(config.client_id.clone()); }
+        match id_token {
+            Some(token) => validate_id_token(config, token),
+            None => previous.filter(|principal| uuid::Uuid::parse_str(principal).is_ok()).map(str::to_owned).ok_or_else(|| failure(ErrorCode::AuthRequired)),
+        }
+    }
+}
+
+fn validate_id_token(config: &AuthConfig, token: &Secret) -> ServiceResult<String> {
+    let parts: Vec<_> = token.expose().split('.').collect();
+    if token.expose().len() > 64 * 1024 || parts.len() != 3 || parts.iter().any(|part| part.is_empty()) { return Err(failure(ErrorCode::AuthRequired)); }
+    let header: serde_json::Value = serde_json::from_slice(&URL_SAFE_NO_PAD.decode(parts[0]).map_err(|_| failure(ErrorCode::AuthRequired))?).map_err(|_| failure(ErrorCode::AuthRequired))?;
+    if header["alg"] != "RS256" || URL_SAFE_NO_PAD.decode(parts[2]).map_err(|_| failure(ErrorCode::AuthRequired))?.len() < 128 { return Err(failure(ErrorCode::AuthRequired)); }
+    let claims: serde_json::Value = serde_json::from_slice(&URL_SAFE_NO_PAD.decode(parts[1]).map_err(|_| failure(ErrorCode::AuthRequired))?).map_err(|_| failure(ErrorCode::AuthRequired))?;
+    let now = now_ms() / 1000;
+    let issuer = format!("https://login.microsoftonline.com/{}/v2.0", config.tenant_id);
+    let expiry = claims["exp"].as_u64().ok_or_else(|| failure(ErrorCode::AuthRequired))?;
+    let not_before = claims["nbf"].as_u64().ok_or_else(|| failure(ErrorCode::AuthRequired))?;
+    let issued = claims["iat"].as_u64().ok_or_else(|| failure(ErrorCode::AuthRequired))?;
+    let principal = claims["oid"].as_str().ok_or_else(|| failure(ErrorCode::AuthRequired))?;
+    if claims["iss"] != issuer || claims["aud"] != config.client_id || claims["tid"] != config.tenant_id || expiry <= now || not_before > now.saturating_add(60) || issued > now.saturating_add(60) || issued >= expiry || not_before >= expiry || claims["sub"].as_str().map_or(true, str::is_empty) || uuid::Uuid::parse_str(principal).is_err() { return Err(failure(ErrorCode::AuthRequired)); }
+    Ok(principal.into())
+}
