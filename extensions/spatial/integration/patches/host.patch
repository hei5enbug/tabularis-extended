+fn continuation_warning_boundary() -> Vec<String> {
+    let metadata_bytes = |warnings: &[String]| serde_json::to_vec(&json!({"metrics":Metrics { elapsed_ms:0, request_charge:Some(2.5), retry_count:0 },"limits":Limits::default(),"warnings":warnings,"snapshot_metadata":{"limits":Limits::default(),"warnings":[]}})).unwrap().len();
+    let mut warnings = vec![];
+    while metadata_bytes(&warnings) + 131 <= 32*1024 { warnings.push("w".repeat(128)); }
+    let remaining = 32*1024 - metadata_bytes(&warnings);
+    if remaining > 3 { warnings.push("w".repeat(remaining-3)); }
+    warnings
+}
