+struct Presentation { budget: usize, nodes: usize, truncated: bool }
+impl Presentation {
+    fn value(&mut self, value: &Value, depth: usize) -> Value {
+        if depth >= 32 || self.nodes >= 2048 || self.budget < 16 { self.truncated = true; return Value::Null; }
+        self.nodes += 1;
+        match value {
+            Value::String(text) => {
+                let maximum = self.budget.min(1024);
+                let mut end = text.len().min(maximum);
+                while !text.is_char_boundary(end) { end -= 1; }
+                self.truncated |= end < text.len();
+                self.budget = self.budget.saturating_sub(end + 8);
+                json!(&text[..end])
+            }
+            Value::Array(items) => {
+                self.truncated |= items.len() > 5;
+                self.budget = self.budget.saturating_sub(16);
+                Value::Array(items.iter().take(5).map(|value| self.value(value, depth + 1)).collect())
+            }
+            Value::Object(object) => {
+                self.budget = self.budget.saturating_sub(16);
+                let mut result = Map::new();
+                for (key, value) in object.iter().take(64) {
+                    if self.budget < key.len() + 16 || key.len() > 256 { self.truncated = true; continue; }
+                    self.budget -= key.len() + 8;
+                    if key == "coordinates" && object.contains_key("type") { self.truncated = true; continue; }
+                    if matches!(key.as_str(), "native_state" | "tail") { self.truncated = true; continue; }
+                    if key == "geometry" && value.is_object() { result.insert(key.clone(), json!({"type":self.value(&value["type"],depth+1)})); self.truncated |= value.get("coordinates").is_some(); continue; }
+                    if matches!(key.as_str(), "rows" | "documents" | "values" | "features") && value.is_array() {
+                        let count = value.as_array().map_or(0, Vec::len);
+                        result.insert(format!("{key}_count"), json!(count));
+                        result.insert(format!("{key}_sample"), self.value(value, depth + 1));
+                    } else { result.insert(key.clone(), self.value(value, depth + 1)); }
+                }
+                self.truncated |= object.len() > 64;
+                Value::Object(result)
+            }
+            _ => { self.budget = self.budget.saturating_sub(32); value.clone() }
+        }
+    }
+}
