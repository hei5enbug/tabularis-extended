+    }
+    async fn resolved(&self, connection: &SavedConnection, context: &DriverContext, database: Option<&str>) -> ServiceResult<ConnectionParams> {
+        if let Some((_, params)) = self.session(connection, context, database)? { return Ok(params); }
+        let mut params = self.resolver.params(connection).await?;
+        if params.driver != connection.driver || params.connection_id.as_deref().is_some_and(|id| id != connection.id) { return Err(failure(ErrorCode::InvalidArgument)); }
