+pub struct NativeLegacyMcp {core:Weak<NativeCore>}
+impl NativeLegacyMcp {
+    pub fn new(core:Weak<NativeCore>)->Self {Self {core}}
+    fn core(&self)->ServiceResult<std::sync::Arc<NativeCore>> {self.core.upgrade().ok_or_else(||failure(ErrorCode::CapabilityUnavailable))}
+    async fn connection(&self,name:&str)->ServiceResult<crate::services::backend::SavedConnection> {
+        let core=self.core()?;let connections=core.platform.runtime.connections.list().await?;
+        let matched=connections.iter().filter(|connection|connection.id==name||connection.name==name).collect::<Vec<_>>();
+        if matched.len()!=1{return Err(failure(ErrorCode::InvalidArgument));}Ok(matched[0].clone())
+    }
+    async fn common(&self,name:&str,args:&Map<String,Value>,caller:&CallerContext)->ServiceResult<Option<Value>> {
+        let core=self.core()?;
+        if name=="list_connections" {let response=catalog::call(&core,caller.clone(),Operation::ConnectionList,None,json!({}),false).await?;return Ok(Some(summary(&response)));}
+        let name_or_id=args["connection_id"].as_str().ok_or_else(||failure(ErrorCode::InvalidArgument))?;
+        let connection=self.connection(name_or_id).await?;
+        core.platform.runtime.policy.permission(&connection,caller).await?;
+        let Some((_,caps))=catalog::driver_capabilities(&connection.driver).await? else {return Ok(None);};
+        let schema=args.get("schema").and_then(Value::as_str);
+        let operation=match name {"list_databases"=>Operation::CatalogDatabases,"list_tables"=>Operation::CatalogObjects,"describe_table"=>Operation::CatalogDescribe,"run_query"=>Operation::QueryExecute,_=>return Err(failure(ErrorCode::UnsupportedOperation))};
+        if !core.platform.runtime.driver.supports(&connection,operation).await?{return Err(failure(ErrorCode::UnsupportedOperation));}
+        let database=||catalog::database(&core,&connection.id,args.get("database").and_then(Value::as_str).map(str::to_owned));
+        let mut input=match operation {
+            Operation::CatalogDatabases=>json!({}),
+            Operation::CatalogObjects=>json!({"database":database()?,"schema":schema}),
+            Operation::CatalogDescribe=>json!({"table":{"database":database()?,"schema":schema,"table":args["table_name"].as_str().ok_or_else(||failure(ErrorCode::InvalidArgument))?}}),
+            Operation::QueryExecute=>{
+                let text=args["query"].as_str().filter(|text|!text.is_empty()).ok_or_else(||failure(ErrorCode::InvalidArgument))?;
+                let size=match args.get("limit"){None=>100,Some(value)=>value.as_u64().filter(|size|*size>=1).ok_or_else(||failure(ErrorCode::InvalidArgument))?.min(1000)};
+                let mut query=json!({"language":if caps.documents{"cosmos_sql"}else{"sql"},"text":text,"parameters":[],"page_size":size,"mode":"exact"});
+                if caps.documents {
+                    for field in ["database","container"] {query[field]=json!(args[field].as_str().filter(|value|!value.is_empty()).ok_or_else(||failure(ErrorCode::InvalidArgument))?);}
+                }else {if args.contains_key("container"){return Err(failure(ErrorCode::InvalidArgument));}query["database"]=json!(database()?);}
+                query
+            },_=>return Err(failure(ErrorCode::UnsupportedOperation))
+        };
+        let write=match args.get("write"){None=>false,Some(value)=>value.as_bool().ok_or_else(||failure(ErrorCode::InvalidArgument))?};
+        let mut response=catalog::call(&core,caller.clone(),operation,Some(connection.id),input.take(),write).await?;
+        if operation==Operation::CatalogDescribe {response.data["indexes"]=Value::Null;response.data["foreign_keys"]=Value::Null;response.data["unsupported_fields"]=json!(["indexes","foreign_keys"]);}
+        Ok(Some(summary(&response)))
+    }
+    fn format(&self,args:&Map<String,Value>)->ServiceResult<ToolOutputFormat> {
+        let core=self.core()?;let path=core.platform.approvals.profile().join("config.json");
+        let config=match crate::persistence::service_read_file(&path,16*1024*1024,false)?{Some(bytes)=>serde_json::from_slice(&bytes).map_err(|_|failure(ErrorCode::PermissionDenied))?,None=>crate::config::AppConfig::default()};
+        ToolOutputFormat::from_arguments(Some(args),ToolOutputFormat::from_config(&config)).map_err(|_|failure(ErrorCode::InvalidArgument))
+    }
+    async fn legacy(&self,method:&str,params:Value)->Value {
+        let request=JsonRpcRequest {jsonrpc:"2.0".into(),id:Some(json!("legacy-adapter")),method:method.into(),params:Some(params)};
+        match super::handle_request(request).await {Some(response)=>response.result.unwrap_or_else(||json!({"isError":true,"content":[{"type":"text","text":"Legacy service failed"}]})),None=>json!({"isError":true,"content":[{"type":"text","text":"Legacy service failed"}]})}
+    }
+}
