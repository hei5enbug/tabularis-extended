+    }
+    fn session(&self, connection: &SavedConnection, context: &DriverContext, database: Option<&str>) -> ServiceResult<Option<(Arc<dyn DatabaseDriver>, ConnectionParams)>> {
+        let Some(handle) = &context.session_handle else { return Ok(None); };
+        let sessions = self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?;
+        let session = sessions.get(&(connection.id.clone(), handle.clone())).ok_or_else(|| failure(ErrorCode::PermissionDenied))?;
+        if session.connection.driver != connection.driver || session.connection.auth_revision != connection.auth_revision || session.auth_identity != auth_identity(context) || session.context.read_only != context.read_only || database.is_some_and(|database| database != session.database) { return Err(failure(ErrorCode::InvalidArgument)); }
