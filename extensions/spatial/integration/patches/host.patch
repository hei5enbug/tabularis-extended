+
+    // when
+    let actual = concurrent_queries(&harness, Some(id)).await;
+
+    // then
+    assert!(actual.iter().all(|response| response.status == JobStatus::Succeeded));
+    assert_eq!(harness.driver.session_peak.load(Ordering::SeqCst), 1);
+}
