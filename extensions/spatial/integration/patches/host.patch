+async fn cancelled_pair(driver: Arc<RpcDriver>) -> (ServiceResult<Value>, ServiceResult<Value>) {
+    let first = tokio::spawn({ let driver = driver.clone(); async move { driver.service_call(ServiceRpcMethod::ExactQuery, &params(&driver.manifest.id), &context("conn-a", "same-request"), query("wait_pair")).await } });
+    let second = tokio::spawn({ let driver = driver.clone(); async move { driver.service_call(ServiceRpcMethod::ExactQuery, &params(&driver.manifest.id), &context("conn-b", "same-request"), query("wait_pair")).await } });
+    wait_active(&driver, 2).await;
+    driver.service_cancel("conn-a", "same-request").await.unwrap();
+    let result = (first.await.unwrap(), second.await.unwrap());
