+impl RegistryDriverBackend {
+    pub fn new(resolver: Arc<dyn ServiceConnectionResolver>) -> Self { Self { resolver, active: Mutex::new(HashMap::new()), sessions: Mutex::new(HashMap::new()), connections: Mutex::new(HashMap::new()), session_slots: Arc::new(tokio::sync::Semaphore::new(64)), auth_epochs: Mutex::new(HashMap::new()) } }
+    async fn driver(&self, connection: &SavedConnection) -> ServiceResult<Arc<dyn DatabaseDriver>> {
+        registry::get_driver(&connection.driver).await.ok_or_else(|| failure(ErrorCode::CapabilityUnavailable))
+    }
+    fn track(&self, connection: &SavedConnection, context: &DriverContext, driver: Arc<dyn DatabaseDriver>) -> ServiceResult<ActiveCall<'_>> {
+        if context.connection_id != connection.id { return Err(failure(ErrorCode::InvalidArgument)); }
+        let key = (connection.id.clone(), context.request_id.clone());
+        let mut active = self.active.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?;
+        if active.contains_key(&key) { return Err(failure(ErrorCode::InvalidArgument)); }
+        if active.len() >= 64 { return Err(failure(ErrorCode::ResourceLimit)); }
+        active.insert(key.clone(), driver.clone());
+        self.connections.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.insert(connection.id.clone(), (connection.driver.clone(), driver));
