+    async fn apply(&self,gui_id:&str,request:GuiApplyRequest)->ServiceResult<GuiApplyAck>{self.ipc.upgrade().ok_or_else(||failure(ErrorCode::GuiUnavailable))?.apply_map(gui_id,request).await}
+}
+#[async_trait]
+pub trait MapSpatialCapability:Send+Sync {async fn supports(&self,connection:&SavedConnection,context:&DriverContext)->ServiceResult<bool>;}
