+  // When
+  render(<ResultEntryContent entry={entry} connectionId="later-active-conn" copyFormat="json" csvDelimiter="," csvIncludeHeaders compact={compact} onPageChange={vi.fn()} />);
+  // Then
+  expect(state.grids[0].connectionId).toBe("conn-origin");
+  expect(state.grids[0].serviceReference).toMatchObject({ resultId: "snapshot-a", resultSetIndex: 1, resultRowOffset: 300, resultGeneration: 4 });
+  expect(state.grids[0].readonly).toBe(true);
+});
+
+it("sidebar 슬롯은 원본 ordinal을 전달하며 읽기 전용 원본 텍스트를 HTML로 실행하지 않는다", () => {
+  // Given
+  state.contexts.length = 0; state.update.mockClear();
+  const result = snapshotResult(envelope, { connectionId: "conn-origin", driverId: "postgresql", generation: 4, pageSize: 100 });
+  const scenario = () => { render(<RowEditorPanel rowData={{ label: "<img src=x onerror=alert(1)>" }} rowIndex={7} isInsertion={false} columns={[{ name: "label" }]} connectionId="conn-origin" serviceReference={result.service} readonly onChange={vi.fn()} onClose={vi.fn()} />); fireEvent.change(screen.getByLabelText("label"), { target: { value: "changed" } }); };
+  // When
