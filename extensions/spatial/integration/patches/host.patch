+}
+fn marker(store:&ResultStore,revision:&str){let file=store.root().join(format!("a-{}.json",digest(binding().connection_id.as_bytes())));std::fs::write(file,serde_json::to_vec(&json!({"kind":"AuthRevision","record":{"connection_id":"conn-a","revision":revision}})).unwrap()).unwrap();}
+fn revoked_scenario(store:&ResultStore,token:&str)->Vec<ErrorCode>{marker(store,"rotated");vec![store.spatial_token(state(),None).err().unwrap().code,store.token_binding(token).err().unwrap().code,store.begin_spatial_next(token,&binding()).err().unwrap().code,store.finish_spatial_next(token,&binding(),page()).err().unwrap().code]}
+#[test]
+fn 인증_세대가_바뀌면_동일한_바인딩으로도_토큰_생성_조회_시작_완료를_거부한다() {
+    // given
+    let directory=TestDirectory::new();let store=ResultStore::new(directory.0.clone()).unwrap();let token=store.spatial_token(state(),None).unwrap();store.begin_spatial_next(&token,&binding()).unwrap();
