+    let fixtures: Vec<Fixture> = serde_json::from_str(VALIDATION_FIXTURES).unwrap();
+
+    // when
+    let actual: Vec<bool> = fixtures.iter().map(|fixture| match fixture.schema.as_str() {
+        "request" => validator.validate_request(&fixture.value).is_ok(),
+        "response" => validator.validate_response(&fixture.value).is_ok(),
+        _ => false,
+    }).collect();
+
+    // then
+    for (fixture, valid) in fixtures.iter().zip(actual) { assert_eq!(valid, fixture.valid, "{}", fixture.name); }
