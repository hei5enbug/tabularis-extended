+
+#[async_trait]
+pub trait MapGuiBackend:Send+Sync {async fn discover(&self)->ServiceResult<Vec<InstanceMetadata>>;async fn apply(&self,gui_id:&str,request:GuiApplyRequest)->ServiceResult<GuiApplyAck>;}
+pub struct UnavailableMapGui;
+#[async_trait]
+impl MapGuiBackend for UnavailableMapGui {async fn discover(&self)->ServiceResult<Vec<InstanceMetadata>>{Ok(Vec::new())}async fn apply(&self,_:&str,_:GuiApplyRequest)->ServiceResult<GuiApplyAck>{Err(failure(ErrorCode::GuiUnavailable))}}
+pub struct WeakLocalIpcGui {ipc:Weak<LocalIpc>}
