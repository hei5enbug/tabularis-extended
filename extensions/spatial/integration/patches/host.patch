+        Ok(())
+    }
+    async fn discard_session(&self, connection_id: &str, handle: &str) {
+        let session = self.sessions.lock().ok().and_then(|mut sessions| sessions.remove(&(connection_id.into(), handle.into())));
+        if let Some(mut session) = session {
+            session.context.request_id = uuid::Uuid::new_v4().to_string(); session.context.deadline_ms = 2000; session.context.signal = CancellationSignal::default(); session.context.session_handle = Some(handle.into());
+            let _ = session.driver.service_call(ServiceRpcMethod::SessionDiscard, &session.params, &session.context, json!({})).await;
+        }
+    }
+    async fn invalidate_auth(&self, connection_id: &str, _previous_principal: Option<&str>) {
+        if let Ok(mut epochs) = self.auth_epochs.lock() { let epoch = epochs.entry(connection_id.into()).or_default(); *epoch = epoch.wrapping_add(1); }
+        let active: Vec<_> = self.active.lock().map(|active| active.iter().filter(|((connection, _), _)| connection == connection_id).map(|((_, request), driver)| (request.clone(), driver.clone())).collect()).unwrap_or_default();
+        for (request, driver) in active { let _ = driver.service_cancel(connection_id, &request).await; }
+        let handles: Vec<_> = self.sessions.lock().map(|sessions| sessions.keys().filter(|(connection, _)| connection == connection_id).map(|(_, handle)| handle.clone()).collect()).unwrap_or_default();
+        for handle in handles { self.discard_session(connection_id, &handle).await; }
+        let connection = self.connections.lock().ok().and_then(|mut connections| connections.remove(connection_id));
+        if let Some((driver_id, driver)) = connection {
+            let context = DriverContext { connection_id: connection_id.into(), request_id: uuid::Uuid::new_v4().to_string(), deadline_ms: 2000, signal: CancellationSignal::default(), transient_auth: None, read_only: true, session_handle: None };
