+fn schema_references(value:&Value, names:&mut std::collections::BTreeSet<String>)->ServiceResult<()> {
+    match value {
+        Value::Object(object)=> {
+            if let Some(reference)=object.get("$ref") {
+                let name=reference.as_str().and_then(|reference|reference.strip_prefix("#/definitions/")).filter(|name|!name.is_empty()&&!name.contains('/')).ok_or_else(||failure(ErrorCode::CapabilityUnavailable))?;
+                names.insert(name.replace("~1","/").replace("~0","~"));
+            }
+            for value in object.values(){schema_references(value,names)?;}
+        }
+        Value::Array(values)=>for value in values {schema_references(value,names)?;},
+        _=>{}
+    }
+    Ok(())
+}
+
+fn operation_schema(source:&Value,operation:&str)->ServiceResult<Value> {
+    let branch=source["oneOf"].as_array().and_then(|branches|branches.iter().find(|branch|branch["properties"]["operation"]["const"]==operation)).ok_or_else(||failure(ErrorCode::CapabilityUnavailable))?;
+    let mut schema=source.clone();
+    let object=schema.as_object_mut().ok_or_else(||failure(ErrorCode::CapabilityUnavailable))?;
+    object.remove("$id");object.remove("definitions");
+    object.insert("oneOf".into(),json!([branch]));
+    schema["properties"]["operation"]=json!({"const":operation});
+    let mut pending=std::collections::BTreeSet::new();let mut definitions=Map::new();
+    schema_references(&schema,&mut pending)?;
+    while let Some(name)=pending.pop_first() {
+        if definitions.contains_key(&name){continue;}
+        let definition=source["definitions"].get(&name).ok_or_else(||failure(ErrorCode::CapabilityUnavailable))?;
+        schema_references(definition,&mut pending)?;
+        definitions.insert(name,definition.clone());
+    }
+    schema["definitions"]=Value::Object(definitions);
+    Ok(schema)
+}
