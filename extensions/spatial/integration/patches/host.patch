+#[derive(Debug)]
+pub struct OAuthTransportError;
+impl fmt::Display for OAuthTransportError { fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result { formatter.write_str("The OAuth HTTP request failed.") } }
+impl std::error::Error for OAuthTransportError {}
+
+#[async_trait]
+pub trait OAuthHttpBackend: Send + Sync { async fn send(&self, request: HttpRequest) -> Result<HttpResponse, OAuthTransportError>; }
+
+struct OAuthHttpClient { backend: Arc<dyn OAuthHttpBackend> }
+impl<'a> AsyncHttpClient<'a> for OAuthHttpClient {
+    type Error = OAuthTransportError;
+    type Future = Pin<Box<dyn Future<Output = Result<HttpResponse, OAuthTransportError>> + Send + 'a>>;
+    fn call(&'a self, request: HttpRequest) -> Self::Future { let backend = self.backend.clone(); Box::pin(async move { backend.send(request).await }) }
+}
+
+pub struct ReqwestOAuthHttp { client: reqwest::Client }
+impl ReqwestOAuthHttp {
+    pub fn new() -> ServiceResult<Self> {
+        Ok(Self { client: reqwest::Client::builder().redirect(reqwest::redirect::Policy::none()).timeout(Duration::from_secs(30)).build().map_err(|_| failure(ErrorCode::AuthRequired))? })
+    }
+}
+#[async_trait]
+impl OAuthHttpBackend for ReqwestOAuthHttp {
+    async fn send(&self, request: HttpRequest) -> Result<HttpResponse, OAuthTransportError> {
+        if request.uri().scheme_str() != Some("https") || request.uri().host() != Some("login.microsoftonline.com") { return Err(OAuthTransportError); }
+        let mut response = self.client.request(reqwest::Method::from_bytes(request.method().as_str().as_bytes()).map_err(|_| OAuthTransportError)?, request.uri().to_string()).headers(request.headers().clone()).body(request.body().clone()).send().await.map_err(|_| OAuthTransportError)?;
+        let mut builder = oauth2::http::Response::builder().status(response.status());
+        if let Some(headers) = builder.headers_mut() { *headers = response.headers().clone(); }
+        let mut bytes = Vec::new();
+        while let Some(chunk) = response.chunk().await.map_err(|_| OAuthTransportError)? {
+            if bytes.len().saturating_add(chunk.len()) > 1024 * 1024 { return Err(OAuthTransportError); }
+            bytes.extend_from_slice(&chunk);
+        }
+        builder.body(bytes).map_err(|_| OAuthTransportError)
+    }
+}
