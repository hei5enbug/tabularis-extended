+        if let Some(database) = database { params.database = DatabaseSelection::Single(database.into()); }
+        Ok(params)
+    }
+    async fn invoke(&self, connection: &SavedConnection, method: ServiceRpcMethod, input: Value, database: Option<&str>, mut context: DriverContext) -> ServiceResult<Value> {
+        let deadline = context_deadline(&context)?;
+        let driver = match self.session(connection, &context, database)? { Some((driver, _)) => driver, None => self.driver(connection).await? };
+        let _active = self.track(connection, &context, driver.clone())?;
+        let params = tokio::select! {
+            result = self.resolved(connection, &context, database) => result?,
+            _ = context.signal.cancelled() => return Err(failure(ErrorCode::Cancelled)),
+            _ = tokio::time::sleep_until(deadline) => return Err(failure(ErrorCode::DeadlineExceeded)),
+        };
+        context.deadline_ms = remaining_ms(deadline)?;
+        driver.service_call(method, &params, &context, input).await
+    }
+    async fn bounded_capabilities(&self, connection: &SavedConnection, context: &mut DriverContext) -> ServiceResult<DriverServiceCapabilities> {
+        let deadline = context_deadline(context)?;
+        let capabilities = tokio::select! {
+            result = self.capabilities(connection) => result?,
+            _ = context.signal.cancelled() => return Err(failure(ErrorCode::Cancelled)),
+            _ = tokio::time::sleep_until(deadline) => return Err(failure(ErrorCode::DeadlineExceeded)),
+        };
+        context.deadline_ms = remaining_ms(deadline)?;
+        Ok(capabilities)
+    }
+    async fn capabilities(&self, connection: &SavedConnection) -> ServiceResult<DriverServiceCapabilities> { self.driver(connection).await?.service_capabilities().await }
+    pub async fn call_spatial(&self, connection: &SavedConnection, method: ServiceRpcMethod, input: Value, mut context: DriverContext) -> ServiceResult<Value> {
+        if !matches!(method, ServiceRpcMethod::SpatialColumns | ServiceRpcMethod::SpatialTransformValues | ServiceRpcMethod::SpatialQueryTable | ServiceRpcMethod::SpatialReadFeature) { return Err(failure(ErrorCode::UnsupportedOperation)); }
