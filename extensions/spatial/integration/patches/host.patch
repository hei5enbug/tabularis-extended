+    assert_eq!(actual.0, Some(ErrorCode::ResultExpired));
+    assert!(!fixture.root.output().exists());
+    assert_eq!(fs::read(actual.1).unwrap(), b"bad");
+}
+
+struct ChildProcess { child: std::process::Child }
+impl Drop for ChildProcess { fn drop(&mut self) { let _ = self.child.kill(); let _ = self.child.wait(); } }
+fn competing_processes(root: &Path) -> Vec<String> {
+    use std::process::{Command, Stdio};
+    let executable = std::env::current_exe().unwrap();
+    let mut children = Vec::new();
+    let (sender, messages) = std::sync::mpsc::channel();
+    let mut threads = Vec::new();
+    for _ in 0..2 {
+        let mut child = Command::new(&executable).args(["--ignored", "--exact", concat!(module_path!(), "::자식_프로세스는_공유_저장소의_예약_경쟁에_참여한다").split_once("::").unwrap().1, "--nocapture", "--test-threads=1"]).env_clear().env("TABULARIS_H3C1_CHILD_ROOT", root).stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::null()).spawn().unwrap();
+        let output = child.stdout.take().unwrap();
+        let sender = sender.clone();
+        threads.push(std::thread::spawn(move || {
+            for line in std::io::BufReader::new(output).lines() {
+                let line = line.unwrap();
+                if let Some(index) = line.find("H3C1_") { sender.send(line[index..].to_owned()).unwrap(); }
+            }
+        }));
+        children.push(ChildProcess { child });
+    }
+    for child in &mut children { child.child.stdin.as_mut().unwrap().write_all(b"reserve\n").unwrap(); }
+    let mut result = (0..2).map(|_| messages.recv_timeout(Duration::from_secs(10)).unwrap()).collect::<Vec<_>>();
+    for child in &mut children { child.child.stdin.as_mut().unwrap().write_all(b"release\n").unwrap(); child.child.stdin.take(); }
+    let end = Instant::now() + Duration::from_secs(10);
+    for child in &mut children {
+        loop {
+            if let Some(status) = child.child.try_wait().unwrap() { assert!(status.success()); break; }
+            assert!(Instant::now() < end, "Isolated reservation subprocess timed out.");
+            std::thread::yield_now();
+        }
+    }
+    for thread in threads { thread.join().unwrap(); }
+    result.sort();
+    result
+}
+#[test]
+fn 두_실제_프로세스가_같은_quota와_개수의_마지막_예약을_경쟁한다() {
+    // given
+    let root = Temporary::new();
+    let store = ArtifactStore::with_limits(root.0.join("artifacts"), ArtifactLimits { max_payload_bytes: 48, max_profile_bytes: 64, max_entries: 1, ..ArtifactLimits::default() }).unwrap();
+    // when
+    let actual = competing_processes(store.store.root());
+    // then
+    assert_eq!(actual, vec!["H3C1_DENIED", "H3C1_RESERVED"]);
+    assert_eq!(store.ids().unwrap().len(), 0);
+}
