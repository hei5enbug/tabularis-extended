+        tokio::select! {
+            _ = gate.wait() => {},
+            _ = context.signal.cancelled() => return Err(failure(ErrorCode::Cancelled)),
+        }
+        match method {
+            ServiceRpcMethod::SpatialColumns => Ok(json!({"columns":[]})),
