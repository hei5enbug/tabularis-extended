+                Ok(ResourceRead::Content(json!({"contents":[{"uri":uri,"mimeType":"application/octet-stream","blob":chunk.bytes_base64}],"artifact_id":id,"offset":offset,"eof":chunk.eof,"checksum":chunk.checksum,"chunk_checksum":chunk.chunk_checksum})))
+            }
+        }
+    }
