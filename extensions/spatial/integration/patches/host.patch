+struct ReservedSession {
+    driver: Arc<dyn DatabaseDriver>, params: ConnectionParams, connection: SavedConnection,
+    context: DriverContext, database: String, auth_identity: String,
+    _permit: tokio::sync::OwnedSemaphorePermit,
