+    drop(observer_client.take());if let Some(task)=observer_task {let _=task.await;}
+    registry::unregister_driver(&driver_id).await;drop(client);let _=connection_task.await;
+    rollback.map_err(|e|format!("boundary rollback {e}"))?;cleanup.map_err(|e|format!("boundary cleanup {e}"))?;scenario
