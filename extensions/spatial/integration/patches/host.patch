+#[cfg(target_os = "macos")]
+async fn install_production(paths: [PathBuf; 3]) -> Result<NativeEvidence, String> {
+    use std::os::unix::fs::PermissionsExt;
+    if std::env::consts::ARCH != "aarch64" { return Err("This fixture requires a native macOS ARM host and Rosetta".into()); }
+    let owned = tempfile::Builder::new().prefix("tabularis-t0e-설치 한글 space-").tempdir().map_err(|_| "Private fixture directory failed")?;
+    std::fs::set_permissions(owned.path(), std::fs::Permissions::from_mode(0o700)).map_err(|_| "Private fixture permissions failed")?;
+    let mut archives = Vec::new();
+    let mut cosmos = Vec::new();
+    let mut spatial_ui_only = false;
+    for (index, path) in paths.into_iter().enumerate() {
+        let id = if index == 0 { "spatial" } else { "cosmos-nosql" };
+        let root = owned.path().join(format!("profile {index}/plugins"));
+        let profile = root.parent().ok_or("Private profile is missing")?;
+        std::fs::create_dir_all(profile).map_err(|_| "Private profile could not be created")?;
+        std::fs::set_permissions(profile, std::fs::Permissions::from_mode(0o700)).map_err(|_| "Private profile permissions failed")?;
+        std::fs::create_dir_all(&root).map_err(|_| "Private plugin root could not be created")?;
+        std::fs::set_permissions(&root, std::fs::Permissions::from_mode(0o700)).map_err(|_| "Private plugin root permissions failed")?;
+        let bytes = std::fs::read(path).map_err(|_| "Production ZIP could not be read")?;
+        let guard = install_cancellation::begin(id)?;
+        installer::install_archive(root.clone(), id, bytes.clone(), Some("0.1.0"), guard.cancellation()).await?;
+        drop(guard);
+        let installed = super::layout::resolve_driver(&root, id).or_else(|_| extensions::destination(&root, id))?;
+        let archive = verify_install(&bytes, &installed, id)?;
+        if index == 0 {
+            for (name, mime) in [("ui/dist/style.css", "text/css"), ("ui/dist/maplibre-worker.js", "text/javascript")] {
+                let asset = extensions::read_asset(&installed, name)?;
+                if asset.mime != mime || asset.bytes != std::fs::read(installed.join(name)).map_err(|_| "Installed asset is missing")? {
+                    return Err("Native asset access differs from installed production bytes".into());
+                }
+            }
+            spatial_ui_only = archive.manifest.get("executable").is_none() && !root.join("spatial").exists();
+        } else {
+            let css = extensions::read_asset(&installed, "ui/dist/style.css")?;
+            if css.mime != "text/css" || css.bytes != std::fs::read(installed.join("ui/dist/style.css")).map_err(|_| "Installed CSS is missing")? {
+                return Err("Native Cosmos CSS access differs from installed production bytes".into());
+            }
+            let arch = if index == 1 { "arm64" } else { "x64" };
+            let runtime = installed.join("runtime/bin/node");
+            let version = child(&runtime, &["-v"], &installed, profile, b"", false).await?;
+            let identity = child(&runtime, &["-p", "JSON.stringify({version:process.version,arch:process.arch,platform:process.platform})"], &installed, profile, b"", false).await?;
+            if !version.success || !version.stderr.is_empty() || !identity.success || !identity.stderr.is_empty() { return Err("Bundled Node identity failed".into()); }
+            let eof = child(&installed.join("cosmos-nosql"), &[], &installed, profile, &protocol(false), true).await?;
+            let shutdown = child(&installed.join("cosmos-nosql"), &[], &installed, profile, &protocol(true), true).await?;
+            cosmos.push(CosmosEvidence {
+                arch: arch.into(), version: String::from_utf8(version.stdout).map_err(|_| "Node version is invalid")?.trim().into(),
+                identity: serde_json::from_slice(&identity.stdout).map_err(|_| "Node identity is invalid")?,
+                eof: parse_protocol(&eof, false)?, shutdown: parse_protocol(&shutdown, true)?,
+            });
+        }
+        println!("Production native install: id={} SHA256={} zip_bytes={} files={} expanded_bytes={}", archive.id, archive.sha256, archive.zip_bytes, archive.files, archive.expanded_bytes);
+        archives.push(archive);
+    }
+    Ok(NativeEvidence { archives, cosmos, spatial_ui_only })
+}
