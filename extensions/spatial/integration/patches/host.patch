+use super::*;
+
+fn checked(arguments:&[&str])->Result<Args,String> {
+    let args=Args::try_parse_from(arguments).map_err(|_|"Invalid arguments".to_owned())?;
+    if let Some(Command::Service(service))=&args.command {service.validate()?;}
+    Ok(args)
+}
+
+#[test]
+fn 서비스_입력과_보호된_채널의_충돌은_명확하게_거부한다(){
+    // given
+    let arguments=[vec!["tabularis","service"],vec!["tabularis","service","--request","-","--credential-stdin"],vec!["tabularis","service","--request","x","--stdio"],vec!["tabularis","service","--stdio","--credential-fd","7"],vec!["tabularis","service","--request","x","--credential-fd","2"],vec!["tabularis","--unknown"],vec!["tabularis","service","approve","id","--decision","edited"]];
+    // when
+    let actual=arguments.map(|arguments|checked(&arguments).is_err());
+    // then
+    assert_eq!(actual,[true;7]);
+}
+#[test]
+fn 단일_요청과_표준입출력과_승인_및_저장_문법은_명시적_값을_유지한다(){
+    // given
+    let output=std::env::temp_dir().join("owned.geojson");
+    let output=output.to_str().unwrap();
+    let arguments=[vec!["tabularis","service","--request","request.json","--write","--credential-stdin"],vec!["tabularis","service","--stdio","--credential-fd","7","--credential-request-id","request-id"],vec!["tabularis","service","approve","approval-id","--decision","deny","--reason","reason"],vec!["tabularis","service","artifact-save","artifact-id","--output",output]];
+    // when
+    let actual=arguments.map(|arguments|checked(&arguments).unwrap());
+    // then
+    assert!(matches!(&actual[0].command,Some(Command::Service(args)) if args.write&&args.credential_stdin&&args.request.as_deref()==Some("request.json")));
+    assert!(matches!(&actual[1].command,Some(Command::Service(args)) if args.stdio&&args.credential_fd==Some(7)&&args.credential_request_id.as_deref()==Some("request-id")));
+    assert!(matches!(&actual[2].command,Some(Command::Service(args)) if matches!(&args.action,Some(ServiceAction::Approve {decision,..}) if decision=="deny")));
+    assert!(matches!(&actual[3].command,Some(Command::Service(args)) if matches!(&args.action,Some(ServiceAction::ArtifactSave {output,..}) if output.is_absolute())));
+}
