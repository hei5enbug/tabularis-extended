@@ -0,0 +1,79 @@
+use std::io::{self, Write};
+use serde_json::{json, Value};
+use super::super::{contracts::{ErrorCode, JobStatus, Operation, Outcome, SchemaValidator, ServiceError, ServiceRequest, ServiceResponse}, dispatch::CallerContext, error::{failure, redact_error, ServiceResult}};
+
+pub const MAX_FRAME_BYTES: usize = 16 * 1024 * 1024;
+pub const MAX_FOREGROUND_MS: u64 = 122_000;
+
+struct CountBytes(usize);
+impl Write for CountBytes {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.0 = self.0.checked_add(bytes.len()).ok_or_else(|| io::Error::other("limit"))?;
+        if self.0 > MAX_FRAME_BYTES { return Err(io::Error::other("limit")); }
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> io::Result<()> { Ok(()) }
+}
+
+pub(crate) fn decode(validator: &SchemaValidator, raw: &Value) -> ServiceResult<ServiceRequest> {
+    serde_json::to_writer(CountBytes(0), raw).map_err(|_| failure(ErrorCode::ResourceLimit))?;
+    validator.decode_request(raw).map_err(|_| failure(if raw.get("protocol_version").is_some_and(|value| value != &json!(1) && value.as_f64() != Some(1.0)) { ErrorCode::ProtocolMismatch } else { ErrorCode::InvalidArgument }))
+}
+
+pub(crate) fn validate_caller(caller: &CallerContext) -> ServiceResult<()> {
+    if caller.caller_id.is_empty() || caller.caller_id.len() > 512 || caller.caller_id.chars().any(char::is_control) { return Err(failure(ErrorCode::PermissionDenied)); }
+    super::super::security::opaque_id(&caller.owner_instance_id)
+}
+
+pub(crate) fn terminal(status: JobStatus) -> bool { !matches!(status, JobStatus::Queued | JobStatus::Running) }
+
+pub(crate) fn checked_response(validator: &SchemaValidator, request: &ServiceRequest, response: ServiceResponse, require_terminal: bool) -> ServiceResult<ServiceResponse> {
+    if response.protocol_version != 1 || response.request_id != request.request_id || response.connection_id != request.connection_id || (require_terminal && !terminal(response.status)) { return Err(failure(ErrorCode::OutcomeUnknown)); }
+    let raw = serde_json::to_value(&response).map_err(|_| failure(ErrorCode::ResourceLimit))?;
+    serde_json::to_writer(CountBytes(0), &raw).map_err(|_| failure(ErrorCode::ResourceLimit))?;
+    validator.validate_response(&raw).map_err(|_| failure(ErrorCode::OutcomeUnknown))?;
+    Ok(response)
+}
+
+pub(crate) fn error_response(request: &ServiceRequest, error: ServiceError) -> ServiceResponse {
+    let error = redact_error(error);
+    let mut response = ServiceResponse::failure(request, error.code, &error.message);
+    response.status = if error.outcome == Outcome::Unknown { JobStatus::OutcomeUnknown } else if error.code == ErrorCode::Cancelled { JobStatus::Cancelled } else { JobStatus::Failed };
+    response.error = Some(error);
+    response
+}
+
+pub(crate) fn unknown_response(request: &ServiceRequest, job_id: Option<String>) -> ServiceResponse {
+    let mut error = failure(ErrorCode::OutcomeUnknown);
+    error.outcome = Outcome::Unknown;
+    let mut response = error_response(request, error);
+    response.job_id = job_id;
+    response
+}
+
+pub(crate) fn rejected_raw(raw: &Value, error: ServiceError) -> ServiceResponse {
+    let identity = |key: &str| raw.get(key).and_then(Value::as_str).filter(|value| !value.is_empty() && value.len() <= 128 && !value.chars().any(char::is_control)).map(str::to_owned);
+    let request = ServiceRequest { protocol_version: 1, operation: Operation::ConnectionList, request_id: identity("request_id").unwrap_or_else(|| "invalid-request".into()), connection_id: identity("connection_id"), session_id: None, map_id: None, expected_version: None, deadline_ms: 30_000, input: json!({}) };
+    error_response(&request, error)
+}
+
+pub fn error_exit_code(error: &ServiceError) -> i32 {
+    match error.code {
+        ErrorCode::InvalidArgument | ErrorCode::ProtocolMismatch => 2,
+        ErrorCode::PermissionDenied | ErrorCode::WriteNotAllowed | ErrorCode::AuthRequired | ErrorCode::AuthExpired | ErrorCode::InteractionRequired => 3,
+        ErrorCode::Cancelled => 130,
+        _ => 4,
+    }
+}
+
+pub fn exit_code(response: &ServiceResponse) -> i32 {
+    response.error.as_ref().map(error_exit_code).unwrap_or(if response.status == JobStatus::Succeeded { 0 } else { 4 })
+}
+
+pub(crate) fn control_operation(operation: Operation) -> bool {
+    matches!(operation, Operation::JobGet | Operation::JobResult | Operation::JobCancel | Operation::AuthStatus | Operation::AuthCancel | Operation::AuthLogout)
+}
+
+pub(crate) fn control_request(request: &ServiceRequest, operation: Operation, job_id: &str, owner: &str, remaining_ms: u64) -> ServiceRequest {
+    ServiceRequest { protocol_version: 1, operation, request_id: uuid::Uuid::new_v4().to_string(), connection_id: request.connection_id.clone(), session_id: None, map_id: None, expected_version: None, deadline_ms: remaining_ms.clamp(1, 120_000), input: json!({"job_id":job_id,"owner_instance_id":owner}) }
+}
diff --git a/src-tauri/src/services/transport/stdio.rs b/src-tauri/src/services/transport/stdio.rs
new file mode 100644
index 0000000000000000000000000000000000000000..24857dc619092f00be6bd45ec5ae6c73fcfa1e6f
--- /dev/null
+++ b/src-tauri/src/services/transport/stdio.rs
@@ -0,0 +1,198 @@
+use std::{sync::Arc, time::Duration};
+use serde_json::{json, Value};
+use tokio::{io::{AsyncBufRead, AsyncBufReadExt, AsyncWrite, AsyncWriteExt}, sync::{mpsc, watch, Semaphore}, task::JoinSet, time::{Instant, timeout_at}};
+use super::{request, ServiceTransport};
+use super::super::{backend::CancellationSignal, contracts::{ErrorCode, ServiceError}, dispatch::{CallerContext, CallerTransport}, error::{failure, redact_error, ServiceResult}};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Mode { Cli, Mcp }
+
+enum Frame { Eof, Line(Vec<u8>), Oversized }
+async fn read_frame<R: AsyncBufRead + Unpin>(reader: &mut R) -> std::io::Result<Frame> {
+    let mut bytes = Vec::new();
+    loop {
+        let available = reader.fill_buf().await?;
+        if available.is_empty() { return Ok(if bytes.is_empty() { Frame::Eof } else { Frame::Line(bytes) }); }
+        let length = available.iter().position(|byte| *byte == b'\n').map_or(available.len(), |position| position + 1);
+        if bytes.len().saturating_add(length) > request::MAX_FRAME_BYTES + 1 { return Ok(Frame::Oversized); }
+        bytes.extend_from_slice(&available[..length]);
+        reader.consume(length);
+        if bytes.last() == Some(&b'\n') { bytes.pop(); if bytes.last() == Some(&b'\r') { bytes.pop(); } return Ok(Frame::Line(bytes)); }
+        if bytes.len() > request::MAX_FRAME_BYTES { return Ok(Frame::Oversized); }
+    }
+}
+
+async fn write_frame<W: AsyncWrite + Unpin>(writer: &mut W, bytes: &[u8], deadlines: &mut watch::Receiver<Instant>) -> ServiceResult<()> {
+    let output=async { writer.write_all(bytes).await?; writer.flush().await };
+    tokio::pin!(output);
+    let mut watch_open=true;
+    loop {
+        let deadline=*deadlines.borrow();
+        tokio::select! {
+            result=&mut output => return result.map_err(|_|failure(ErrorCode::DriverExited)),
+            _=tokio::time::sleep_until(deadline) => return Err(failure(ErrorCode::DeadlineExceeded)),
+            changed=deadlines.changed(), if watch_open => {if changed.is_err(){watch_open=false;}}
+        }
+    }
+}
+
+fn rpc_error(id: Value, error: ServiceError) -> Value {
+    json!({"jsonrpc":"2.0","id":id,"error":{"code":-32602,"message":"Service request failed","data":redact_error(error)}})
+}
+
+fn rpc_id(raw: &Value) -> ServiceResult<Option<Value>> {
+    let object = raw.as_object().ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+    if object.keys().any(|key| !matches!(key.as_str(), "jsonrpc" | "id" | "method" | "params")) || raw["jsonrpc"] != "2.0" || raw["method"].as_str().is_none_or(|name| name.is_empty() || name.len() > 128 || name.chars().any(char::is_control)) { return Err(failure(ErrorCode::InvalidArgument)); }
+    match object.get("id") {
+        None => Ok(None),
+        Some(Value::Null) => Ok(Some(Value::Null)),
+        Some(Value::String(id)) if id.len() <= 128 && !id.chars().any(char::is_control) => Ok(Some(json!(id))),
+        Some(Value::Number(id)) if id.as_f64().is_some_and(|number| number.is_finite() && number.fract() == 0.0 && number.abs() <= 9_007_199_254_740_991.0) => Ok(Some(Value::Number(id.clone()))),
+        _ => Err(failure(ErrorCode::InvalidArgument)),
+    }
+}
+
+fn only_keys(value: &Value, keys: &[&str]) -> ServiceResult<()> {
+    if value.as_object().is_none_or(|object| object.keys().any(|key| !keys.contains(&key.as_str()))) { return Err(failure(ErrorCode::InvalidArgument)); }
+    Ok(())
+}
+
+impl ServiceTransport {
+    async fn mcp_request(self: &Arc<Self>, raw: Value, mut caller: CallerContext, signal: CancellationSignal) -> (Option<Value>, i32) {
+        let id = match rpc_id(&raw) { Ok(id) => id, Err(error) => return (Some(rpc_error(Value::Null, error)), 2) };
+        caller.transport = CallerTransport::Mcp;
+        let params = raw.get("params").cloned().unwrap_or_else(|| json!({}));
+        let result = async {
+            match raw["method"].as_str().unwrap_or_default() {
+                "initialize" => {
+                    only_keys(&params, &["protocolVersion", "capabilities", "clientInfo"])?;
+                    let version = params["protocolVersion"].as_str().filter(|version| matches!(*version, "2024-11-05" | "2025-03-26" | "2025-06-18")).unwrap_or("2025-06-18");
+                    Ok(json!({"protocolVersion":version,"capabilities":{"tools":{},"resources":{}},"serverInfo":{"name":"tabularis-service-transport","version":"1"}}))
+                }
+                "ping" => { only_keys(&params, &[])?; Ok(json!({})) }
+                "tools/list" => { only_keys(&params, &[])?; self.tools() }
+                "resources/list" => {
+                    only_keys(&params,&[])?;
+                    let value=match self.legacy.get() {Some(legacy)=>legacy.list_resources(&caller).await.unwrap_or_else(||json!({"resources":[]})),None=>json!({"resources":[]})};
+                    if serde_json::to_vec(&value).map_err(|_|failure(ErrorCode::ResourceLimit))?.len()>request::MAX_FRAME_BYTES{return Err(failure(ErrorCode::ResourceLimit));}
+                    Ok(value)
+                }
+                "tools/call" => {
+                    only_keys(&params, &["name", "arguments"])?;
+                    let name = params["name"].as_str().ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+                    self.call_tool(name, params["arguments"].clone(), caller, Some(signal)).await
+                }
+                "resources/read" => {
+                    only_keys(&params, &["uri"])?;
+                    let uri = params["uri"].as_str().ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+                    self.resource_with_legacy(uri, &caller).await
+                }
+                "notifications/initialized" if id.is_none() => { only_keys(&params, &[])?; Ok(json!({})) }
+                _ => Err(failure(ErrorCode::UnsupportedOperation)),
+            }
+        }.await;
+        match (id, result) {
+            (None, _) => (None, 0),
+            (Some(id), Ok(result)) => (Some(json!({"jsonrpc":"2.0","id":id,"result":result})), 0),
+            (Some(id), Err(error)) => { let code=request::error_exit_code(&error); (Some(rpc_error(id, error)), code) },
+        }
+    }
+
+    pub async fn run_stdio<R, W>(self: &Arc<Self>, mut reader: R, mut writer: W, mut caller: CallerContext, mode: Mode, explicit_write_intent: bool, shutdown_signal: CancellationSignal) -> ServiceResult<i32>
+    where R: AsyncBufRead + Unpin + Send, W: AsyncWrite + Unpin + Send {
+        request::validate_caller(&caller)?;
+        caller.transport = match mode { Mode::Cli => CallerTransport::Cli, Mode::Mcp => CallerTransport::Mcp };
+        let disconnected = CancellationSignal::default();
+        let (sender, mut receiver) = mpsc::channel::<Value>(64);
+        let (deadline_updates,mut output_deadlines)=watch::channel(Instant::now()+Duration::from_millis(request::MAX_FOREGROUND_MS));
+        let write_signal = disconnected.clone();
+        let write_loop = async {
+            while let Some(value) = receiver.recv().await {
+                let mut bytes = serde_json::to_vec(&value).map_err(|_| failure(ErrorCode::ResourceLimit))?;
+                if bytes.len() > request::MAX_FRAME_BYTES { write_signal.cancel(); return Err(failure(ErrorCode::ResourceLimit)); }
+                bytes.push(b'\n');
+                if let Err(error)=write_frame(&mut writer,&bytes,&mut output_deadlines).await { write_signal.cancel(); return Err(error); }
+            }
+            Ok(())
+        };
+        let read_loop = async {
+            let ordinary = Arc::new(Semaphore::new(80));
+            let control = Arc::new(Semaphore::new(16));
+            let mut tasks = JoinSet::new();
+            let active = CancellationSignal::default();
+            let mut drain_deadline = Instant::now() + Duration::from_secs(2);
+            let mut exit = 0;
+            let mut interrupted = false;
+            loop {
+                while let Some(result) = tasks.try_join_next() { if let Ok(code) = result { if code != 0 { exit = code; } } else { exit = 4; } }
+                let frame = tokio::select! {
+                    _ = shutdown_signal.cancelled() => { interrupted=true; active.cancel(); break; },
+                    _ = disconnected.cancelled() => { active.cancel(); break; },
+                    frame = read_frame(&mut reader) => frame,
+                };
+                let bytes = match frame {
+                    Ok(Frame::Eof) => break,
+                    Ok(Frame::Line(bytes)) => bytes,
+                    Ok(Frame::Oversized) => {
+                        let error = failure(ErrorCode::ResourceLimit);
+                        let response = if mode == Mode::Mcp { rpc_error(Value::Null, error) } else { serde_json::to_value(request::rejected_raw(&Value::Null, error)).map_err(|_| failure(ErrorCode::ResourceLimit))? };
+                        let _ = sender.try_send(response); exit=2; active.cancel(); break;
+                    }
+                    Err(_) => { exit=4; active.cancel(); break; }
+                };
+                if bytes.iter().all(u8::is_ascii_whitespace) { continue; }
+                let raw: Value = match serde_json::from_slice(&bytes) {
+                    Ok(raw) => raw,
+                    Err(_) => {
+                        let error=failure(ErrorCode::InvalidArgument);
+                        let response=if mode==Mode::Mcp {rpc_error(Value::Null,error)} else {serde_json::to_value(request::rejected_raw(&Value::Null,error)).map_err(|_| failure(ErrorCode::ResourceLimit))?};
+                        if sender.try_send(response).is_err() {active.cancel();exit=4;break;} exit=2;continue;
+                    }
+                };
+                let envelope = if mode == Mode::Mcp { &raw["params"]["arguments"] } else { &raw };
+                let is_control = envelope["operation"].as_str().and_then(|name| serde_json::from_value(json!(name)).ok()).is_some_and(request::control_operation)
+                    || (mode==Mode::Mcp && matches!(raw["method"].as_str(),Some("initialize" | "ping" | "tools/list" | "resources/list" | "resources/read" | "notifications/initialized")));
+                let permit = match if is_control { control.clone() } else { ordinary.clone() }.try_acquire_owned() {
+                    Ok(permit) => permit,
+                    Err(_) => {
+                        let error=failure(ErrorCode::ResourceLimit);
+                        let response=if mode==Mode::Mcp {match rpc_id(&raw) {Ok(None)=>continue,Ok(Some(id))=>rpc_error(id,error),Err(error)=>rpc_error(Value::Null,error)}} else {serde_json::to_value(request::rejected_raw(&raw,error)).map_err(|_| failure(ErrorCode::ResourceLimit))?};
+                        if sender.try_send(response).is_err() {active.cancel();exit=4;break;} exit=4;continue;
+                    }
+                };
+                let deadline_ms=envelope["deadline_ms"].as_u64().unwrap_or(30_000).clamp(1,120_000);
+                let deadline=Instant::now()+Duration::from_millis(deadline_ms+2_000);
+                drain_deadline=drain_deadline.max(deadline);
+                deadline_updates.send_replace(drain_deadline);
+                let transport=self.clone(); let caller=caller.clone(); let signal=active.clone(); let sender=sender.clone();
+                tasks.spawn(async move {
+                    let _permit=permit;
+                    let (response, code) = if mode==Mode::Mcp {transport.mcp_request(raw,caller,signal).await} else {
+                        let response=match transport.run_one(raw.clone(),caller,explicit_write_intent,Some(signal)).await {Ok(response)=>response,Err(error)=>request::rejected_raw(&raw,error)};
+                        let code=request::exit_code(&response);
+                        (serde_json::to_value(response).ok(),code)
+                    };
+                    if let Some(response)=response { if !matches!(timeout_at(deadline,sender.send(response)).await,Ok(Ok(()))) {return 4;} }
+                    code
+                });
+            }
+            if interrupted || disconnected.is_cancelled() { drain_deadline=drain_deadline.min(Instant::now()+Duration::from_secs(2)); }
+            deadline_updates.send_replace(drain_deadline);
+            loop {
+                match timeout_at(drain_deadline,tasks.join_next()).await {
+                    Ok(Some(Ok(code))) => if code!=0 {exit=code;},
+                    Ok(Some(Err(_))) => exit=4,
+                    Ok(None) => break,
+                    Err(_) => {active.cancel();tasks.abort_all();while tasks.join_next().await.is_some(){} exit=4;break;}
+                }
+            }
+            let shutdown_deadline=drain_deadline.max(Instant::now()+Duration::from_millis(1));
+            if !matches!(timeout_at(shutdown_deadline,self.runtime.shutdown()).await,Ok(Ok(()))) && exit==0 {exit=4;}
+            drop(sender);
+            Ok(if interrupted {130}else{exit})
+        };
+        let (read, written) = tokio::join!(read_loop, write_loop);
+        written?;
+        read
+    }
+}
