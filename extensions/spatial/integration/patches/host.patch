+
+fn bound_snapshot(mut snapshot: ResultSnapshot) -> ServiceResult<ResultSnapshot> {
+    let mut count = 0usize;
+    let mut metadata = snapshot.clone(); for set in &mut metadata.sets { set.rows.clear(); }
+    let mut bytes = serde_json::to_vec(&metadata).map_err(|_| failure(ErrorCode::ResourceLimit))?.len().saturating_add(1024);
+    let mut truncated = false;
+    if snapshot.sets.len() > 128 { return Err(failure(ErrorCode::ResourceLimit)); }
+    for set in &mut snapshot.sets {
+        if bytes > MAX_RESULT_BYTES { return Err(failure(ErrorCode::ResourceLimit)); }
+        let mut retained = Vec::new();
+        for row in std::mem::take(&mut set.rows) {
+            let size = serde_json::to_vec(&row).map_err(|_| failure(ErrorCode::ResourceLimit))?.len() + 1;
+            if count >= MAX_RESULT_ROWS || bytes.saturating_add(size) > MAX_RESULT_BYTES { truncated = true; continue; }
+            if truncated { continue; }
+            bytes += size; count += 1; retained.push(row);
+        }
+        set.rows = retained;
+    }
+    if truncated {
+        if !snapshot.allow_truncation { return Err(failure(ErrorCode::ResourceLimit)); }
+        snapshot.limits.truncated = true;
+        snapshot.limits.reasons.push(if count >= MAX_RESULT_ROWS { "row_limit" } else { "byte_limit" }.into());
+    }
+    Ok(snapshot)
