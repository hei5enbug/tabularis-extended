+#[derive(Default)]
+pub(super) struct SinkState {
+    pub destinations: Vec<ExportDestination>,
+    pub published: Vec<Vec<u8>>,
+    pub stats: Vec<ExportStats>,
+    pub dropped: usize,
+    pub append_calls: usize,
+    pub finish_calls: usize,
+}
+
+pub(super) struct SinkFactory {
+    pub state: Arc<Mutex<SinkState>>,
+    pub fail_append_at: AtomicUsize,
+    pub mode: AtomicUsize,
+    pub reject_reservation: AtomicBool,
+    pub hook_at: AtomicUsize,
+    pub hook: Mutex<Option<Box<dyn FnOnce() + Send>>>,
+}
+
+impl SinkFactory {
+    pub fn new() -> Arc<Self> {
+        Arc::new(Self { state: Default::default(), fail_append_at: AtomicUsize::new(0), mode: AtomicUsize::new(0), reject_reservation: AtomicBool::new(false), hook_at: AtomicUsize::new(0), hook: Mutex::new(None) })
+    }
+}
+
+struct Sink { factory: Arc<Mutex<SinkState>>, fail_append_at: usize, mode: usize, hook_at: usize, hook: Option<Box<dyn FnOnce() + Send>>, bytes: Vec<u8>, published: bool }
+impl SpatialExportSinkFactory for SinkFactory {
+    fn reserve(&self, destination: ExportDestination) -> ServiceResult<Box<dyn SpatialExportSink>> {
+        if self.reject_reservation.load(Ordering::SeqCst) { return Err(failure(ErrorCode::ResourceLimit)); }
+        self.state.lock().unwrap().destinations.push(destination);
+        Ok(Box::new(Sink { factory: self.state.clone(), fail_append_at: self.fail_append_at.load(Ordering::SeqCst), mode: self.mode.load(Ordering::SeqCst), hook_at: self.hook_at.load(Ordering::SeqCst), hook: self.hook.lock().unwrap().take(), bytes: vec![], published: false }))
+    }
+}
+impl SpatialExportSink for Sink {
+    fn append(&mut self, bytes: &[u8]) -> ServiceResult<()> {
+        let count = { let mut state = self.factory.lock().unwrap(); state.append_calls += 1; state.append_calls };
+        if count == self.fail_append_at { return Err(failure(ErrorCode::ResourceLimit)); }
+        self.bytes.extend_from_slice(bytes);
+        if count == self.hook_at { if let Some(hook) = self.hook.take() { hook(); } }
+        Ok(())
+    }
+    fn finish(mut self: Box<Self>, stats: ExportStats) -> ServiceResult<ExportArtifact> {
+        self.factory.lock().unwrap().finish_calls += 1;
+        if self.mode == 4 { return Err(failure(ErrorCode::ResourceLimit)); }
+        let bytes = self.bytes.len() as u64;
+        let checksum = digest(&self.bytes);
+        { let mut state = self.factory.lock().unwrap(); state.published.push(std::mem::take(&mut self.bytes)); state.stats.push(stats); }
+        self.published = true;
+        Ok(ExportArtifact { artifact_id: if self.mode == 2 { "artifact-invalid".into() } else { format!("artifact-{}", uuid::Uuid::new_v4()) }, bytes: bytes + u64::from(self.mode == 3), checksum: if self.mode == 1 { "0".repeat(64) } else { checksum } })
+    }
+}
+impl Drop for Sink { fn drop(&mut self) { if !self.published { self.factory.lock().unwrap().dropped += 1; } } }
