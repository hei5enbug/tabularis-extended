+        if let Some(metadata) = value.get(field) {
+            let valid = match field {
+                "partition_key_paths" => metadata.as_array().is_some_and(|paths| paths.iter().all(Value::is_string)),
+                "partition_key_kind" => metadata.is_string(), "partition_key_version" => metadata.as_u64().is_some(), "system_key" => metadata.is_boolean(), _ => false,
+            };
+            if !valid { return Err(failure(ErrorCode::InvalidArgument)); }
+            normalized[field] = metadata.clone();
+        }
+    }
+    Ok(normalized)
+}
+fn native_output(mut value: Value, connection: &SavedConnection, input: &Value) -> ServiceResult<DriverOutput> {
+    let mut output = empty_output();
+    if value.get("snapshot").is_none() && value.get("data").is_some_and(|data| data.get("snapshot").is_some()) {
+        let envelope = value;
+        value = envelope["data"].clone();
+        for field in ["metrics", "limits"] { if let Some(metadata) = envelope.get(field) { value[field] = metadata.clone(); } }
+        let mut combined = warnings(&value["warnings"]); combined.extend(warnings(&envelope["warnings"])); value["warnings"] = json!(combined);
+    }
+    if value.get("snapshot").is_none() && value.get("cursor").is_some() { return Err(failure(ErrorCode::InvalidArgument)); }
+    output.metrics = match value.get("metrics") { Some(metrics) => serde_json::from_value(metrics.clone()).map_err(|_| failure(ErrorCode::InvalidArgument))?, None => Metrics::default() };
+    output.limits = match value.get("limits") { Some(limits) => serde_json::from_value(limits.clone()).map_err(|_| failure(ErrorCode::InvalidArgument))?, None => Limits::default() };
+    output.warnings = warnings(&value["warnings"]);
+    output.session_closed = value["session_closed"].as_bool().unwrap_or(false);
+    output.confirmed_cancelled = value["confirmed_cancelled"].as_bool().unwrap_or(false);
+    if let Some(snapshot) = value.get("snapshot") {
+        let mut snapshot: ResultSnapshot = serde_json::from_value(snapshot.clone()).map_err(|_| failure(ErrorCode::InvalidArgument))?;
+        snapshot.warnings = warnings(&json!(snapshot.warnings));
+        if snapshot.sets.len() != 1 || snapshot.sets.iter().any(|set| !matches!(set.kind, ResultKind::Documents | ResultKind::JsonValues)) { return Err(failure(ErrorCode::InvalidArgument)); }
