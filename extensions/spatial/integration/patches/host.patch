+fn artifact_id(id: &str) -> ServiceResult<()> {
+    let uuid = id.strip_prefix("artifact-").and_then(|id| uuid::Uuid::parse_str(id).ok()).ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+    if uuid.get_version_num() != 4 || uuid.get_variant() != uuid::Variant::RFC4122 || id != format!("artifact-{uuid}") { return Err(failure(ErrorCode::InvalidArgument)); }
+    Ok(())
+}
