+        let driver = self.driver(connection).await?;
+        let epoch = *self.auth_epochs.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.entry(connection.id.clone()).or_default();
+        let _active = self.track(connection, &context, driver.clone())?;
+        let params = tokio::select! {
+            result = self.resolved(connection, &context, Some(database)) => result?,
+            _ = context.signal.cancelled() => return Err(failure(ErrorCode::Cancelled)),
+            _ = tokio::time::sleep_until(deadline) => return Err(failure(ErrorCode::DeadlineExceeded)),
+        };
+        context.deadline_ms = remaining_ms(deadline)?;
+        let response = driver.service_call(ServiceRpcMethod::SessionOpen, &params, &context, json!({"database":database,"mode":if context.read_only {"read_only"} else {"write"}})).await?;
+        let handle = response.get("session_handle").and_then(Value::as_str).filter(|handle| !handle.is_empty() && handle.len() <= 128).ok_or_else(|| { let mut error = failure(ErrorCode::OutcomeUnknown); error.outcome = Outcome::Unknown; error })?.to_owned();
+        let inserted = {
+            let epochs = self.auth_epochs.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?;
+            let mut sessions = self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?;
+            let key = (connection.id.clone(), handle.clone());
+            if response["in_transaction"] != true || response["rollback_confirmed"] != false { let mut error = failure(ErrorCode::OutcomeUnknown); error.outcome = Outcome::Unknown; Err(error) }
