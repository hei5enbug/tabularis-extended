+            let binding = &cursor["binding"];
+            let string = |field: &str| -> ServiceResult<Option<String>> { binding[field].as_str().filter(|value| !value.is_empty()).map(|value| Some(value.into())).ok_or_else(|| failure(ErrorCode::InvalidArgument)) };
