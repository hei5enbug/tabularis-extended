+        if grant.expires_at_ms < now_ms().saturating_add(deadline_ms).saturating_add(REFRESH_MARGIN_MS) { return Err(failure(ErrorCode::AuthExpired)); }
+        if grant.refresh_token.is_none() { grant.refresh_token = Some(refresh); }
+        self.install(&config, grant, generation, persistence == super::credentials::SecretPersistence::Keychain).await
+    }
