+fn replay_scenario(store:&ResultStore,token:&str)->(bool,ErrorCode,Value,Value) {
+    let first=matches!(store.begin_spatial_next(token,&binding()).unwrap(),SpatialNextPage::State(_));
+    let concurrent=store.begin_spatial_next(token,&binding()).err().unwrap().code;
+    let published=store.finish_spatial_next(token,&binding(),page()).unwrap();
+    let repeated=store.finish_spatial_next(token,&binding(),StoredPage {data:json!({"wrong":true}),..page()}).unwrap();
+    let replay=match store.begin_spatial_next(token,&binding()).unwrap(){SpatialNextPage::Replay(page)=>page,_=>panic!("missing replay")};
+    (first,concurrent,json!([published.data,repeated.data]),replay.data)
+}
