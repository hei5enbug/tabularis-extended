+export function createNativeFixture(inputs) {
+  requireCondition(process.platform === "darwin", "NATIVE_MACOS_FIXTURE_REQUIRED");
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), "tabularis-service-fixture-"));
