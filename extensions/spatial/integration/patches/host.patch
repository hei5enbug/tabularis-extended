+async fn install_spatial_native(root: PathBuf, bytes: Vec<u8>) -> Result<(ArchiveEvidence, bool, bool), String> {
+    let guard = install_cancellation::begin("spatial")?;
+    installer::install_archive(root.clone(), "spatial", bytes.clone(), Some("0.1.0"), guard.cancellation()).await?;
+    drop(guard);
+    let installed = super::layout::resolve_driver(&root, "spatial").or_else(|_| extensions::destination(&root, "spatial"))?;
+    let evidence = verify_install(&bytes, &installed, "spatial")?;
+    let mut assets_match = true;
+    for (name, mime) in [("ui/dist/style.css", "text/css"), ("ui/dist/maplibre-worker.js", "text/javascript")] {
+        let asset = extensions::read_asset(&installed, name)?;
+        assets_match &= asset.mime == mime
+            && asset.bytes == std::fs::read(installed.join(name)).map_err(|_| "Installed asset is missing")?;
+    }
+    let extension_only = evidence.manifest.get("executable").is_none() && !root.join("spatial").exists();
+    Ok((evidence, assets_match, extension_only))
+}
