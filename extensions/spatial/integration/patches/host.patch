+async fn terminal(harness: &Harness, job_id: &str) -> ServiceResponse {
+    tokio::time::timeout(Duration::from_secs(5), async { loop {
+        let job=harness.runtime.jobs.get(job_id,"owner",&caller()).unwrap();
+        if !matches!(job.status,JobStatus::Queued|JobStatus::Running) { return job.response.unwrap(); }
+        tokio::time::sleep(Duration::from_millis(5)).await;
+    }}).await.unwrap()
+}
