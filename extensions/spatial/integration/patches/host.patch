+        let parsed = if method == ServiceRpcMethod::ExactQuery { sql_output(value) } else { native_output(value, connection, &request.input) };
+        let mut output = parsed.map_err(|mut error| { if !context.read_only { error.outcome = Outcome::Applied; } error })?;
+        if method == ServiceRpcMethod::ExactQuery && output.limits.truncated {
