new file mode 100644
index 0000000000000000000000000000000000000000..6424a591c5a54304febff6766df10e0ebf081187
--- /dev/null
+++ b/src-tauri/src/services/security.rs
@@ -0,0 +1,43 @@
+use serde_json::Value;
+use sha2::{Digest, Sha256};
+use super::{contracts::ErrorCode, error::{failure, ServiceResult}};
+
+pub fn digest(bytes: &[u8]) -> String { format!("{:x}", Sha256::digest(bytes)) }
+pub fn value_hash(value: &Value) -> String { digest(&serde_json::to_vec(value).unwrap_or_default()) }
+
+pub fn opaque_id(value: &str) -> ServiceResult<()> {
+    if value.is_empty() || value.len() > 128 || !value.bytes().all(|byte| byte.is_ascii_alphanumeric() || byte == b'-' || byte == b'_') {
+        return Err(failure(ErrorCode::InvalidArgument));
+    }
+    Ok(())
+}
+
+pub fn validate_settings(value: &Value) -> ServiceResult<()> {
+    match value {
+        Value::Object(object) => {
+            for (key, value) in object {
+                let key = key.to_ascii_lowercase().replace(['-', '_', ' '], "");
+                if matches!(key.as_str(), "password" | "dbpassword" | "clientsecret" | "secret" | "token" | "accesstoken" | "refreshtoken" | "accountkey" | "key" | "connectionstring" | "connectionuri" | "privatekey" | "certificate" | "passphrase") || ["password","clientsecret","accesstoken","refreshtoken","accountkey","privatekey","passphrase"].iter().any(|suffix|key.ends_with(suffix)) {
+                    return Err(failure(ErrorCode::InvalidArgument));
+                }
+                validate_settings(value)?;
+            }
+        }
+        Value::Array(values) => { for value in values { validate_settings(value)?; } }
+        Value::String(value) if value.len() > 16_384 => return Err(failure(ErrorCode::InvalidArgument)),
+        _ => {}
+    }
+    Ok(())
+}
+
+pub fn sanitized_settings(value: &Value) -> Value {
+    match value {
+        Value::Object(object) => Value::Object(object.iter().filter_map(|(key, value)| {
+            let mut item = serde_json::Map::new(); item.insert(key.clone(), Value::Null);
+            validate_settings(&Value::Object(item)).ok().map(|_| (key.clone(), sanitized_settings(value)))
+        }).collect()),
+        Value::Array(values) => Value::Array(values.iter().map(sanitized_settings).collect()),
+        Value::String(value) if reqwest::Url::parse(value).is_ok_and(|url|!url.username().is_empty() || url.password().is_some()) => Value::Null,
+        value => value.clone(),
+    }
+}
diff --git a/src-tauri/src/services/sessions.rs b/src-tauri/src/services/sessions.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2a4a0a600b6309d482be983d91112a078d7d015c
--- /dev/null
+++ b/src-tauri/src/services/sessions.rs
@@ -0,0 +1,106 @@
+use std::{collections::HashMap, sync::{Arc, Mutex}, time::Duration};
+use tokio::sync::{Mutex as AsyncMutex, OwnedMutexGuard};
+use super::{backend::{DriverBackend, DriverContext, SavedConnection, SessionFinish}, contracts::ErrorCode, dispatch::CallerContext, error::{failure, ServiceResult}, storage::now_ms};
+
+pub const SESSION_IDLE_MS: u64 = 5 * 60 * 1000;
+const MAX_SESSIONS: usize = 64;
+
+struct Session {
+    connection: SavedConnection, caller_id: String, owner_instance_id: String,
+    handle: String, read_only: bool, last_used_ms: u64, closed: bool, invalidated: bool,
+}
+pub struct SessionManager { sessions: Mutex<HashMap<String, (String, Arc<AsyncMutex<Session>>)>>, driver: Arc<dyn DriverBackend>, idle_ms: u64 }
+
+impl SessionManager {
+    pub fn new(driver: Arc<dyn DriverBackend>) -> Self { Self::with_idle(driver, SESSION_IDLE_MS) }
+    pub fn with_idle(driver: Arc<dyn DriverBackend>, idle_ms: u64) -> Self { Self { sessions: Mutex::new(HashMap::new()), driver, idle_ms: idle_ms.min(SESSION_IDLE_MS) } }
+    pub async fn is_write(&self, id: &str, connection_id: &str, caller: &CallerContext) -> ServiceResult<bool> {
+        let session = self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.get(id).map(|(_,session)|session.clone()).ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+        let session = session.lock().await;
+        if session.closed || session.connection.id != connection_id || session.caller_id != caller.caller_id || session.owner_instance_id != caller.owner_instance_id { return Err(failure(ErrorCode::PermissionDenied)); }
+        Ok(!session.read_only)
+    }
+    pub async fn open(&self, connection: &SavedConnection, database: &str, read_only: bool, caller: &CallerContext, context: DriverContext) -> ServiceResult<String> {
+        if connection.driver == "cosmos-nosql" { return Err(failure(ErrorCode::UnsupportedOperation)); }
+        let id = format!("s-{}", uuid::Uuid::new_v4());
+        {
+            let mut sessions = self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?;
+            if sessions.len() >= MAX_SESSIONS { return Err(failure(ErrorCode::ResourceLimit)); }
+            sessions.insert(id.clone(), (connection.id.clone(), Arc::new(AsyncMutex::new(Session { connection: connection.clone(), caller_id: caller.caller_id.clone(), owner_instance_id: caller.owner_instance_id.clone(), handle: String::new(), read_only, last_used_ms: now_ms(), closed: true, invalidated:false }))));
+        }
+        let handle = match tokio::time::timeout(Duration::from_millis(context.deadline_ms), self.driver.reserve_session(connection, database, context)).await {
+            Ok(Ok(handle)) => handle,
+            result => { self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.remove(&id); return Err(match result { Ok(Err(error)) => error, _ => failure(ErrorCode::DeadlineExceeded) }); }
+        };
+        let session = self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.get(&id).map(|(_,session)|session.clone());
+        let Some(session) = session else { self.driver.discard_session(&connection.id,&handle).await; return Err(failure(ErrorCode::AuthRequired)); };
+        let mut session = session.lock().await;
+        if session.invalidated { self.driver.discard_session(&connection.id,&handle).await; return Err(failure(ErrorCode::AuthRequired)); }
+        session.handle = handle; session.closed = false;
+        Ok(id)
+    }
+    pub async fn acquire(&self, id: &str, connection: &SavedConnection, caller: &CallerContext, write: bool, context: &DriverContext) -> ServiceResult<SessionLease> {
+        let session = self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.get(id).map(|(_,session)|session.clone()).ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+        let mut guard = tokio::time::timeout(Duration::from_millis(context.deadline_ms), session.lock_owned()).await.map_err(|_| failure(ErrorCode::DeadlineExceeded))?;
+        if guard.closed || guard.connection.id != connection.id || guard.connection.auth_revision != connection.auth_revision || guard.caller_id != caller.caller_id || guard.owner_instance_id != caller.owner_instance_id { return Err(failure(ErrorCode::PermissionDenied)); }
+        if now_ms().saturating_sub(guard.last_used_ms) >= self.idle_ms {
+            guard.closed = true;
+            self.rollback_or_discard(&guard, context.clone()).await;
+            self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.remove(id);
+            return Err(failure(ErrorCode::DeadlineExceeded));
+        }
+        if write && guard.read_only { return Err(failure(ErrorCode::WriteNotAllowed)); }
+        guard.last_used_ms = now_ms();
+        Ok(SessionLease { guard })
+    }
+    async fn rollback_or_discard(&self, session: &Session, mut context: DriverContext) {
+        context.session_handle = Some(session.handle.clone());
+        if !matches!(tokio::time::timeout(Duration::from_millis(context.deadline_ms), self.driver.finish_session(&session.connection, &session.handle, SessionFinish::Rollback, context)).await, Ok(Ok(()))) { self.driver.discard_session(&session.connection.id, &session.handle).await; }
+    }
+    pub async fn finish(&self, id: &str, connection: &SavedConnection, caller: &CallerContext, finish: SessionFinish, context: DriverContext) -> ServiceResult<()> {
+        let mut lease = self.acquire(id, connection, caller, false, &context).await?;
+        lease.guard.closed = true;
+        let mut context = context; context.session_handle = Some(lease.guard.handle.clone());
+        let result = tokio::time::timeout(Duration::from_millis(context.deadline_ms), self.driver.finish_session(connection, &lease.guard.handle, finish, context)).await;
+        self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.remove(id);
+        match result {
+            Ok(Ok(())) => Ok(()),
+            other => { self.driver.discard_session(&connection.id, &lease.guard.handle).await; Err(match other { Ok(Err(error)) => error, _ => failure(ErrorCode::OutcomeUnknown) }) }
+        }
+    }
+    pub async fn expire_idle(&self, context: DriverContext) -> ServiceResult<usize> {
+        let sessions: Vec<_> = self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.iter().map(|(id, (_, session))| (id.clone(), session.clone())).collect();
+        let mut removed = 0;
+        for (id, session) in sessions {
+            if let Ok(mut guard) = session.try_lock_owned() {
+                if !guard.closed && now_ms().saturating_sub(guard.last_used_ms) >= self.idle_ms {
+                    guard.closed = true; self.rollback_or_discard(&guard, context.clone()).await;
+                    self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.remove(&id); removed += 1;
+                }
+            }
+        }
+        Ok(removed)
+    }
+    pub async fn invalidate_connection(&self, connection_id: &str, context: DriverContext) -> ServiceResult<()> {
+        let sessions: Vec<_> = self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.iter().filter(|(_, (id, _))| id == connection_id).map(|(id, (_, session))| (id.clone(), session.clone())).collect();
+        for (id, session) in sessions {
+            let mut guard = session.lock().await;
+            guard.invalidated = true;
+            if !guard.closed { guard.closed = true; self.rollback_or_discard(&guard, context.clone()).await; }
+            self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?.remove(&id);
+        }
+        Ok(())
+    }
+    pub async fn discard(&self, id: &str, connection_id: &str) -> ServiceResult<()> {
+        let session = { let mut sessions = self.sessions.lock().map_err(|_| failure(ErrorCode::ResourceLimit))?; if sessions.get(id).is_some_and(|(stored,_)| stored != connection_id) { return Err(failure(ErrorCode::PermissionDenied)); } sessions.remove(id) };
+        if let Some((stored,session)) = session { if stored != connection_id { return Err(failure(ErrorCode::PermissionDenied)); } let mut guard=session.lock().await; guard.closed=true; guard.invalidated=true; if !guard.handle.is_empty() { self.driver.discard_session(connection_id,&guard.handle).await; } }
+        Ok(())
+    }
+}
+
+pub struct SessionLease { guard: OwnedMutexGuard<Session> }
+impl SessionLease {
+    pub fn handle(&self) -> &str { &self.guard.handle }
+    pub fn read_only(&self) -> bool { self.guard.read_only }
+}
+impl Drop for SessionLease { fn drop(&mut self) { self.guard.last_used_ms = now_ms(); } }
diff --git a/src-tauri/src/services/spatial/data_domain.rs b/src-tauri/src/services/spatial/data_domain.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d9298b929b179b97bb5db3f7648d52381cf290aa
--- /dev/null
+++ b/src-tauri/src/services/spatial/data_domain.rs
@@ -0,0 +1,109 @@
+use std::{sync::{Arc, Weak}, time::Duration};
+use async_trait::async_trait;
+use serde_json::{json, Value};
+use tabularis_spatial_core::{LayerSource, TableRef};
+use crate::{drivers::driver_trait::ServiceRpcMethod, services::{backend::{DriverContext, PermissionScope, SavedConnection}, contracts::{ErrorCode, JobStatus, Limits, Metrics, Operation, Page, ServiceRequest, ServiceResponse}, dispatch::CallerContext, error::{failure, ServiceResult}, extensions::OperationExtension, jobs::JobLease, results::{CursorBinding, SpatialNextPage, StoredPage}, runtime::ServiceRuntime, storage::now_ms}};
+use super::{driver::SpatialDriverBackend, feature, paging::{self, Publication}, query_result, table_query, MapStore};
+
+const OPERATIONS: &[Operation] = &[Operation::SpatialColumns, Operation::SpatialQueryResult, Operation::SpatialTableQuery, Operation::SpatialFeature];
+pub struct SpatialDataDomain { runtime: Weak<ServiceRuntime>, driver: Arc<dyn SpatialDriverBackend>, maps: Option<Arc<MapStore>> }
+pub struct PreparedExecution { pub runtime: Arc<ServiceRuntime>, pub connection: SavedConnection, pub permission: PermissionScope, context: DriverContext, request: ServiceRequest, caller: CallerContext, deadline_at_ms: u64, map_fence: Option<(String, u64, u64)> }
+
+impl SpatialDataDomain {
+    pub fn attach(runtime: &Arc<ServiceRuntime>, driver: Arc<dyn SpatialDriverBackend>, maps: Option<Arc<MapStore>>) -> ServiceResult<Arc<Self>> {
+        let domain = Arc::new(Self { runtime: Arc::downgrade(runtime), driver, maps }); runtime.register_extension(domain.clone())?; Ok(domain)
+    }
+    pub fn guard(&self, execution: &PreparedExecution) -> ServiceResult<()> {
+        if execution.context.signal.is_cancelled() { return Err(failure(ErrorCode::Cancelled)); }
+        if now_ms() >= execution.deadline_at_ms { return Err(failure(ErrorCode::DeadlineExceeded)); } Ok(())
+    }
+    async fn prepare(&self, request: &ServiceRequest, caller: &CallerContext, lease: &JobLease, source: Option<&LayerSource>) -> ServiceResult<PreparedExecution> {
+        let runtime = self.runtime.upgrade().ok_or_else(|| failure(ErrorCode::CapabilityUnavailable))?;
+        let id = request.connection_id.as_deref().ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+        if request.session_id.is_some() { return Err(failure(ErrorCode::UnsupportedOperation)); }
+        let connection = runtime.connections.get(id).await?; let permission = runtime.policy.permission(&connection, caller).await?;
+        if connection.id != id || permission.identity.is_empty() || permission.identity.len() > 512 { return Err(failure(ErrorCode::PermissionDenied)); }
+        let remaining = lease.deadline_at_ms.saturating_sub(now_ms()).min(120_000);
+        let transient_auth = runtime.auth.context(&connection, remaining).await?;
+        let map_fence = if let Some(id) = &request.map_id {
+            let store = self.maps.as_ref().ok_or_else(|| failure(ErrorCode::CapabilityUnavailable))?; let map = store.get(id, caller)?;
+            if request.expected_version.is_some_and(|version| version != map.map.version) { return Err(super::map_store::conflict(map.map.version, false)); }
+            let requested_table = request.input.get("table").map(paging::decode::<TableRef>).transpose()?;
+            let layer = map.map.layers.iter().find(|layer| layer.connection_id == connection.id && match source { Some(source) => layer.source == *source, None => matches!((&layer.source, &requested_table), (LayerSource::Table { table, .. }, Some(requested)) if table == requested) }).ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+            if let LayerSource::QueryResult { .. } = &layer.source { let binding = map.source_bindings.get(&layer.layer_id).ok_or_else(|| failure(ErrorCode::AuthRequired))?; authorize_binding(binding, &connection, &permission)?; }
+            Some((id.clone(), map.map.version, map.apply_generation))
+        } else { None };
+        let execution = PreparedExecution { runtime, context: DriverContext { connection_id: id.into(), request_id: request.request_id.clone(), deadline_ms: remaining, signal: lease.signal(), transient_auth, read_only: true, session_handle: None }, connection, permission, request: request.clone(), caller: caller.clone(), deadline_at_ms: lease.deadline_at_ms, map_fence };
+        self.revalidate(&execution).await?; Ok(execution)
+    }
+    pub async fn revalidate(&self, execution: &PreparedExecution) -> ServiceResult<()> {
+        self.guard(execution)?;
+        let current = execution.runtime.connections.get(&execution.connection.id).await?;
+        let permission = execution.runtime.policy.permission(&current, &execution.caller).await?;
+        if current.id != execution.connection.id || current.driver != execution.connection.driver || current.auth_revision != execution.connection.auth_revision { return Err(failure(ErrorCode::AuthRequired)); }
+        if permission.identity != execution.permission.identity { return Err(failure(ErrorCode::PermissionDenied)); }
+        if let Some((id, version, generation)) = &execution.map_fence { let map = self.maps.as_ref().ok_or_else(|| failure(ErrorCode::CapabilityUnavailable))?.get(id, &execution.caller)?; if map.map.version != *version || map.apply_generation != *generation { return Err(super::map_store::conflict(map.map.version, false)); } }
+        self.guard(execution)
+    }
+    pub async fn rpc(&self, execution: &PreparedExecution, method: ServiceRpcMethod, input: Value) -> ServiceResult<Value> {
+        self.revalidate(execution).await?;
+        let mut context = execution.context.clone(); context.deadline_ms = execution.deadline_at_ms.saturating_sub(now_ms()).min(120_000);
+        let signal = context.signal.clone();
+        let call = tokio::time::timeout(Duration::from_millis(context.deadline_ms), self.driver.call(&execution.connection, method, input, context));
+        let result = tokio::select! { biased; _ = signal.cancelled() => { let _ = self.driver.cancel(&execution.connection.id, &execution.request.request_id).await; Err(failure(ErrorCode::Cancelled)) }, result = call => match result { Ok(result) => result, Err(_) => { let _ = self.driver.cancel(&execution.connection.id, &execution.request.request_id).await; Err(failure(ErrorCode::DeadlineExceeded)) } } }?;
+        self.revalidate(execution).await?; Ok(result)
+    }
+    async fn query(&self, request: &ServiceRequest, caller: &CallerContext, lease: &JobLease) -> ServiceResult<ServiceResponse> {
+        let source = paging::source_from_input(&request.input, if request.operation == Operation::SpatialQueryResult { "query_result" } else { "table" })?;
+        let size = paging::page_size(&request.input)?; let hash = paging::request_hash(&source, size, request.operation)?;
+        let execution = self.prepare(request, caller, lease, Some(&source)).await?;
+        let token = request.input["next_token"].as_str();
+        let binding = if let LayerSource::QueryResult { result_id, .. } = &source { let binding = execution.runtime.results.result_binding(result_id)?; authorize_binding(&binding, &execution.connection, &execution.permission)?; execution.runtime.results.snapshot(result_id, &binding)?; binding } else if let Some(token) = token { let binding = execution.runtime.results.token_binding(token)?; authorize_binding(&binding, &execution.connection, &execution.permission)?; if binding.query_hash != paging::source_hash(&source)? { return Err(failure(ErrorCode::InvalidPageToken)); } binding } else { CursorBinding { connection_id: execution.connection.id.clone(), permission_scope: execution.permission.identity.clone(), auth_revision: execution.connection.auth_revision.clone(), query_hash: paging::source_hash(&source)?, result_revision: uuid::Uuid::new_v4().to_string(), sdk_version: None, container_rid: None, endpoint_identity: None, partition_hash: None } };
+        let state = if let Some(token) = token {
+            execution.runtime.results.check_spatial_request(token, &binding, &hash)?;
+            match execution.runtime.results.begin_spatial_next(token, &binding)? { SpatialNextPage::Replay(page) => { self.revalidate(&execution).await?; return Ok(response(request, page)); }, SpatialNextPage::State(state) => Some(state.state) }
+        } else { None };
+        let result = self.build_and_publish(&execution, &source, &binding, size, state, token).await;
+        if result.is_err() { if let Some(token) = token { let _ = execution.runtime.results.fail_spatial_next(token, &binding); } } result
+    }
+    async fn build_and_publish(&self, execution: &PreparedExecution, source: &LayerSource, binding: &CursorBinding, size: usize, state: Option<Value>, consumed_token: Option<&str>) -> ServiceResult<ServiceResponse> {
+        let hash = paging::request_hash(source, size, execution.request.operation)?;
+        let reservation = execution.runtime.results.reserve_query(&execution.connection.id, execution.deadline_at_ms.saturating_sub(now_ms()))?;
+        let mut built = match source { LayerSource::QueryResult { .. } => query_result::build(self, execution, source, binding, size, state.as_ref().map(paging::decode).transpose()?).await?, LayerSource::Table { .. } => table_query::build(self, execution, source, size, state.as_ref().map(paging::decode).transpose()?).await? };
+        self.revalidate(execution).await?;
+        if let Some(id) = &built.original_result_id { execution.runtime.results.snapshot(id, binding)?; }
+        self.guard(execution)?;
+        let mut publication = Publication::new(&execution.runtime.results, binding);
+        let result_id = publication.cache(paging::snapshot_page(&built.page, source, binding, &built.raw_rows)?, &reservation)?;
+        if let Some(state) = built.state { let token = publication.token(paging::cursor_state(binding, state, size), built.original_result_id.as_deref(), &hash)?; built.page.page.next_token = Some(token); }
+        let page = paging::stored_page(built.page, result_id)?;
+        let page = if let Some(token) = consumed_token { execution.runtime.results.finish_spatial_next(token, binding, page)? } else { page };
+        self.guard(execution)?;
+        if let Some(id) = &built.original_result_id { execution.runtime.results.snapshot(id, binding)?; }
+        publication.commit(); Ok(response(&execution.request, page))
+    }
+}
+#[async_trait]
+impl OperationExtension for SpatialDataDomain {
+    fn operations(&self) -> &[Operation] { OPERATIONS }
+    async fn execute(&self, request: &ServiceRequest, caller: &CallerContext, lease: &JobLease) -> ServiceResult<ServiceResponse> {
+        match request.operation {
+            Operation::SpatialQueryResult | Operation::SpatialTableQuery => self.query(request, caller, lease).await,
+            Operation::SpatialColumns => { let execution = self.prepare(request, caller, lease, None).await?; let raw = self.rpc(&execution, ServiceRpcMethod::SpatialColumns, json!({"table":request.input["table"]})).await?; let data = normalize_columns(raw)?; self.revalidate(&execution).await?; Ok(success(request, data)) },
+            Operation::SpatialFeature => feature::execute(self, request, caller, lease).await,
+            _ => Err(failure(ErrorCode::UnsupportedOperation)),
+        }
+    }
+}
+pub fn authorize_binding(binding: &CursorBinding, connection: &SavedConnection, permission: &PermissionScope) -> ServiceResult<()> { if binding.connection_id != connection.id || binding.auth_revision != connection.auth_revision { return Err(failure(ErrorCode::AuthRequired)); }
+    if binding.permission_scope != permission.identity { return Err(failure(ErrorCode::PermissionDenied)); } Ok(()) }
+pub(super) async fn prepare_feature(domain: &SpatialDataDomain, request: &ServiceRequest, caller: &CallerContext, lease: &JobLease, source: Option<&LayerSource>) -> ServiceResult<PreparedExecution> { domain.prepare(request, caller, lease, source).await }
+fn normalize_columns(mut value: Value) -> ServiceResult<Value> {
+    if serde_json::to_vec(&value).map_err(|_| failure(ErrorCode::ResourceLimit))?.len() > paging::PUBLIC_PAGE_BYTES { return Err(failure(ErrorCode::ResourceLimit)); }
+    let columns = value["columns"].as_array_mut().ok_or_else(|| failure(ErrorCode::InvalidArgument))?;
+    for column in columns { let object = column.as_object_mut().ok_or_else(|| failure(ErrorCode::InvalidArgument))?; if let Some(name) = object.remove("column") { if !name.is_string() || object.get("name").is_some_and(|existing| *existing != name) { return Err(failure(ErrorCode::InvalidArgument)); } object.insert("name".into(), name); }
+        if !object.get("name").is_some_and(Value::is_string) || !object.get("column_index").is_some_and(|index| index.as_u64().is_some()) || !matches!(object.get("native_type").and_then(Value::as_str), Some("geometry" | "geography")) { return Err(failure(ErrorCode::InvalidArgument)); } }
+    Ok(value)
+}
+pub fn success(request: &ServiceRequest, data: Value) -> ServiceResponse { ServiceResponse { protocol_version: 1, request_id: request.request_id.clone(), connection_id: request.connection_id.clone(), status: JobStatus::Succeeded, job_id: None, result_id: None, data, page: Page::default(), limits: Limits::default(), metrics: Metrics::default(), warnings: vec![], error: None } }
+fn response(request: &ServiceRequest, page: StoredPage) -> ServiceResponse { ServiceResponse { result_id: page.result_id, data: page.data, page: page.page, limits: page.limits, metrics: page.metrics, warnings: page.warnings, ..success(request, Value::Null) } }
