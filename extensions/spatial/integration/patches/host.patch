+        let input = match method {
+            ServiceRpcMethod::ExactQuery => json!({"text":request.input["text"],"parameters":request.input["parameters"],"max_rows":10000,"max_bytes":16*1024*1024-64*1024}),
+            ServiceRpcMethod::Catalog | ServiceRpcMethod::Row => { let mut input = request.input.clone(); input["operation"] = serde_json::to_value(request.operation).map_err(|_| failure(ErrorCode::InvalidArgument))?; input },
