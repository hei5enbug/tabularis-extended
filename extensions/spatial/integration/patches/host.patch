+
+fn bounded_rows(rows: &[Value], offset: usize, limit: usize, budget: usize) -> ServiceResult<(Vec<Value>, usize)> {
+    if limit == 0 || offset > rows.len() { return Err(failure(ErrorCode::InvalidArgument)); }
+    let mut page = Vec::new(); let mut bytes = 0usize;
+    for row in rows.iter().skip(offset).take(limit) {
+        let size = serde_json::to_vec(row).map_err(|_| failure(ErrorCode::ResourceLimit))?.len() + 1;
+        if bytes.saturating_add(size) > budget {
+            if page.is_empty() { return Err(failure(ErrorCode::DocumentTooLarge)); }
+            break;
+        }
+        bytes += size; page.push(row.clone());
+    }
+    let next = offset + page.len();
+    Ok((page, next))
+}
