+            { let mut state = self.state.lock().map_err(|_| failure(ErrorCode::AuthRequired))?;
+              *state.generations.entry(connection.clone()).or_default() += 1;
+              state.grants.retain(|config,_| config.connection_id != connection);
+              for job in state.jobs.values_mut().filter(|job| job.connection_id == connection) { job.signal.cancel(); job.state = "cancelled".into(); job.challenge = None; }
+            }
+            for slot in [SecretSlot::EntraRefreshToken, SecretSlot::EntraClientSecret, SecretSlot::CosmosAccountKey, SecretSlot::DbPassword] { self.session.delete(&connection,slot).await?; }
+        }
+        Ok(())
+    }
+}
