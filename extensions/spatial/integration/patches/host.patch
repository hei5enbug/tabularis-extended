+    }
+    pub fn persistent_store(&self) -> &Arc<dyn SecretStore> { &self.persistent }
+    pub fn session_store(&self) -> &Arc<dyn SecretStore> { &self.session }
+    pub async fn import_refresh(&self, connection: &SavedConnection, refresh: Secret, persistence: super::credentials::SecretPersistence, deadline_ms: u64) -> ServiceResult<()> {
