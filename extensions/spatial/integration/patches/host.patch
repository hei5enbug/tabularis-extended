+use super::*;
+use std::{io::BufRead, sync::atomic::{AtomicU64, Ordering}, time::{Duration, Instant}};
+
+struct Temporary(PathBuf);
+impl Temporary {
+    fn new() -> Self {
+        #[cfg(unix)] let parent = PathBuf::from("/private/tmp");
+        #[cfg(not(unix))] let parent = std::env::temp_dir();
+        let root = parent.join(format!("tabularis-h3c1-{}", uuid::Uuid::new_v4()));
+        fs::create_dir(&root).unwrap();
+        #[cfg(unix)] { use std::os::unix::fs::PermissionsExt; fs::set_permissions(&root, fs::Permissions::from_mode(0o700)).unwrap(); }
+        #[cfg(windows)] { super::super::storage::protect_windows_path(&root, true).unwrap(); }
+        Self(root)
+    }
+    fn output(&self) -> PathBuf { self.0.join("저장한 지도.geojson") }
+}
+impl Drop for Temporary { fn drop(&mut self) { let _ = fs::remove_dir_all(&self.0); } }
+
+fn binding() -> ArtifactBinding {
+    ArtifactBinding { caller_id: "caller-one".into(), driver_id: "postgresql".into(), cursor: CursorBinding {
+        connection_id: "connection-one".into(), permission_scope: "read-only".into(), auth_revision: "auth-one".into(), query_hash: "query-one".into(), result_revision: "result-one".into(),
+        sdk_version: Some("sdk-one".into()), container_rid: Some("container-one".into()), endpoint_identity: Some("endpoint-one".into()), partition_hash: Some("partition-one".into()),
+    } }
+}
+struct Fixture { root: Temporary, store: Arc<ArtifactStore>, now: Arc<AtomicU64> }
+impl Fixture {
+    fn new(limits: ArtifactLimits) -> Self {
+        let root = Temporary::new();
+        let now = Arc::new(AtomicU64::new(1000));
+        let clock = now.clone();
+        let store = ArtifactStore::construct(root.0.join("artifacts"), limits, Arc::new(move || clock.load(Ordering::SeqCst))).unwrap();
+        Self { root, store, now }
+    }
+    fn deadline(&self) -> u64 { self.now.load(Ordering::SeqCst) + 1000 }
+    fn publish(&self, bytes: &[u8]) -> ArtifactMetadata {
+        let mut writer = self.store.reserve(binding(), "지도.geojson".into(), bytes.len().max(1) as u64, self.deadline()).unwrap();
+        for chunk in bytes.chunks(17_003) { writer.append(chunk).unwrap(); }
+        writer.finish(7, 19, true, vec!["upstream_limit".into()]).unwrap()
+    }
+    fn pending_files(&self) -> usize { fs::read_dir(&self.root.0).unwrap().filter_map(Result::ok).filter(|entry| entry.file_name().to_string_lossy().starts_with(".tabularis-artifact-")).count() }
+}
+fn code<T>(result: ServiceResult<T>) -> Option<ErrorCode> { result.err().map(|error| error.code) }
+fn roundtrip(fixture: &Fixture, bytes: &[u8]) -> (ArtifactMetadata, Vec<u8>, usize, usize) {
+    let metadata = fixture.publish(bytes);
+    let mut result = Vec::new();
+    let mut largest = 0;
+    let mut offset = 0;
+    loop {
+        let chunk = fixture.store.read_chunk(&metadata.artifact_id, &binding(), offset, MAX_CHUNK_BYTES).unwrap();
+        largest = largest.max(serde_json::to_vec(&chunk).unwrap().len());
+        let data = STANDARD.decode(&chunk.bytes_base64).unwrap();
+        offset += data.len() as u64;
+        result.extend(data);
+        if chunk.eof { break; }
+    }
+    let mut guards = 0;
+    fixture.store.copy_to_new(&metadata.artifact_id, &binding(), &fixture.root.output(), &CancellationSignal::default(), fixture.deadline(), || { guards += 1; Ok(()) }).unwrap();
+    (metadata, result, largest, guards)
+}
+
+#[test]
+fn 여러_chunk로_쓴_artifact는_원본_bytes와_sha를_읽고_새_파일로_복사한다() {
+    // given
+    let fixture = Fixture::new(ArtifactLimits::default());
+    let bytes = "한글 지도와 데이터 ".repeat(8000).into_bytes();
+    // when
+    let actual = roundtrip(&fixture, &bytes);
+    // then
+    assert_eq!(actual.0.bytes, bytes.len() as u64);
+    assert_eq!(actual.0.checksum, format!("{:x}", Sha256::digest(&bytes)));
+    assert_eq!(actual.1, bytes);
+    assert_eq!(fs::read(fixture.root.output()).unwrap(), bytes);
+    assert!(actual.2 <= 100 * 1024);
