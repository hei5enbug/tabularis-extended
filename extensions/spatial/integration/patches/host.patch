+
+const succeeded = (request: ServiceRequest): ServiceResponse => ({ protocol_version: 1, request_id: request.request_id, connection_id: request.connection_id ?? null, status: "succeeded", job_id: null, result_id: "result-notebook", data: { kind: "tabular", columns: [{ name: "value", column_index: 0 }], rows: [[1]], offset: 0, result_set_index: 0, result_set_count: 1, result_revision: "rev-1", affected_rows: null }, page: { has_more: false, next_token: null, resume_mode: "materialized" }, limits: { truncated: false, reasons: [] }, metrics: { elapsed_ms: 0, request_charge: null, retry_count: 0 }, warnings: [], error: null });
+const tab = (session = true): Tab => ({ id: "tab-notebook", type: "notebook", notebookId: "fixture-notebook", title: "Fixture", connectionId: "conn-notebook", query: "", result: null, error: "", executionTime: null, page: 1, activeTable: null, pkColumns: null, ...(session ? { serviceSession: { sessionId: "native-session", mode: "read_only", connectionId: "conn-notebook" } } : {}) });
+const runAll = async () => { await act(async () => { fireEvent.click(screen.getByRole("button", { name: "Run All" })); }); };
