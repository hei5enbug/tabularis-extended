+  state.call.mockReset().mockImplementation(async (request: ServiceRequest) => (request.input as { text: string }).text === "SELECT failed" ? { ...succeeded(request), status: "outcome_unknown", error: { code: "OUTCOME_UNKNOWN", message: "Unknown.", retryable: false, outcome: "unknown", details: null } } : succeeded(request));
