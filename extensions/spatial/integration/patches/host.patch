+    files: usize,
+    expanded_bytes: u64,
+    kind: extensions::PackageKind,
+    assets: Vec<String>,
+    manifest: Value,
+}
+
+fn hash(bytes: &[u8]) -> String { format!("{:x}", Sha256::digest(bytes)) }
+
+fn fixture_path(name: &str) -> Result<PathBuf, String> {
+    let path = PathBuf::from(std::env::var_os(name).ok_or("Production ZIP path is required")?);
+    if !path.is_absolute() || !std::fs::symlink_metadata(&path).map_err(|_| "Production ZIP is unavailable")?.is_file() {
+        return Err("Production ZIP must be an absolute regular file".into());
+    }
+    Ok(path)
+}
+
+fn archive_files(bytes: &[u8]) -> Result<BTreeMap<String, Vec<u8>>, String> {
+    let mut archive = zip::ZipArchive::new(Cursor::new(bytes)).map_err(|_| "Production ZIP is invalid")?;
+    if archive.len() > 50_000 { return Err("Production ZIP file limit exceeded".into()); }
+    let mut files = BTreeMap::new();
+    let mut total = 0_u64;
+    for index in 0..archive.len() {
+        let mut entry = archive.by_index(index).map_err(|_| "Production ZIP entry is invalid")?;
+        if !entry.is_file() || entry.enclosed_name().is_none() || entry.unix_mode().is_some_and(|mode| mode & 0o170000 != 0o100000) || entry.size() > 256 * 1024 * 1024 {
+            return Err("Production ZIP requires bounded regular files".into());
+        }
+        total = total.checked_add(entry.size()).ok_or("Production ZIP size overflow")?;
+        if total > 512 * 1024 * 1024 { return Err("Production ZIP expanded limit exceeded".into()); }
+        let name = entry.name().to_owned();
+        let expected = entry.size();
+        let mut content = Vec::new();
+        entry.read_to_end(&mut content).map_err(|_| "Production ZIP entry cannot be read")?;
+        if content.len() as u64 != expected || files.insert(name, content).is_some() { return Err("Production ZIP entry differs".into()); }
+    }
+    Ok(files)
+}
+
+fn verify_install(bytes: &[u8], installed: &Path, id: &str) -> Result<ArchiveEvidence, String> {
+    let files = archive_files(bytes)?;
+    let release: Value = serde_json::from_slice(files.get("release.json").ok_or("Release ledger is missing")?).map_err(|_| "Release ledger is invalid")?;
+    let ledger = release["files"].as_array().ok_or("Release ledger files are missing")?;
+    let mut declared = HashSet::new();
+    for record in ledger {
+        let relative = record["path"].as_str().ok_or("Release ledger path is invalid")?;
+        let content = files.get(relative).ok_or("Release ledger file is missing")?;
+        if !declared.insert(relative) || record["bytes"].as_u64() != Some(content.len() as u64) || record["sha256"].as_str() != Some(hash(content).as_str()) {
+            return Err("Release ledger hash or size differs".into());
+        }
+    }
+    if declared.len() + 1 != files.len() || declared.contains("release.json") { return Err("Release ledger does not cover the archive".into()); }
+    for (relative, expected) in &files {
+        let path = installed.join(relative);
+        let stat = std::fs::symlink_metadata(&path).map_err(|_| "Installed file is missing")?;
+        if !stat.is_file() || stat.len() != expected.len() as u64 || hash(&std::fs::read(path).map_err(|_| "Installed file cannot be read")?) != hash(expected) {
+            return Err("Native installation differs from production ZIP".into());
+        }
+    }
+    let (kind, manifest) = extensions::read_package(installed)?;
+    if manifest["id"] != id || manifest["version"] != "0.1.0" || !matches!(manifest["min_runtime_version"].as_str(), Some("0.26.0") | Some(HOST_VERSION)) { return Err("Installed manifest differs".into()); }
+    let assets = ["ui/dist/index.js", "ui/dist/style.css", "ui/dist/maplibre-worker.js"].into_iter()
+        .filter(|name| files.contains_key(*name)).map(str::to_owned).collect();
+    Ok(ArchiveEvidence {
+        id: id.into(), sha256: hash(bytes), zip_bytes: bytes.len(), files: files.len(),
+        expanded_bytes: files.values().map(|content| content.len() as u64).sum(), kind, assets, manifest,
+    })
+}
+
+async fn bounded_output<R: AsyncRead + Unpin>(reader: R) -> Result<Vec<u8>, String> {
+    let mut output = Vec::new();
+    reader.take(OUTPUT_LIMIT + 1).read_to_end(&mut output).await.map_err(|_| "Child output read failed")?;
+    if output.len() as u64 > OUTPUT_LIMIT { return Err("Child output limit exceeded".into()); }
+    Ok(output)
+}
+
+#[derive(Debug)]
+struct ChildEvidence { success: bool, stdout: Vec<u8>, stderr: Vec<u8> }
+
+async fn child(executable: &Path, args: &[&str], installed: &Path, profile: &Path, input: &[u8], poison: bool) -> Result<ChildEvidence, String> {
+    let mut command = tokio::process::Command::new(executable);
+    command.args(args).current_dir(installed).env_clear().env("PATH", "")
+        .env("HOME", profile).env("USERPROFILE", profile).env("TMPDIR", profile)
+        .stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped()).kill_on_drop(true);
+    if poison {
+        for key in POISONING_KEYS {
+            command.env(key, if key == "NODE_TLS_REJECT_UNAUTHORIZED" { "0" } else { "native-package-poison-canary" });
+        }
+    }
+    let mut process = command.spawn().map_err(|_| "Installed executable could not start")?;
+    let stdout = tokio::spawn(bounded_output(process.stdout.take().ok_or("Child stdout is missing")?));
+    let stderr = tokio::spawn(bounded_output(process.stderr.take().ok_or("Child stderr is missing")?));
+    if let Some(mut stdin) = process.stdin.take() {
+        stdin.write_all(input).await.map_err(|_| "Child stdin write failed")?;
+    }
+    let status = match tokio::time::timeout(Duration::from_secs(60), process.wait()).await {
+        Ok(status) => status.map_err(|_| "Child exit could not be observed")?,
+        Err(_) => {
+            let _ = process.start_kill();
+            let _ = tokio::time::timeout(Duration::from_secs(5), process.wait()).await;
+            stdout.abort(); stderr.abort();
+            return Err("Installed executable timed out".into());
+        }
+    };
+    let stdout = tokio::time::timeout(Duration::from_secs(5), stdout).await.map_err(|_| "Child stdout did not close")?.map_err(|_| "Child stdout task failed")??;
+    let stderr = tokio::time::timeout(Duration::from_secs(5), stderr).await.map_err(|_| "Child stderr did not close")?.map_err(|_| "Child stderr task failed")??;
+    Ok(ChildEvidence { success: status.success(), stdout, stderr })
+}
+
+fn protocol(input_shutdown: bool) -> Vec<u8> {
+    let mut requests = vec![json!({"jsonrpc":"2.0","id":"initialize","method":"initialize","params":{"settings":{},"service_protocol":1}})];
+    if input_shutdown { requests.push(json!({"jsonrpc":"2.0","id":"shutdown","method":"shutdown","params":{}})); }
+    requests.into_iter().map(|request| format!("{request}\n")).collect::<String>().into_bytes()
+}
+
+fn parse_protocol(actual: &ChildEvidence, shutdown: bool) -> Result<Value, String> {
+    if !actual.success || !actual.stderr.is_empty() || actual.stdout.last() != Some(&b'\n') { return Err("Native protocol process did not exit cleanly".into()); }
+    let text = std::str::from_utf8(&actual.stdout).map_err(|_| "Native stdout is not UTF-8")?;
+    if text.contains("native-package-poison-canary") { return Err("Native output contains a poisoning canary".into()); }
+    let responses = text.lines().map(serde_json::from_str::<Value>).collect::<Result<Vec<_>, _>>().map_err(|_| "Native stdout is not JSON only")?;
+    if responses.len() != if shutdown { 2 } else { 1 } { return Err("Native response count differs".into()); }
+    let initialized = responses.iter().find(|response| response["id"] == "initialize").ok_or("Initialize response is missing")?;
+    if initialized["jsonrpc"] != "2.0" || initialized.get("error").is_some() { return Err("Initialize response failed".into()); }
+    if shutdown && !responses.iter().any(|response| response["id"] == "shutdown" && response["result"].is_null() && response.get("error").is_none()) { return Err("Shutdown response failed".into()); }
+    Ok(initialized["result"]["service_capabilities"].clone())
+}
+
+#[derive(Debug)]
+struct CosmosEvidence { arch: String, version: String, identity: Value, eof: Value, shutdown: Value }
+#[derive(Debug)]
+struct NativeEvidence { archives: Vec<ArchiveEvidence>, cosmos: Vec<CosmosEvidence>, spatial_ui_only: bool }
