+use serde_json::{json, Value};
+#[derive(Clone, Debug)]
+pub struct ServiceError { pub code: &'static str, pub message: &'static str, pub unknown: bool, pub session_closed: bool }
+impl ServiceError {
+    pub fn new(code: &'static str, message: &'static str) -> Self { Self { code, message, unknown: false, session_closed: false } }
+    pub fn argument(message: &'static str) -> Self { Self::new("INVALID_ARGUMENT", message) }
+    pub fn database(error: mssql_tds::error::Error) -> Self {
+        match error {
+            mssql_tds::error::Error::SqlServerError { errors, .. } if errors.iter().any(|error| matches!(error.number, 229 | 230 | 262 | 297 | 15151)) => Self::new("WRITE_NOT_ALLOWED", "SQL Server denied the requested database permission"),
+            mssql_tds::error::Error::OperationCancelledError(_) => Self::new("CANCELLED", "SQL Server execution was cancelled"),
+            mssql_tds::error::Error::TimeoutError(_) => Self::new("DEADLINE_EXCEEDED", "SQL Server execution exceeded its deadline"),
+            _ => Self::new("DRIVER_EXITED", "SQL Server execution failed"),
+        }
+    }
+    pub fn response(self, id: Value) -> Value {
+        json!({"jsonrpc":"2.0","id":id,"error":{"code":-32000,"message":self.message,"data":{"code":self.code,"message":self.message,"retryable":false,"outcome":if self.unknown {"unknown"} else {"not_applied"},"details":if self.session_closed {json!({"session_closed":true})} else {Value::Null}}}})
+    }
+}
diff --git a/src/driver/service/pool.rs b/src/driver/service/pool.rs
new file mode 100644
index 0000000000000000000000000000000000000000..55a15c6703baf46a8216e7210e1de026256b0085
--- /dev/null
+++ b/src/driver/service/pool.rs
@@ -0,0 +1,136 @@
+use deadpool::managed::{Manager, Metrics, Pool, RecycleError, RecycleResult};
+use mssql_tds::{connection::tds_client::TdsClient, connection_provider::tds_connection_provider::TdsConnectionProvider};
+use mssql_tiberius_bridge::{Config, AuthMethod, EncryptionLevel};
+use sha2::{Digest, Sha256};
+use serde_json::{json, Value};
+use crate::{models::ConnectionParams, settings::PluginSettings};
+use super::{registry::Scope, types::{DriverContext, TransientAuth}, readonly, exact, ServiceError};
+
+pub type NativePool = Pool<ServiceManager>;
+pub type NativeConnection = deadpool::managed::Object<ServiceManager>;
+pub struct Login { pub context: DriverContext, pub deadline: tokio::time::Instant, pub cancel: mssql_tds::core::CancelHandle, pub state: std::sync::Arc<super::registry::State> }
+tokio::task_local! { static LOGIN: Login; }
+use crate::pool_manager::SERVICE_POOLS as POOLS;
+pub struct ServiceManager { params: ConnectionParams, settings: PluginSettings, read_only: bool }
+fn digest(value: &Value) -> String { format!("{:x}", Sha256::digest(serde_json::to_vec(value).unwrap())) }
+pub fn fingerprint(params: &ConnectionParams, context: &DriverContext) -> String {
+    fingerprint_with_settings(params, context, &crate::settings::current())
+}
+fn fingerprint_with_settings(params: &ConnectionParams, context: &DriverContext, process: &PluginSettings) -> String {
+    let mut params = params.clone();
+    params.password = None;
+    params.connection_string = None;
+    params.connection_id = None;
+    let mut settings = serde_json::to_value(params).unwrap();
+    let script = settings["startup_script"].take();
+    settings["startup_script"] = json!(digest(&script));
+    digest(&json!({"connection_id":context.connection_id,"settings":settings,"identity":context.identity(),"read_only":context.read_only,
+        "process":{"pool":process.max_pool_size,"connect":process.connect_timeout_seconds,"query":process.query_timeout_seconds,"application":process.application_name,"trust":process.trust_server_certificate}}))
+}
+pub fn config(params: &ConnectionParams, settings: &PluginSettings, context: &DriverContext, remaining: u64) -> Result<Config, ServiceError> {
+    context.validate_auth(params, remaining)?;
+    if crate::connection::is_azure_sql(params) && settings.trust_server_certificate { return Err(ServiceError::argument("Azure SQL requires verified TLS")); }
+    let mut cfg = Config::new();
+    cfg.host(params.host.as_deref().unwrap_or("localhost")).port(params.port.unwrap_or(1433)).database(params.database.primary()).application_name(&settings.application_name);
+    match &context.auth {
+        Some(TransientAuth::DbPassword { password, .. }) => { cfg.authentication(AuthMethod::sql_server(params.username.as_deref().unwrap_or(""), password)); }
+        Some(TransientAuth::EntraToken { access_token, .. }) => { cfg.authentication(AuthMethod::aad_token(access_token)); }
+        None => { cfg.authentication(AuthMethod::Integrated); }
+    }
+    match params.ssl_mode.as_deref() {
+        Some("verify-full") => { cfg.encryption(EncryptionLevel::Required); }
+        Some("disable") => { cfg.encryption(EncryptionLevel::NotSupported); }
+        Some("require") => { cfg.encryption(EncryptionLevel::Required).trust_cert(); }
+        Some("verify-ca") => return Err(ServiceError::argument("SQL Server requires verify-full for certificate verification")),
+        _ => { cfg.encryption(EncryptionLevel::On).trust_cert(); }
+    }
+    if settings.trust_server_certificate { cfg.trust_cert(); }
+    if [&params.ssl_ca, &params.ssl_cert, &params.ssl_key].iter().any(|value| value.as_ref().is_some_and(|v| !v.is_empty())) { return Err(ServiceError::argument("Custom TLS credential files are unsupported")); }
+    Ok(cfg)
+}
+impl Manager for ServiceManager {
+    type Type = TdsClient;
+    type Error = ServiceError;
+    async fn create(&self) -> Result<Self::Type, Self::Error> {
+        let (context, deadline, cancel) = LOGIN.try_with(|login| (login.context.clone(), login.deadline, login.cancel.child_handle())).map_err(|_| ServiceError::new("AUTH_REQUIRED", "A physical login requires the current request context"))?;
+        let remaining = deadline.saturating_duration_since(tokio::time::Instant::now()).as_millis() as u64;
+        if remaining == 0 { return Err(ServiceError::new("DEADLINE_EXCEEDED", "The physical login deadline was exceeded")); }
+        let cfg = config(&self.params, &self.settings, &context, remaining)?;
+        let mut login = cfg.to_client_context();
+        login.connect_retry_count = 0;
+        login.connect_timeout = self.settings.connect_timeout_seconds;
+        let mut client = TdsConnectionProvider.create_client(login, &cfg.datasource_string(), Some(&cancel)).await.map_err(|_| ServiceError::new("AUTH_REQUIRED", "SQL Server physical login failed"))?;
+        if self.read_only { readonly::probe(&mut client, Some(&cancel)).await?; }
+        if let Some(script) = self.params.startup_script.as_deref().filter(|v| !v.trim().is_empty()) {
+            if !self.read_only { LOGIN.with(|login| login.state.mark_write()); }
+            exact::collect(&mut client, script, Vec::new(), Some(&cancel), 10_000, super::types::FRAME_LIMIT, false).await?;
+        }
+        Ok(client)
+    }
+    async fn recycle(&self, _: &mut Self::Type, _: &Metrics) -> RecycleResult<Self::Error> {
+        Err(RecycleError::message("Native connections require a fresh login because a safe reset API is unavailable"))
+    }
+}
+pub async fn acquire(params: &ConnectionParams, context: &DriverContext, scope: &Scope) -> Result<NativeConnection, ServiceError> {
+    let key = fingerprint(params, context);
+    let pool = {
+        let mut pools = POOLS.write().await;
+        if let Some((_, pool)) = pools.get(&key) { pool.clone() }
+        else {
+            let mut sanitized = params.clone();
+            sanitized.password = None; sanitized.connection_string = None;
+            let settings = crate::settings::current();
+            let pool = Pool::builder(ServiceManager { params: sanitized, settings: settings.clone(), read_only: context.read_only }).max_size(settings.max_pool_size.min(4)).build().map_err(|_| ServiceError::new("RESOURCE_LIMIT", "Cannot create a service connection pool"))?;
+            pools.insert(key, (context.connection_id.clone(), pool.clone())); pool
+        }
+    };
+    let remaining = scope.remaining()?;
+    context.validate_auth(params, remaining)?;
+    let login = Login { context: context.clone(), deadline: scope.state.deadline, cancel: scope.cancel_handle(), state: scope.state.clone() };
+    LOGIN.scope(login, pool.get()).await.map_err(|error| match error {
+        deadpool::managed::PoolError::Backend(error) => error,
+        _ => ServiceError::new("CONNECTION_NOT_FOUND", "Cannot acquire a service connection"),
+    })
+}
+pub async fn invalidate(connection: &str) {
+    let mut pools = POOLS.write().await;
+    pools.retain(|_, (id, pool)| { if id == connection { pool.close(); false } else { true } });
+}
+pub async fn shutdown() { for (_, pool) in POOLS.write().await.drain().map(|(_, value)| value) { pool.close(); } }
+pub async fn cleanup() { POOLS.write().await.retain(|_, (_, pool)| { let status = pool.status(); if status.size == status.available { pool.close(); false } else { true } }); }
+pub fn discard(connection: NativeConnection) { drop(deadpool::managed::Object::take(connection)); }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::driver::service::types;
+    #[test]
+    fn 계정과_설정과_startup_script를_바꾸면_별도_pool을_선택한다() {
+        // given
+        let mut params = ConnectionParams { host: Some("localhost".into()), username: Some("user".into()), database: crate::models::DatabaseSelection::Single("fixture".into()), ..Default::default() };
+        let context: DriverContext = serde_json::from_value(json!({"protocol_version":1,"connection_id":"fixture","request_id":"request","deadline_ms":1000,"read_only":false,"auth":{"kind":"db_password","password":"synthetic-key","identity":"principal"}})).unwrap();
+        let settings = PluginSettings::default();
+        let original = fingerprint_with_settings(&params, &context, &settings);
+        params.startup_script = Some("SET ANSI_NULLS ON".into());
+        // when
+        let actual = fingerprint_with_settings(&params, &context, &settings);
+        // then
+        assert_ne!(actual, original);
+        assert_eq!(actual.len(), 64);
+        assert!(!actual.contains("SET"));
+    }
+    #[test]
+    fn 같은_주체의_token_refresh는_pool에_token을_남기지_않고_binding을_유지한다() {
+        // given
+        let params = ConnectionParams::default();
+        let mut context: DriverContext = serde_json::from_value(json!({"protocol_version":1,"connection_id":"fixture","request_id":"request","auth":{"kind":"entra_token","access_token":"synthetic-old","expires_at_ms":types::unix_ms()+1_000_000,"identity":"principal","tenant_id":"tenant","client_id":"client","principal_id":"principal","scope":types::SQL_SCOPE}})).unwrap();
+        let settings = PluginSettings::default();
+        let original = fingerprint_with_settings(&params, &context, &settings);
+        if let Some(TransientAuth::EntraToken { access_token, expires_at_ms, .. }) = &mut context.auth { *access_token = "synthetic-new".into(); *expires_at_ms += 1000; }
+        // when
+        let actual = fingerprint_with_settings(&params, &context, &settings);
+        // then
+        assert_eq!(actual, original);
+        assert!(!actual.contains("synthetic"));
+    }
+}
diff --git a/src/driver/service/readonly.rs b/src/driver/service/readonly.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d6840e0c4049694a5c3c592f076a03e9bcc6b828
--- /dev/null
+++ b/src/driver/service/readonly.rs
@@ -0,0 +1,113 @@
+use mssql_tds::{connection::tds_client::TdsClient, core::CancelHandle};
+use serde_json::{json, Value};
+use super::{exact::{self, Parameter}, ServiceError};
+
+const DATABASE_PROBE: &str = r#"
+SELECT 'principal', CAST(CASE WHEN USER_NAME()='dbo' OR SUSER_SNAME()<>ORIGINAL_LOGIN() THEN 1 ELSE 0 END AS nvarchar(128));
+SELECT 'role', p.name FROM sys.user_token t JOIN sys.database_principals p ON t.principal_id=p.principal_id WHERE p.type='R' AND p.name NOT IN ('public','db_datareader','db_denydatawriter');
+SELECT 'permission', permission_name FROM sys.fn_my_permissions(NULL,'DATABASE');
+SELECT 'permission', p.permission_name FROM sys.schemas s CROSS APPLY sys.fn_my_permissions(QUOTENAME(s.name),'SCHEMA') p WHERE s.name NOT IN ('sys','INFORMATION_SCHEMA') AND s.schema_id<16384;
+SELECT 'permission', p.permission_name FROM sys.objects o JOIN sys.schemas s ON o.schema_id=s.schema_id CROSS APPLY sys.fn_my_permissions(QUOTENAME(s.name)+'.'+QUOTENAME(o.name),'OBJECT') p WHERE o.is_ms_shipped=0;
+SELECT 'grant', permission_name FROM sys.database_permissions WHERE grantee_principal_id IN (SELECT principal_id FROM sys.user_token) AND state IN ('G','W') AND (class<>1 OR OBJECTPROPERTY(major_id,'IsMSShipped')=0);
+SELECT 'ownership', name FROM sys.database_principals WHERE owning_principal_id IN (SELECT principal_id FROM sys.user_token) AND principal_id<>USER_ID();
+SELECT 'ownership', name FROM sys.schemas WHERE principal_id IN (SELECT principal_id FROM sys.user_token) AND schema_id<16384;
+SELECT 'ownership', name FROM sys.objects WHERE principal_id IN (SELECT principal_id FROM sys.user_token) AND is_ms_shipped=0;
+SELECT 'external', name FROM sys.external_data_sources;
+"#;
+fn allowed(permission: &str, server: bool) -> bool {
+    permission.starts_with("VIEW ") || if server { permission == "CONNECT SQL" } else { matches!(permission, "CONNECT" | "SELECT" | "SHOWPLAN" | "UNMASK") }
+}
+fn sets(value: &Value) -> impl Iterator<Item = &Value> { std::iter::once(value).chain(value["additional_results"].as_array().into_iter().flatten()) }
+fn verify_database(value: &Value) -> Result<(), ServiceError> {
+    for set in sets(value) { for row in set["rows"].as_array().into_iter().flatten() {
+        let tag = row[0].as_str().unwrap_or(""); let value = row[1].as_str().unwrap_or("");
+        let reject = match tag { "principal" => value != "0", "permission" | "grant" => !allowed(value, false), _ => true };
+        if reject { return Err(ServiceError::new("WRITE_NOT_ALLOWED", "The physical database principal cannot be proven read-only")); }
+    } }
+    Ok(())
+}
+fn verify_server(value: &Value) -> Result<(), ServiceError> {
+    let mut permissions = 0;
+    let mut database_visibility = false;
+    for set in sets(value) { for row in set["rows"].as_array().into_iter().flatten() {
+        let permitted = match row[0].as_str() {
+            Some("visibility") => {
+                if row[1].as_i64() != Some(1) { return Err(ServiceError::new("CAPABILITY_UNAVAILABLE", "The accessible database catalog cannot be verified")); }
+                database_visibility = true; true
+            }
+            Some("permission") => { permissions += 1; row[1].as_str().is_some_and(|permission| allowed(permission, true)) }
+            Some("securable") => match row[1].as_str() {
+                Some("SERVER") => row[2].as_str().is_some_and(|permission| allowed(permission, true)),
+                Some("ENDPOINT") => row[2].as_str() == Some("CONNECT") && row[3].as_i64() == Some(2),
+                _ => false,
+            },
+            _ => false,
+        };
+        if !permitted { return Err(ServiceError::new("WRITE_NOT_ALLOWED", "The server principal or configuration cannot be proven read-only")); }
+    } }
+    if permissions == 0 || !database_visibility { return Err(ServiceError::new("CAPABILITY_UNAVAILABLE", "The server permissions are unavailable")); }
+    Ok(())
+}
+pub async fn probe(client: &mut TdsClient, cancel: Option<&CancelHandle>) -> Result<(), ServiceError> {
+    let unavailable = |_| ServiceError::new("CAPABILITY_UNAVAILABLE", "Read-only database permissions could not be verified");
+    let header = exact::collect(client, "SELECT CAST(SERVERPROPERTY('EngineEdition') AS int), DB_NAME()", Vec::new(), cancel, 10_000, super::types::FRAME_LIMIT, false).await.map_err(unavailable)?;
+    let edition = header["rows"][0][0].as_i64().ok_or_else(|| ServiceError::new("CAPABILITY_UNAVAILABLE", "The SQL engine edition is unavailable"))?;
+    if edition == 5 {
+        let data = exact::collect(client, DATABASE_PROBE, Vec::new(), cancel, 10_000, super::types::FRAME_LIMIT, false).await.map_err(unavailable)?;
+        return verify_database(&data);
+    }
+    let server = exact::collect(client, "SELECT 'visibility', HAS_PERMS_BY_NAME(NULL,NULL,'VIEW ANY DATABASE'); SELECT 'permission', permission_name FROM sys.fn_my_permissions(NULL,'SERVER'); SELECT 'prohibited', name FROM sys.servers WHERE server_id>0; SELECT 'prohibited', name FROM sys.configurations WHERE name IN ('cross db ownership chaining','Ad Hoc Distributed Queries','clr enabled','xp_cmdshell','external scripts enabled','Ole Automation Procedures') AND value_in_use<>0; SELECT 'prohibited', name FROM sys.server_principals WHERE owning_principal_id IN (SELECT principal_id FROM sys.login_token); SELECT 'securable', p.class_desc, p.permission_name, COALESCE(e.type,0) FROM sys.server_permissions p LEFT JOIN sys.endpoints e ON p.class=105 AND p.major_id=e.endpoint_id WHERE p.grantee_principal_id IN (SELECT principal_id FROM sys.login_token) AND p.state IN ('G','W')", Vec::new(), cancel, 10_000, super::types::FRAME_LIMIT, false).await.map_err(unavailable)?;
+    verify_server(&server)?;
+    let databases = exact::collect(client, "SELECT name, is_db_chaining_on, is_trustworthy_on FROM sys.databases WHERE database_id>4 AND HAS_DBACCESS(name)=1", Vec::new(), cancel, 10_000, super::types::FRAME_LIMIT, false).await.map_err(unavailable)?;
+    let current = header["rows"][0][1].as_str().ok_or_else(|| ServiceError::new("CAPABILITY_UNAVAILABLE", "The current database is unavailable"))?;
+    let mut names = Vec::new();
+    for row in databases["rows"].as_array().into_iter().flatten() {
+        if row[1].as_bool() != Some(false) || row[2].as_bool() != Some(false) { return Err(ServiceError::new("WRITE_NOT_ALLOWED", "Cross-database ownership chaining or trustworthy databases are unsupported")); }
+        names.push(row[0].as_str().ok_or_else(|| ServiceError::argument("Invalid database catalog"))?.to_owned());
+    }
+    if !names.iter().any(|name| name == current) { names.push(current.to_owned()); }
+    for name in names {
+        let text = format!("EXEC {}.sys.sp_executesql @stmt=@probe", crate::driver::helpers::bracket_quote(&name));
+        let parameters = exact::bind(&[Parameter { name: "@probe".into(), value: json!(DATABASE_PROBE) }])?;
+        let data = exact::collect(client, &text, parameters, cancel, 10_000, super::types::FRAME_LIMIT, false).await.map_err(unavailable)?;
+        verify_database(&data)?;
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::verify_server;
+    use serde_json::json;
+
+    #[test]
+    fn database_목록의_가시성이_없거나_불명확하면_읽기_전용_실행을_거부한다() {
+        // given
+        let rows = [json!({"rows":[["visibility",0],["permission","CONNECT SQL"]]}), json!({"rows":[["visibility",null],["permission","CONNECT SQL"]]}), json!({"rows":[["permission","CONNECT SQL"]]})];
+        // when
+        let actual = rows.map(|rows| verify_server(&rows));
+        // then
+        assert!(actual.iter().all(|result| result.as_ref().unwrap_err().code == "CAPABILITY_UNAVAILABLE"));
+    }
+
+    macro_rules! rejects_configuration {
+        ($name:ident, $configuration:literal) => {
+            #[test]
+            fn $name() {
+                // given
+                let rows = json!({"rows":[["visibility",1],["permission","CONNECT SQL"],["prohibited",$configuration]]});
+                // when
+                let actual = verify_server(&rows);
+                // then
+                assert_eq!(actual.unwrap_err().code, "WRITE_NOT_ALLOWED");
+            }
+        };
+    }
+
+    rejects_configuration!(cross_db_ownership_chaining은_읽기_전용_실행을_거부한다, "cross db ownership chaining");
+    rejects_configuration!(ad_hoc_distributed_queries는_읽기_전용_실행을_거부한다, "Ad Hoc Distributed Queries");
