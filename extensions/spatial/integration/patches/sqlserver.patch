+        let mut reserved = fixture.exact("INSERT dbo.audit VALUES(2); SELECT id FROM dbo.items UNION ALL SELECT id FROM dbo.items", "sa", false, "write_reserved"); reserved["params"]["driver_context"]["session_handle"] = write_session["result"]["session_handle"].clone(); reserved["params"]["input"]["max_rows"] = json!(1);
