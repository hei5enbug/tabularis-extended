+                let operation = input["operation"].as_str().unwrap_or("");
+                let id = if operation=="row.insert" { input["values"]["id"].as_i64() } else { input["identity"]["values"][1].as_i64() }.unwrap_or(0) as i32;
+                if read_only { return Ok(denied("WRITE_NOT_ALLOWED",false)); }
+                if is_reader && state.mode != Mode::ReaderAllowed { return Ok(denied("OUTCOME_UNKNOWN",state.mode!=Mode::WrongPermissionError)); }
+                if operation != "row.insert" && input["identity"]["columns"] != json!(["run_id","id"]) { return Ok(denied("INVALID_ARGUMENT",false)); }
+                if operation=="row.insert" {
+                    if state.rows.contains_key(&id) { return Ok(denied("OUTCOME_UNKNOWN",false)); }
+                    if id==2 && matches!(state.mode,Mode::UnknownInsert|Mode::UnknownAppliedInsert|Mode::Timeout) {
+                        if state.mode==Mode::UnknownAppliedInsert { state.rows.insert(id,input["values"].clone()); }
+                        state.cleaning=true;
+                        if state.mode==Mode::Timeout { return Err(Error("RPC_TIMEOUT")); }
+                        return Ok(denied("OUTCOME_UNKNOWN",false));
+                    }
+                    state.rows.insert(id,input["values"].clone());
+                } else if operation=="row.update" {
+                    if let Some(row)=state.rows.get_mut(&id) { row["value"]=input["changes"]["value"].clone(); }
+                } else if operation=="row.delete" {
+                    if state.cleaning && id==1 && state.mode==Mode::CleanupFailure { return Ok(denied("OUTCOME_UNKNOWN",false)); }
+                    state.rows.remove(&id);
+                } else { return Err(Error("SYNTHETIC_UNEXPECTED_OPERATION")); }
+                Ok(ok(json!({"affected_rows":if state.mode==Mode::WrongCount {0}else{1},"truncated":false})))
+            }
+            "execute_query_exact" => {
+                let text=input["text"].as_str().unwrap_or("");
+                if text.starts_with("WAITFOR") {
+                    state.long=Some((context["connection_id"].as_str().unwrap_or("").into(),context["request_id"].as_str().unwrap_or("").into()));
+                    return Ok(denied(if state.mode==Mode::CancelQueued {"CANCELLED"}else{"OUTCOME_UNKNOWN"},false));
+                }
+                if text.contains("SERVERPROPERTY") { return Ok(ok(rows(json!(["edition","database"]),json!([[5,"synthetic_db"]])))); }
+                if text=="SELECT @@SPID" { return Ok(ok(rows(json!(["spid"]),json!([[77]])))); }
+                if text.contains("AS duplicate") {
+                    let mut value=rows(json!(["duplicate","duplicate"]),json!([[parameter("@run"),parameter("@run")]]));
+                    value["additional_results"]=json!([rows(json!(["measure","observed_at","nullable"]),json!([[fixture::DECIMAL,fixture::OBSERVED_AT,null]]))]);
+                    return Ok(ok(value));
+                }
+                if text.contains("blocked") || text.starts_with("EXEC sys.sp_executesql") { return Ok(denied("WRITE_NOT_ALLOWED",true)); }
+                if text.starts_with("SELECT CAST(@decimal") { return Ok(ok(rows(json!(["measure"]),json!([[fixture::DECIMAL]])))); }
+                if text.starts_with("SELECT id,value") {
+                    if state.mode==Mode::MissingRow { state.rows.remove(&2); state.cleaning=true; }
+                    let values=state.rows.values().map(|row|json!([row["id"],row["value"],row["measure"],row["observed_at"]])).collect::<Vec<_>>();
+                    return Ok(ok(rows(json!(["id","value","measure","observed_at"]),json!(values))));
+                }
+                if text.starts_with("SELECT run_id,id,value") {
+                    let id=parameter("@id").as_i64().unwrap_or(0) as i32;
+                    let values=state.rows.get(&id).map(|row|json!([if state.cleaning && state.mode==Mode::CleanupForeign && id==1 {json!("foreign-run-private-canary")}else{row["run_id"].clone()},row["id"],row["value"]])).into_iter().collect::<Vec<_>>();
+                    return Ok(ok(rows(json!(["run_id","id","value"]),json!(values))));
+                }
+                Err(Error("SYNTHETIC_UNEXPECTED_SQL"))
+            }
+            "service_session_open" => Ok(ok(json!({"session_handle":"synthetic-session","in_transaction":true,"rollback_confirmed":false}))),
+            "service_session_finish" => Ok(ok(json!({"session_handle":"synthetic-session","in_transaction":false,"rollback_confirmed":true}))),
+            "service_invalidate_auth" => Ok(ok(json!({"invalidated":true}))),
+            "cancel_request" => {
+                let targeted=state.long.as_ref().is_some_and(|(conn,id)| request["params"]["connection_id"]==*conn && request["params"]["request_id"]==*id);
+                state.cancelled=targeted;
+                Ok(ok(json!({"cancellation_requested":targeted})))
+            }
+            _ => Err(Error("SYNTHETIC_UNEXPECTED_OPERATION")),
+        }
+    }
+}
+impl Rpc for Fake {
+    fn send(&mut self, request: Value) -> Result<()> {
+        let id=request["id"].as_str().ok_or(Error("SYNTHETIC_INVALID_ID"))?.to_owned();
+        self.state.borrow_mut().requests.push(request.clone());
+        let response=self.respond(&request)?;
+        self.state.borrow_mut().responses.insert(id,response);
+        Ok(())
+    }
+    fn receive(&mut self, id: &str) -> Result<Response> { self.state.borrow_mut().responses.remove(id).ok_or(Error("SYNTHETIC_MISSING_RESPONSE")) }
+    fn shutdown(&mut self) -> Result<()> { let mut state=self.state.borrow_mut();state.shutdowns+=1;if state.mode==Mode::ShutdownFailure {Err(Error("SYNTHETIC_SHUTDOWN_FAILED"))}else{Ok(())} }
+    fn evidence_kind(&self) -> &'static str { "synthetic_harness" }
+}
+fn execute(mode: Mode, auth_mode: &str) -> (Report,Rc<RefCell<State>>) {
+    let config=config(auth_mode);
+    let state=Rc::new(RefCell::new(State::new(mode)));
+    let rpc_state=state.clone();
+    let report=harness::run::authorized(&config,Flags{live:true,fixture_writes:true},&mut reader(auth_mode),move |_|Ok(Box::new(Fake{state:rpc_state})));
+    (report,state)
+}
+fn has(report: &Report, name: &str, status: &str) -> bool { report.checks.iter().any(|check|check.name==name&&check.status==status) }
