+    rejects_configuration!(xp_cmdshell은_읽기_전용_실행을_거부한다, "xp_cmdshell");
+    rejects_configuration!(external_scripts_enabled는_읽기_전용_실행을_거부한다, "external scripts enabled");
+    rejects_configuration!(ole_automation_procedures는_읽기_전용_실행을_거부한다, "Ole Automation Procedures");
