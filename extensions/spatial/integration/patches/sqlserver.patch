+use super::{types::{self, DriverContext}, exact, registry, pool};
+use crate::{models::{ConnectionParams, DatabaseSelection}, settings::PluginSettings, connection::resolve_connection_params};
+use serde_json::json;
+fn entra() -> (ConnectionParams, DriverContext) {
+    let params = ConnectionParams { host: Some("synthetic.database.windows.net".into()), database: DatabaseSelection::Single("fixture".into()), auth_mode: Some("entra_user".into()), extra: [("tenant_id".into(),"tenant".into()),("client_id".into(),"client".into())].into_iter().collect(), ..Default::default() };
+    let context = serde_json::from_value(json!({"protocol_version":1,"connection_id":uuid::Uuid::new_v4().to_string(),"request_id":"request","auth":{"kind":"entra_token","access_token":"synthetic-token","expires_at_ms":types::unix_ms()+1_000_000,"identity":"principal","tenant_id":"tenant","client_id":"client","principal_id":"principal","scope":types::SQL_SCOPE}})).unwrap();
+    (params, context)
+}
+#[test]
+fn azure_sql은_database와_검증하는_tls를_강제한다() {
+    // given
+    let (params, _) = entra();
+    // when
+    let actual = resolve_connection_params(&params).unwrap();
+    // then
+    assert_eq!(actual.ssl_mode.as_deref(), Some("verify-full"));
+    assert!(!actual.integrated_auth);
+}
+#[test]
+fn azure_sql에서_미검증_tls_override를_거부한다() {
+    // given
+    let (mut params, _) = entra(); params.ssl_mode = Some("require".into());
+    // when
+    let actual = resolve_connection_params(&params);
+    // then
+    assert!(actual.is_err());
+}
+#[test]
+fn azure_hostname의_주변_공백도_tls_검사를_우회하지_못한다() {
+    // given
+    let (mut params, _) = entra(); params.host = Some(" synthetic.database.windows.net \t".into());
+    let mut insecure = params.clone(); insecure.ssl_mode = Some("require".into());
+    // when
+    let actual = [params, insecure].map(|params| resolve_connection_params(&params));
+    // then
+    assert_eq!(actual[0].as_ref().unwrap().ssl_mode.as_deref(), Some("verify-full"));
+    assert!(actual[1].is_err());
+}
+#[test]
+fn azure_sql에서_명시하지_않은_database를_거부한다() {
+    // given
+    let (mut params, _) = entra(); params.database = DatabaseSelection::default();
+    // when
+    let actual = resolve_connection_params(&params);
+    // then
+    assert!(actual.is_err());
+}
+#[test]
+fn entra와_다른_인증_정보가_충돌하면_거부한다() {
+    // given
+    let (mut params, _) = entra(); params.username = Some("sql-user".into());
+    // when
+    let actual = resolve_connection_params(&params);
+    // then
+    assert!(actual.is_err());
+}
+#[test]
+fn entra_token은_공개_aad_token과_검증하는_tls로_전달한다() {
+    // given
+    let (params, context) = entra(); let params = resolve_connection_params(&params).unwrap();
+    // when
+    let actual = pool::config(&params, &PluginSettings::default(), &context, 1000).unwrap().to_client_context();
+    // then
+    assert_eq!(actual.access_token.as_deref(), Some("synthetic-token"));
+    assert!(!actual.encryption_options.trust_server_certificate);
+    assert!(actual.password.is_empty());
+}
+#[test]
+fn deadline과_여유_시간보다_짧은_token을_거부한다() {
+    // given
+    let (params, mut context) = entra();
+    if let Some(types::TransientAuth::EntraToken { expires_at_ms, .. }) = &mut context.auth { *expires_at_ms = types::unix_ms()+300_000; }
+    // when
+    let actual = context.validate_auth(&params, 1000);
+    // then
+    assert_eq!(actual.unwrap_err().code, "AUTH_EXPIRED");
+}
+#[test]
+fn 다른_연결의_같은_request_id는_별도로_취소한다() {
+    // given
+    let (_, first) = entra(); let (_, mut second) = entra(); second.request_id = first.request_id.clone();
+    let a = registry::Scope::reserve(&first).unwrap(); let b = registry::Scope::reserve(&second).unwrap();
+    // when
+    let actual = registry::cancel(&first.connection_id, &first.request_id);
+    // then
