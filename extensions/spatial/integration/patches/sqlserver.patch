+        self.report.cancellation_phase = "native_request";
+        self.report.cancellation_write_outcome = if stopped.unknown { "unknown" } else { "not_applied" };
+        self.require("native_request_cancelled", matches!(stopped.error, Some("OUTCOME_UNKNOWN" | "CANCELLED" | "DEADLINE_EXCEEDED")), "request_cancel_result_without_server_phase_claim")?;
+        let final_read = self.data("service_test", json!({}), Role::Reader, true, None)?;
+        self.require("reader_after_cancel", final_read["success"] == true, "other_connection_remains_usable")
+    }
+    fn cleanup(&mut self) {
+        if let Some(handle) = self.session.take() {
+            let closed = self.call("service_session_finish", json!({"action":"rollback"}), Role::Writer, false, Some(&handle));
+            if !closed.as_ref().is_ok_and(|r| r.error.is_none() && r.result["rollback_confirmed"] == true) { self.report.error.get_or_insert("SESSION_CLEANUP_FAILED"); }
+        }
+        for id in self.owned.clone() {
+            let attempt = (|| {
+                let value = self.read_row(id)?;
+                let rows = value["rows"].as_array().ok_or(Error("CLEANUP_READ_FAILED"))?;
+                if rows.is_empty() { return Ok(()); }
+                if rows.len() != 1 || rows[0][0] != self.run_id || rows[0][1] != id { return Err(Error("CLEANUP_FOREIGN_RUN")); }
+                let deleted = self.data("service_row", self.row_input("row.delete", id), Role::Writer, false, None)?;
+                if !fixture::affected(&deleted) { return Err(Error("CLEANUP_DELETE_FAILED")); }
+                let remaining = self.read_row(id)?;
+                if remaining["rows"] != json!([]) { return Err(Error("CLEANUP_ROW_REMAINS")); }
+                Ok(())
+            })();
+            match attempt { Ok(()) => { self.owned.remove(&id); }, Err(error) => { self.report.error.get_or_insert(error.0); } }
+        }
+        self.report.cleanup_remaining = self.owned.len();
+        if !self.owned.is_empty() { self.report.remaining_id_sha256 = Some(format!("{:x}", Sha256::digest(serde_json::to_vec(&self.owned).unwrap_or_default()))); }
+        self.report.check("owned_fixture_cleanup", if self.owned.is_empty() { "pass" } else { "fail" }, "reread_complete_primary_key_one_delete_attempt");
+    }
+}
+
+pub fn run(config: &Config, credentials: &Credentials, rpc: &mut dyn Rpc) -> Report {
+    let started = Instant::now();
+    let mut report = Report::new();
+    report.evidence_kind = rpc.evidence_kind();
+    report.auth_modes = vec![config.writer.auth_mode.clone(), config.reader.auth_mode.clone()];
+    let mut harness = Harness { config, credentials, rpc, report: &mut report, run_id: uuid::Uuid::new_v4().to_string(), writer_connection: uuid::Uuid::new_v4().to_string(), reader_connection: uuid::Uuid::new_v4().to_string(), owned: BTreeSet::new(), session: None };
+    if let Err(error) = harness.sequence() { harness.report.error = Some(error.0); }
+    harness.cleanup();
+    if let Err(error) = harness.rpc.shutdown() { harness.report.error.get_or_insert(if error.0 == "DRIVER_SHUTDOWN_TIMEOUT" { error.0 } else { "DRIVER_SHUTDOWN_FAILED" }); }
+    report.elapsed_ms = started.elapsed().as_millis().try_into().unwrap_or(u64::MAX);
+    report.deferred();
+    report.success = report.error.is_none() && report.cleanup_remaining == 0;
+    report
+}
+
+pub fn authorized(config: &Config, flags: Flags, reader: &mut dyn SecretReader, factory: impl FnOnce(&Credentials) -> Result<Box<dyn Rpc>>) -> Report {
+    let preflight = (|| {
+        flags.validate()?; config.validate()?;
+        let credentials = Credentials::read(reader, config, super::now_ms())?;
+        let mut rpc = factory(&credentials)?;
+        Ok(run(config, &credentials, rpc.as_mut()))
+    })();
+    let mut report = match preflight { Ok(report) => report, Err(Error(code)) => { let mut report = Report::new(); report.error = Some(code); report.deferred(); report } };
+    if let Some(path) = &config.report {
+        if let Err(error) = report::publish(&report, Path::new(path)) { report.success = false; report.error = Some(error.0); }
+    }
+    report
+}
+pub fn run_live_from_stdin() -> Report {
+    let preflight = (|| {
+        let flags = Flags { live: std::env::var("TABULARIS_AZURE_SQL_ALLOW_LIVE").ok().as_deref() == Some("1"), fixture_writes: std::env::var("TABULARIS_AZURE_SQL_ALLOW_FIXTURE_WRITES").ok().as_deref() == Some("1") };
+        flags.validate()?;
+        let path = std::env::var_os("TABULARIS_AZURE_SQL_TEST_CONFIG").ok_or(Error("CONFIG_REQUIRED"))?;
+        let config = config::load(Path::new(&path))?;
+        Ok(authorized(&config, flags, &mut StdinSecrets, |credentials| LiveRpc::spawn(credentials).map(|rpc| Box::new(rpc) as Box<dyn Rpc>)))
+    })();
+    let report = match preflight { Ok(report) => report, Err(Error(code)) => { let mut report = Report::new(); report.error = Some(code); report.deferred(); report } };
+    if let Ok(bytes) = report.bytes() { println!("{}", String::from_utf8_lossy(&bytes)); }
+    report
+}
