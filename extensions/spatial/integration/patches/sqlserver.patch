diff --git a/src/driver/service/registry.rs b/src/driver/service/registry.rs
new file mode 100644
index 0000000000000000000000000000000000000000..34d8f46d5ec5f132d7f39b94bd0918168a791985
--- /dev/null
+++ b/src/driver/service/registry.rs
@@ -0,0 +1,73 @@
+use std::{collections::HashMap, sync::{Arc, Mutex, atomic::{AtomicBool, Ordering}}, time::Duration};
+use once_cell::sync::Lazy;
+use mssql_tds::core::CancelHandle;
+use tokio::{sync::Semaphore, time::Instant};
+use super::{types::DriverContext, ServiceError};
+
+type Key = (String, String);
+static REQUESTS: Lazy<Mutex<HashMap<Key, Arc<State>>>> = Lazy::new(|| Mutex::new(HashMap::new()));
+static CONNECTION_LIMITS: Lazy<Mutex<HashMap<String, Arc<Semaphore>>>> = Lazy::new(|| Mutex::new(HashMap::new()));
+pub struct State {
+    cancel: Mutex<Option<CancelHandle>>,
+    cancelled: AtomicBool,
+    sealed: AtomicBool,
+    write_dispatched: AtomicBool,
+    session_touched: AtomicBool,
+    opened_session: Mutex<Option<String>>,
+    pub deadline: Instant,
+    notify: tokio::sync::Notify,
+}
+pub struct Scope { pub state: Arc<State>, key: Key }
+impl State { pub fn mark_write(&self) { self.write_dispatched.store(true, Ordering::Release); } }
+impl Scope {
+    pub fn reserve(context: &DriverContext) -> Result<Self, ServiceError> {
+        let key = (context.connection_id.clone(), context.request_id.clone());
+        let mut requests = REQUESTS.lock().unwrap();
+        if requests.contains_key(&key) { return Err(ServiceError::argument("The request ID is already active on this connection")); }
+        let state = Arc::new(State { cancel: Mutex::new(Some(CancelHandle::new())), cancelled: AtomicBool::new(false), sealed: AtomicBool::new(false), write_dispatched: AtomicBool::new(false), session_touched: AtomicBool::new(false), opened_session: Mutex::new(None), deadline: Instant::now() + Duration::from_millis(context.deadline_ms), notify: tokio::sync::Notify::new() });
+        requests.insert(key.clone(), state.clone());
+        Ok(Self { state, key })
+    }
+    pub fn cancel_handle(&self) -> CancelHandle { self.state.cancel.lock().unwrap().as_ref().map(CancelHandle::child_handle).unwrap_or_else(|| { let parent = CancelHandle::new(); let child = parent.child_handle(); parent.cancel(); child }) }
+    pub fn remaining(&self) -> Result<u64, ServiceError> {
+        if self.cancelled() { return Err(ServiceError::new("CANCELLED", "The request was cancelled")); }
+        let remaining = self.state.deadline.saturating_duration_since(Instant::now()).as_millis() as u64;
+        if remaining == 0 { return Err(ServiceError::new("DEADLINE_EXCEEDED", "The request deadline was exceeded")); }
+        Ok(remaining)
+    }
+    pub fn cancelled(&self) -> bool { self.state.cancelled.load(Ordering::Acquire) }
+    pub fn mark_write(&self) { self.state.mark_write(); }
+    pub fn write_dispatched(&self) -> bool { self.state.write_dispatched.load(Ordering::Acquire) }
+    pub fn touch_session(&self) { self.state.session_touched.store(true, Ordering::Release); }
+    pub fn session_touched(&self) -> bool { self.state.session_touched.load(Ordering::Acquire) }
+    pub fn register_opened_session(&self, handle: &str) { *self.state.opened_session.lock().unwrap() = Some(handle.to_owned()); }
+    pub fn opened_session(&self) -> Option<String> { self.state.opened_session.lock().unwrap().clone() }
+    pub fn stop(&self) { stop(&self.state); }
+    pub fn seal(&self) { self.state.sealed.store(true, Ordering::Release); }
+    pub fn connection_id(&self) -> &str { &self.key.0 }
+    pub async fn wait_cancelled(&self) {
+        loop {
+            let notified = self.state.notify.notified(); tokio::pin!(notified); notified.as_mut().enable();
+            if self.cancelled() { return; }
+            notified.await;
+        }
+    }
+}
+impl Drop for Scope { fn drop(&mut self) { self.seal(); REQUESTS.lock().unwrap().remove(&self.key); } }
+fn stop(state: &State) {
+    if state.sealed.load(Ordering::Acquire) { return; }
+    state.cancelled.store(true, Ordering::Release);
+    state.notify.notify_waiters();
+    if let Some(handle) = state.cancel.lock().unwrap().take() { handle.cancel(); }
+}
+pub fn cancel(connection: &str, request: &str) -> bool {
+    let requests = REQUESTS.lock().unwrap();
+    if let Some(state) = requests.get(&(connection.to_owned(), request.to_owned())) {
+        if !state.sealed.load(Ordering::Acquire) { stop(state); return true; }
+    }
+    false
+}
+pub fn cancel_connection(connection: &str) { for ((id, _), state) in REQUESTS.lock().unwrap().iter() { if id == connection { stop(state); } } }
+pub fn cancel_all() { for state in REQUESTS.lock().unwrap().values() { stop(state); } }
+pub fn connection_limit(connection: &str) -> Arc<Semaphore> { CONNECTION_LIMITS.lock().unwrap().entry(connection.to_owned()).or_insert_with(|| Arc::new(Semaphore::new(4))).clone() }
+pub fn cleanup() { CONNECTION_LIMITS.lock().unwrap().retain(|_, semaphore| Arc::strong_count(semaphore) > 1); }
diff --git a/src/driver/service/row.rs b/src/driver/service/row.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b14c4919c6a4b232289a6f601617d75ac74aecfd
--- /dev/null
+++ b/src/driver/service/row.rs
@@ -0,0 +1,66 @@
+use serde::Deserialize;
+use serde_json::{json, Value};
+use std::collections::BTreeMap;
+use super::{catalog::TableRef, exact::{self, Parameter}, ServiceError};
+use crate::{models::ConnectionParams, driver::helpers::{bracket_quote, wrap_dml_with_rowcount}};
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Identity { pub columns: Vec<String>, pub values: Vec<Value> }
+#[derive(Deserialize)]
+#[serde(tag = "operation", deny_unknown_fields)]
+pub enum Input {
+    #[serde(rename = "row.insert")] Insert { table: TableRef, values: BTreeMap<String, Value> },
+    #[serde(rename = "row.update")] Update { table: TableRef, identity: Identity, changes: BTreeMap<String, Value> },
+    #[serde(rename = "row.delete")] Delete { table: TableRef, identity: Identity },
+}
+pub struct Query { pub text: String, pub parameters: Vec<Parameter> }
+pub async fn validate_primary_key(client: &mut mssql_tds::connection::tds_client::TdsClient, input: &Input, cancel: &mssql_tds::core::CancelHandle) -> Result<(), ServiceError> {
+    let (table, identity) = match input { Input::Insert { .. } => return Ok(()), Input::Update { table, identity, .. } | Input::Delete { table, identity } => (table, identity) };
+    let text = "SELECT c.name FROM sys.tables t JOIN sys.indexes i ON i.object_id=t.object_id AND i.is_primary_key=1 JOIN sys.index_columns ic ON ic.object_id=i.object_id AND ic.index_id=i.index_id JOIN sys.columns c ON c.object_id=ic.object_id AND c.column_id=ic.column_id WHERE t.object_id=OBJECT_ID(@table) AND ic.key_ordinal>0 ORDER BY ic.key_ordinal";
+    let parameters = exact::bind(&[Parameter { name: "@table".into(), value: json!(table.qualified()) }])?;
+    let data = exact::collect(client, text, parameters, Some(cancel), 128, super::types::FRAME_LIMIT, false).await?;
+    let keys = data["rows"].as_array().unwrap().iter().map(|row| row[0].as_str().map(str::to_owned).ok_or_else(|| ServiceError::new("CAPABILITY_UNAVAILABLE", "Primary key metadata is unavailable"))).collect::<Result<Vec<_>, _>>()?;
+    if keys.is_empty() { return Err(ServiceError::new("UNSUPPORTED_OPERATION", "Update and delete require a table primary key")); }
+    if identity.columns != keys || identity.values.len() != keys.len() || identity.values.iter().any(Value::is_null) {
+        return Err(ServiceError::argument("Identity must contain the complete ordered non-null primary key"));
+    }
+    Ok(())
+}
+fn identifier(value: &str) -> Result<(), ServiceError> { if value.is_empty() || value.contains('\0') || value.chars().count() > 128 { Err(ServiceError::argument("Invalid row column identifier")) } else { Ok(()) } }
+fn add(parameters: &mut Vec<Parameter>, value: &Value) -> Result<String, ServiceError> {
+    exact::value_type(value)?;
+    let name = format!("@P{}", parameters.len() + 1);
+    parameters.push(Parameter { name: name.clone(), value: value.clone() }); Ok(name)
+}
+fn predicate(identity: &Identity, parameters: &mut Vec<Parameter>) -> Result<String, ServiceError> {
+    if identity.columns.is_empty() || identity.columns.len() != identity.values.len() { return Err(ServiceError::argument("A complete row identity is required")); }
+    let mut names = std::collections::HashSet::new();
+    identity.columns.iter().zip(&identity.values).map(|(column, value)| {
+        identifier(column)?;
+        if !names.insert(column.to_ascii_lowercase()) { return Err(ServiceError::argument("Duplicate row identity columns")); }
+        Ok(if value.is_null() { format!("{} IS NULL", bracket_quote(column)) } else { format!("{}={}", bracket_quote(column), add(parameters, value)?) })
+    }).collect::<Result<Vec<_>, ServiceError>>().map(|parts| parts.join(" AND "))
+}
+pub fn query(input: &Input, params: &ConnectionParams) -> Result<Query, ServiceError> {
+    let mut parameters = Vec::new();
+    let text = match input {
+        Input::Insert { table, values } => {
+            table.validate(params)?;
+            if values.is_empty() { return Err(ServiceError::argument("Insert values are required")); }
+            let columns = values.keys().cloned().collect::<Vec<_>>();
+            for column in &columns { identifier(column)?; }
+            for value in values.values() { add(&mut parameters, value)?; }
+            crate::driver::helpers::build_insert_sql(table.schema.as_deref(), &table.table, &columns, false)
+        }
+        Input::Update { table, identity, changes } => {
+            table.validate(params)?;
+            if changes.is_empty() { return Err(ServiceError::argument("Row changes are required")); }
+            let mut assignments = Vec::new();
+            for (column, value) in changes { identifier(column)?; assignments.push(format!("{}={}", bracket_quote(column), add(&mut parameters, value)?)); }
+            let filter = predicate(identity, &mut parameters)?;
+            wrap_dml_with_rowcount(&format!("UPDATE {} SET {} WHERE {}", table.qualified(), assignments.join(","), filter))
+        }
+        Input::Delete { table, identity } => { table.validate(params)?; let filter = predicate(identity, &mut parameters)?; wrap_dml_with_rowcount(&format!("DELETE FROM {} WHERE {}", table.qualified(), filter)) }
+    };
+    Ok(Query { text, parameters })
+}
diff --git a/src/driver/service/sessions.rs b/src/driver/service/sessions.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bb3de06dcdcd5359c8ffc8e4e5133968630c5ea1
--- /dev/null
+++ b/src/driver/service/sessions.rs
@@ -0,0 +1,96 @@
+use std::{collections::HashMap, sync::Arc, time::Duration};
+use once_cell::sync::Lazy;
+use tokio::{sync::{Mutex, OwnedMutexGuard, OwnedSemaphorePermit, Semaphore}, time::Instant};
+use serde_json::{json, Value};
+use serde::Deserialize;
+use crate::models::ConnectionParams;
+use super::{pool::{self, NativeConnection}, registry::Scope, types::{DriverContext, SESSION_IDLE_MS}, ServiceError};
+
+struct Entry { connection_id: String, slot: Arc<Mutex<Slot>> }
+static SESSIONS: Lazy<Mutex<HashMap<String, Entry>>> = Lazy::new(|| Mutex::new(HashMap::new()));
+static CAPACITY: Lazy<Arc<Semaphore>> = Lazy::new(|| Arc::new(Semaphore::new(64)));
+pub struct Slot {
+    pub client: Option<NativeConnection>, pub connection_id: String, pub binding: String,
+    pub read_only: bool, pub last_used: Instant, pub dirty: bool, _permit: OwnedSemaphorePermit,
+}
+impl Slot { fn expired(&self) -> bool { self.last_used.elapsed() >= Duration::from_millis(SESSION_IDLE_MS) } }
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct OpenInput { pub database: Option<String>, pub mode: Mode }
+#[derive(Deserialize, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum Mode { ReadOnly, Write }
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct FinishInput { pub action: Action }
+#[derive(Deserialize, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum Action { Commit, Rollback, Close }
+impl Drop for Slot { fn drop(&mut self) { if let Some(client) = self.client.take() { pool::discard(client); } } }
+pub async fn open(client: NativeConnection, params: &ConnectionParams, context: &DriverContext, permit: OwnedSemaphorePermit) -> Value {
+    let handle = uuid::Uuid::new_v4().to_string();
+    let slot = Slot { client: Some(client), connection_id: context.connection_id.clone(), binding: pool::fingerprint(params, context), read_only: context.read_only, last_used: Instant::now(), dirty: false, _permit: permit };
+    SESSIONS.lock().await.insert(handle.clone(), Entry { connection_id: context.connection_id.clone(), slot: Arc::new(Mutex::new(slot)) });
+    json!({"session_handle":handle,"in_transaction":true,"rollback_confirmed":false})
+}
+pub fn reserve() -> Result<OwnedSemaphorePermit, ServiceError> { CAPACITY.clone().try_acquire_owned().map_err(|_| ServiceError::new("RESOURCE_LIMIT", "The physical session limit was reached")) }
+fn closed_error(message: &'static str) -> ServiceError { let mut error = ServiceError::argument(message); error.session_closed = true; error }
+pub async fn lock(handle: &str, params: &ConnectionParams, context: &DriverContext, scope: &Scope) -> Result<OwnedMutexGuard<Slot>, ServiceError> {
+    if uuid::Uuid::parse_str(handle).is_err() { return Err(ServiceError::argument("The physical session was not found")); }
+    let slot = SESSIONS.lock().await.get(handle).map(|entry| entry.slot.clone()).ok_or_else(|| closed_error("The physical session was not found"))?;
+    let mut slot = tokio::time::timeout_at(scope.state.deadline, slot.lock_owned()).await.map_err(|_| ServiceError::new("DEADLINE_EXCEEDED", "The session lock deadline was exceeded"))?;
+    if slot.client.is_none() || slot.expired() {
+        if let Some(client) = slot.client.take() { pool::discard(client); }
+        SESSIONS.lock().await.remove(handle);
+        return Err(closed_error("The physical session expired or closed"));
+    }
+    if slot.connection_id != context.connection_id || slot.binding != pool::fingerprint(params, context) || slot.read_only != context.read_only {
+        return Err(ServiceError::new("WRITE_NOT_ALLOWED", "The physical session connection or principal does not match"));
+    }
+    context.validate_auth(params, scope.remaining()?)?;
+    Ok(slot)
+}
+pub async fn forget(handle: &str) { SESSIONS.lock().await.remove(handle); }
+pub async fn invalidate(connection: &str) {
+    let slots = SESSIONS.lock().await.iter().filter(|(_, entry)| entry.connection_id == connection).map(|(id, entry)| (id.clone(), entry.slot.clone())).collect::<Vec<_>>();
+    for (id, slot) in slots { let mut slot = slot.lock().await; if let Some(client) = slot.client.take() { pool::discard(client); } forget(&id).await; }
+}
+pub async fn cleanup() {
+    let slots = SESSIONS.lock().await.iter().map(|(id, entry)| (id.clone(), entry.slot.clone())).collect::<Vec<_>>();
+    for (id, slot) in slots { if let Ok(slot) = slot.try_lock() { if slot.expired() { drop(slot); forget(&id).await; } } }
+}
+pub async fn shutdown() { SESSIONS.lock().await.clear(); }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn 읽기와_쓰기_session은_모두_유휴_만료되어_entry와_permit을_반환한다() {
+        // given
+        let runtime = tokio::runtime::Builder::new_current_thread().enable_all().build().unwrap();
+        let capacity = Arc::new(Semaphore::new(2));
+        let handles = [uuid::Uuid::new_v4().to_string(), uuid::Uuid::new_v4().to_string()];
+        let context: DriverContext = serde_json::from_value(json!({"protocol_version":1,"connection_id":uuid::Uuid::new_v4().to_string(),"request_id":"idle-policy"})).unwrap();
+        runtime.block_on(async {
+            for (handle, read_only) in handles.iter().zip([true, false]) {
+                let slot = Slot { client: None, connection_id: context.connection_id.clone(), binding: "policy-fixture".into(), read_only, last_used: Instant::now() - Duration::from_millis(SESSION_IDLE_MS + 1), dirty: false, _permit: capacity.clone().acquire_owned().await.unwrap() };
+                SESSIONS.lock().await.insert(handle.clone(), Entry { connection_id: context.connection_id.clone(), slot: Arc::new(Mutex::new(slot)) });
+            }
+        });
+        let run = || runtime.block_on(async {
+            cleanup().await;
+            let scope = Scope::reserve(&context).unwrap();
+            let mut errors = Vec::new();
+            for handle in &handles { errors.push(lock(handle, &ConnectionParams::default(), &context, &scope).await.err().unwrap()); }
+            let entries = SESSIONS.lock().await;
+            let removed = handles.iter().all(|handle| !entries.contains_key(handle));
+            (errors, removed, capacity.available_permits())
+        });
+        // when
+        let actual = run();
+        // then
+        assert!(actual.0.iter().all(|error| error.code == "INVALID_ARGUMENT" && error.session_closed && !error.unknown));
+        assert!(actual.1);
+        assert_eq!(actual.2, 2);
+    }
+}
