+struct InjectedClock {
+    base: std::time::Instant,
+    elapsed_ms: std::sync::atomic::AtomicU64,
+}
+impl InjectedClock {
+    fn new() -> Self { Self { base: std::time::Instant::now(), elapsed_ms: std::sync::atomic::AtomicU64::new(0) } }
+    fn advance(&self, duration: std::time::Duration) { self.elapsed_ms.fetch_add(duration.as_millis().try_into().unwrap(), std::sync::atomic::Ordering::SeqCst); }
+}
+impl harness::rpc::Clock for InjectedClock {
+    fn now(&self) -> std::time::Instant { self.base + std::time::Duration::from_millis(self.elapsed_ms.load(std::sync::atomic::Ordering::SeqCst)) }
+    fn pause(&self, duration: std::time::Duration) { self.advance(duration); }
+}
+fn shared_request_deadline() -> (Vec<u64>, Option<&'static str>) {
+    use harness::rpc::{Clock, Deadlines};
+    use std::time::Duration;
+    let clock=InjectedClock::new();
+    let mut deadlines=Deadlines::new(clock.now());
+    deadlines.begin("request",clock.now()).unwrap();
