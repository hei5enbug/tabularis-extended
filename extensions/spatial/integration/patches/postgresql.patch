+        assert!(exported.reference_integrity&&!exported.null_identities);
+        assert_eq!(exported.page_sizes,vec![1000,1000,1000,1000,1000,1000,1000,1000,1000,1000,1]);
+        assert!(exported.max_page_bytes<=8*1024*1024&&exported.max_page_coordinates<=100_000);
