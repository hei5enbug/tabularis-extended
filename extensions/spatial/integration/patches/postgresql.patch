+struct Plugin {child:Child,stdin:Option<ChildStdin>,responses:mpsc::Receiver<Value>}
+impl Plugin {
+    fn new()->Self {
+        let mut child=Command::new(env!("CARGO_BIN_EXE_postgresql-plugin")).stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::null()).spawn().unwrap();
+        let stdin=child.stdin.take();let stdout=child.stdout.take().unwrap();
+        let (sender,responses)=mpsc::channel();
+        std::thread::spawn(move||{
+            for line in BufReader::new(stdout).lines() {
+                let Ok(line)=line else {break;};
+                let Ok(value)=serde_json::from_str(&line) else {break;};
+                if sender.send(value).is_err(){break;}
+            }
+        });
+        Self {child,stdin,responses}
+    }
+    fn send(&mut self,request:&Value){writeln!(self.stdin.as_mut().unwrap(),"{request}").unwrap();self.stdin.as_mut().unwrap().flush().unwrap();}
+    fn cancel_and_drain(mut self,cancel:Value,cleanup:Vec<Value>)->(Value,Duration,bool) {
+        let start=Instant::now();self.send(&cancel);let mut response=Value::Null;
+        while start.elapsed()<Duration::from_secs(3) {
+            let Ok(next)=self.responses.recv_timeout(Duration::from_secs(3).saturating_sub(start.elapsed())) else {break;};
+            if next["id"]==cancel["id"] {response=next;break;}
+        }
+        let elapsed=start.elapsed();
+        for cancel in cleanup {self.send(&cancel);}
+        self.stdin.take();
+        let success=self.child.wait().unwrap().success();
+        (response,elapsed,success)
+    }
+}
+impl Drop for Plugin {fn drop(&mut self){let _=self.child.kill();let _=self.child.wait();}}
