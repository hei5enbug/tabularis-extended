+    }
+    async fn cancel_isolated(&self,cancel:Value,first:tokio::task::JoinHandle<Value>,second_cancel:Value,second:tokio::task::JoinHandle<Value>,tag:&str)->(Value,Value,bool,Value) {
+        let response=self.send(cancel).await;
