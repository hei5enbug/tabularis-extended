+pub fn input<T: for<'de> Deserialize<'de>>(params: &Value) -> Result<T, SpatialError> {
+    serde_json::from_value(params.get("input").cloned().unwrap_or(Value::Null))
+        .map_err(|_| SpatialError::argument("Invalid operation input"))
+}
