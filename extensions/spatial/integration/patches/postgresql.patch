+    async fn finish_and_measure(&self,request:Value)->(Value,i32) {
+        let response=self.send(request).await;
+        let count=self.client.query_one(&format!("SELECT counter FROM {}.writes WHERE id=1",self.schema),&[]).await.unwrap().get(0);
+        (response,count)
+    }
+    async fn serialize_and_commit(&self,second:Value,first:tokio::task::JoinHandle<Value>,finish:Value)->(Value,Value,Value,i32) {
+        let second=self.send(second).await;
+        let first=first.await.unwrap();
