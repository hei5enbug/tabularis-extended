+        assert_eq!(response["result"]["accepted"],true);
+        assert_eq!(finished["error"]["data"]["code"],"CANCELLED");
+        assert_eq!(finished["error"]["data"]["outcome"],"not_applied");
+        assert_eq!(counter,0);
