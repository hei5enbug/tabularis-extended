+#[test]
+fn 고정_row는_사용자_sql_추가_필드를_받지_않는다() {
+    // given
+    let input = params(json!({"operation":"row.insert","table":{"database":"fixture","schema":"public","table":"items"},"values":{"name":"x"},"text":"DROP TABLE items"}),false);
