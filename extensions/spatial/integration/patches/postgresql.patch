+    // given
+    let input = ConnectionParams::from_value(&json!({"connection_string":"postgresql://user:dsn-error-canary@host:invalid/db"}));
+    // when
+    let actual = client::normalize_service_params(&input).unwrap_err();
+    // then
+    assert_eq!(actual.code,"INVALID_ARGUMENT");
+    assert!(!serde_json::to_string(&actual).unwrap().contains("dsn-error-canary"));
+}
+
+#[test]
+fn 복합_identity는_실제_pk의_전체_순서와_null없음을_요구한다() {
+    // given
+    let key = vec!["tenant".to_string(),"id".to_string()];
