+async fn 잘못된_export와_display_상한은_연결을_시도하기_전에_거부한다() {
+    // given
+    let base=json!({"table":{"database":"spatial_fixture","schema":null,"table":"points"},"column":"g",
+        "viewport":{"west":-180,"south":-90,"east":180,"north":90,"world":true},"export_limit_bytes":MAX_EXPORT_BYTES,
+        "limits":{"max_features":1_000_000,"max_coordinates":10_000_000,"max_bytes":EXPORT_BYTES}});
+    let mut inputs=Vec::new();
+    for limit in [0,MAX_EXPORT_BYTES+1] {let mut input=base.clone();input["export_limit_bytes"]=json!(limit);inputs.push(input);}
+    for (field,value) in [("max_features",1_000_001),("max_coordinates",10_000_001),("max_bytes",MAX_EXPORT_BYTES+1)] {
+        let mut input=base.clone();input["limits"][field]=json!(value);inputs.push(input);
+    }
+    let mut too_many=base.clone();too_many.as_object_mut().unwrap().remove("export_limit_bytes");inputs.push(too_many);
+    let mut too_many_coordinates=base.clone();too_many_coordinates.as_object_mut().unwrap().remove("export_limit_bytes");too_many_coordinates["limits"]=json!({"max_coordinates":250_001});inputs.push(too_many_coordinates);
+    let mut too_many_bytes=base.clone();too_many_bytes.as_object_mut().unwrap().remove("export_limit_bytes");too_many_bytes["limits"]=json!({"max_bytes":DISPLAY_BYTES+1});inputs.push(too_many_bytes);
+    for page in [0,1001] {let mut input=base.clone();input["page_size"]=json!(page);inputs.push(input);}
+    let mut exclusive=base;exclusive["keyset"]=json!({"columns":["id"],"values":[1]});exclusive["next_token"]=json!("cursor");inputs.push(exclusive);
+    // when
+    let responses=rejected_before_connection(inputs).await;
+    // then
+    assert_eq!(responses.len(),11);
+    assert!(responses.iter().all(|response|response["error"]["data"]["code"]=="INVALID_ARGUMENT"),"{responses:?}");
+    assert!(responses.iter().all(|response|response["error"]["data"]["outcome"]=="not_applied"));
+    assert!(responses.iter().all(|response|response.get("result").is_none()));
+}
