diff --git a/src/handlers/spatial/catalog.rs b/src/handlers/spatial/catalog.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5664c922ba1715e7a870d2e75c56069c2035dbc1
--- /dev/null
+++ b/src/handlers/spatial/catalog.rs
@@ -0,0 +1,159 @@
+use serde::Serialize;
+use tokio_postgres::{Client, Column};
+
+use crate::utils::identifiers::quote_identifier;
+use super::{ewkb, SpatialError};
+
+#[derive(Clone, Debug)]
+pub struct Catalog {
+    pub schema: String,
+    pub geometry_oid: u32,
+    pub geography_oid: u32,
+}
+
+impl Catalog {
+    pub async fn load(client: &Client) -> Result<Option<Self>, SpatialError> {
+        let row = client.query_opt(
+            "SELECT n.nspname::text, \
+             (SELECT t.oid FROM pg_type t JOIN pg_depend d ON d.objid=t.oid AND d.classid='pg_type'::regclass \
+              WHERE d.refobjid=e.oid AND d.refclassid='pg_extension'::regclass AND d.deptype='e' AND t.typname='geometry') AS geometry_oid, \
+             (SELECT t.oid FROM pg_type t JOIN pg_depend d ON d.objid=t.oid AND d.classid='pg_type'::regclass \
+              WHERE d.refobjid=e.oid AND d.refclassid='pg_extension'::regclass AND d.deptype='e' AND t.typname='geography') AS geography_oid \
+             FROM pg_extension e JOIN pg_namespace n ON n.oid=e.extnamespace WHERE e.extname='postgis'", &[])
+            .await.map_err(SpatialError::database)?;
+        row.map(|r| Ok(Self { schema: r.get(0), geometry_oid: r.try_get(1)
+            .map_err(|_| SpatialError::unsupported("PostGIS geometry type is unavailable"))?,
+            geography_oid: r.try_get(2)
+            .map_err(|_| SpatialError::unsupported("PostGIS geography type is unavailable"))? })).transpose()
+    }
+    pub fn function(&self, name: &str) -> String {
+        format!("{}.{}", quote_identifier(&self.schema), quote_identifier(name))
+    }
+    pub fn native_type(&self,ty: &tokio_postgres::types::Type) -> Option<&'static str> {
+        let ty=ewkb::base_type(ty);
+        if ty.schema()!=self.schema {return None;}
+        if ty.oid()==self.geometry_oid {Some("geometry")}
+        else if ty.oid()==self.geography_oid {Some("geography")}
+        else {None}
+    }
+    fn spatial_array(&self,ty: &tokio_postgres::types::Type) -> bool {
+        match ewkb::base_type(ty).kind() {
+            tokio_postgres::types::Kind::Array(element)=>self.native_type(element).is_some()||self.spatial_array(element),
+            _=>false,
+        }
+    }
+    pub fn validate_columns(&self, columns: &[Column]) -> Result<(), SpatialError> {
+        for column in columns {
+            let ty = ewkb::base_type(column.type_());
+            if self.spatial_array(ty) {
+                return Err(SpatialError::unsupported("Spatial arrays are unsupported"));
+            }
+            if let Some(native) = self.native_type(ty) {
+                let oid = if native == "geometry" { self.geometry_oid } else { self.geography_oid };
+                if ty.oid() != oid || ty.schema() != self.schema {
+                    return Err(SpatialError::unsupported("Type is not owned by the PostGIS extension"));
+                }
+            }
+        }
+        Ok(())
+    }
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub struct SpatialColumn {
+    #[serde(rename = "name")]
+    pub column: String,
+    pub column_index: usize,
+    pub native_type: String,
+    pub type_oid: u32,
+    pub base_oid: u32,
+    pub typmod: i32,
+    pub nullable: bool,
+    pub srid: Option<i32>,
+    pub srid_status: String,
+    pub dimensions: Option<String>,
+    pub geometry_type: Option<String>,
+    pub primary_key: Vec<String>,
+    pub spatial_index: bool,
+}
+
+#[derive(Clone, Debug)]
+pub struct TableCatalog {
+    pub columns: Vec<SpatialColumn>,
+    pub primary_key: Vec<String>,
+    pub all_columns: Vec<String>,
+    pub column_types: std::collections::HashMap<String, String>,
+    pub keyset_supported: bool,
+}
+
+fn supports_keyset(oid: u32) -> bool {
+    use tokio_postgres::types::Type;
+    [Type::BOOL,Type::INT2,Type::INT4,Type::INT8,Type::FLOAT4,Type::FLOAT8,
+        Type::NUMERIC,Type::TEXT,Type::VARCHAR,Type::BPCHAR,Type::NAME,Type::UUID,
+        Type::DATE,Type::TIME,Type::TIMESTAMP,Type::TIMESTAMPTZ,
+        Type::OID,Type::INET,Type::CIDR,Type::MACADDR,Type::MACADDR8,Type::BIT,Type::VARBIT]
+        .iter().any(|ty|ty.oid()==oid)
+}
+
+pub async fn table_columns(client: &Client, catalog: &Catalog, schema: &str, table: &str)
+    -> Result<TableCatalog, SpatialError> {
+    let relation = client.query_opt(
+        "SELECT c.oid FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace \
+         WHERE n.nspname=$1 AND c.relname=$2 AND c.relkind IN ('r','p','v','m','f')", &[&schema, &table])
+        .await.map_err(SpatialError::database)?
+        .ok_or_else(|| SpatialError::argument("Table does not exist"))?;
+    let relation_oid: u32 = relation.get(0);
+    let primary_key = client.query(
+        "SELECT a.attname::text FROM pg_constraint c \
+         CROSS JOIN LATERAL unnest(c.conkey) WITH ORDINALITY AS k(attnum,ord) \
+         JOIN pg_attribute a ON a.attrelid=c.conrelid AND a.attnum=k.attnum \
+         WHERE c.conrelid=$1 AND c.contype='p' ORDER BY k.ord", &[&relation_oid])
+        .await.map_err(SpatialError::database)?.iter().map(|r| r.get(0)).collect::<Vec<String>>();
+    let query = format!(
+        "WITH RECURSIVE ty AS ( \
+         SELECT a.attnum,a.attname,a.atttypid AS type_oid,a.atttypid AS base_oid,a.atttypmod AS typmod,a.attnotnull,0 AS depth \
+         FROM pg_attribute a WHERE a.attrelid=$1 AND a.attnum>0 AND NOT a.attisdropped \
+         UNION ALL SELECT ty.attnum,ty.attname,ty.type_oid,t.typbasetype, \
+         CASE WHEN ty.typmod<0 THEN t.typtypmod ELSE ty.typmod END,ty.attnotnull OR t.typnotnull,ty.depth+1 \
+         FROM ty JOIN pg_type t ON t.oid=ty.base_oid WHERE t.typtype='d' AND ty.depth<64) \
+         SELECT ty.attname::text,ty.type_oid,ty.base_oid,ty.typmod,ty.attnotnull,t.typname::text, \
+         pg_catalog.format_type(ty.base_oid,ty.typmod)::text AS data_type, \
+         CASE WHEN ty.base_oid IN ($2,$3) AND ty.typmod>=0 THEN {}(ty.typmod) ELSE 0 END AS srid, \
+         CASE WHEN ty.base_oid IN ($2,$3) AND ty.typmod>=0 THEN {}(ty.typmod) ELSE NULL END AS geometry_type, \
+         gc.coord_dimension::integer AS geometry_dimensions,gg.coord_dimension::integer AS geography_dimensions, \
+         EXISTS (SELECT 1 FROM pg_index i JOIN pg_class ic ON ic.oid=i.indexrelid \
+                 JOIN pg_am am ON am.oid=ic.relam WHERE i.indrelid=$1 AND i.indisvalid \
+                 AND am.amname IN ('gist','spgist','brin') AND ty.attnum=ANY(i.indkey)) AS spatial_index \
+         FROM ty JOIN pg_type t ON t.oid=ty.base_oid \
+         LEFT JOIN {}.geometry_columns gc ON gc.f_table_schema=$4 AND gc.f_table_name=$5 AND gc.f_geometry_column=ty.attname \
+         LEFT JOIN {}.geography_columns gg ON gg.f_table_schema=$4 AND gg.f_table_name=$5 AND gg.f_geography_column=ty.attname \
+         WHERE t.typtype<>'d' OR ty.depth=64 ORDER BY ty.attnum",
+        catalog.function("postgis_typmod_srid"), catalog.function("postgis_typmod_type"),
+        quote_identifier(&catalog.schema), quote_identifier(&catalog.schema));
+    let rows = client.query(&query, &[&relation_oid,&catalog.geometry_oid,&catalog.geography_oid,&schema,&table])
+        .await.map_err(SpatialError::database)?;
+    let mut columns = Vec::new();
+    let mut all_columns = Vec::new();
+    let mut column_types = std::collections::HashMap::new();
+    let mut keyset_supported=true;
+    for (column_index,row) in rows.into_iter().enumerate() {
+        let name: String = row.get(0);
+        all_columns.push(name.clone());
+        column_types.insert(name.clone(), row.get(6));
+        let oid: u32 = row.get(2);
+        if primary_key.contains(&name) && !supports_keyset(oid) {keyset_supported=false;}
+        if oid != catalog.geometry_oid && oid != catalog.geography_oid { continue; }
+        let srid: i32 = row.get(7);
+        let typmod: i32 = row.get(3);
+        let geometry_type: Option<String> = row.get(8);
+        let dimensions = geometry_type.as_deref().map(|g| {
+            if g.ends_with("ZM") { "XYZM" } else if g.ends_with('Z') { "XYZ" }
+            else if g.ends_with('M') { "XYM" } else { "XY" }.to_string()
+        });
+        columns.push(SpatialColumn { column: name, column_index, native_type: row.get(5), type_oid: row.get(1),
+            base_oid: oid, typmod, nullable: !row.get::<_, bool>(4), srid: (srid != 0).then_some(srid),
+            srid_status: if srid != 0 { "known" } else if typmod < 0 { "mixed" } else { "unknown" }.into(),
+            dimensions, geometry_type, primary_key: primary_key.clone(), spatial_index: row.get(11) });
+    }
+    Ok(TableCatalog { columns, primary_key, all_columns, column_types, keyset_supported })
+}
diff --git a/src/handlers/spatial/connection.rs b/src/handlers/spatial/connection.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2e608db6ad822a69b3555350bfe0ce6a191f6ace
--- /dev/null
+++ b/src/handlers/spatial/connection.rs
@@ -0,0 +1,96 @@
+use deadpool_postgres::Object;
+use tokio::sync::OwnedMutexGuard;
+
+use crate::{cancel::ScopedGuard, client, models::ConnectionParams, session};
+use super::{types::DriverContext, SpatialError};
+
+pub enum Lease {
+    Owned(Box<Option<Object>>),
+    Session(OwnedMutexGuard<session::ServiceSlot>,bool),
+}
+impl Drop for Lease {
+    fn drop(&mut self) {
+        if let Self::Owned(client) = self {
+            if let Some(client) = client.take() { drop(Object::take(client)); }
+        }
+        if let Self::Session(slot,false)=self {
+            if let Some(client)=slot.client.take(){drop(Object::take(client));}
+        }
+    }
+}
+impl Lease {
+    pub fn client(&self) -> &Object {
+        match self {
+            Self::Owned(client) => client.as_ref().as_ref().unwrap(),
+            Self::Session(slot,_) => slot.client.as_ref().unwrap(),
+        }
+    }
+    pub async fn acquire(context: &DriverContext, params: &ConnectionParams, scope: &ScopedGuard)
+        -> Result<Self, SpatialError> {
+        client::normalize_service_params(params)?;
+        if scope.cancelled() { return Err(SpatialError::new("CANCELLED", "Request was cancelled before database execution")); }
+        let lease = if let Some(handle) = &context.session_handle {
+            Self::Session(session::lock_service(handle,&context.connection_id,context.read_only).await?,false)
+        } else {
+            let pool = client::build_service_pool(params).await?;
+            let client = pool.get().await
+                .map_err(|_| SpatialError::new("CONNECTION_NOT_FOUND", "Cannot acquire database connection"))?;
+            let lease = Self::Owned(Box::new(Some(client)));
+            lease.client().batch_execute(if context.read_only { "BEGIN READ ONLY" } else { "BEGIN READ WRITE" })
+                .await.map_err(SpatialError::database)?;
+            lease
+        };
+        scope.attach(lease.client(),params.clone()).await;
+        if scope.cancelled() { return Err(SpatialError::new("CANCELLED", "Request was cancelled before database execution")); }
+        let deadline = context.deadline_ms.to_string();
+        lease.client().query_one("SELECT pg_catalog.set_config('statement_timeout',$1,true)", &[&deadline])
+            .await.map_err(SpatialError::database)?;
+        verify_transaction(lease.client(),context.read_only).await?;
+        Ok(lease)
+    }
+    pub async fn finish(&mut self, scope: &ScopedGuard, success: bool, read_only: bool) -> Result<(), SpatialError> {
+        scope.seal();
+        scope.settle().await;
+        let stopped=scope.cancelled()||scope.backend_stopped();
+        match self {
+            Self::Owned(client) => {
+                let Some(pg) = client.as_ref() else { return Ok(()); };
+                let commit = success && !read_only && !stopped;
+                if commit {
+                    match tokio::time::timeout(std::time::Duration::from_secs(5),pg.batch_execute("COMMIT")).await {
+                        Ok(Ok(()))=>{},
+                        _=>return Err(SpatialError::new("OUTCOME_UNKNOWN","Transaction commit could not be confirmed")),
+                    }
+                }else if !session::confirm_rollback(pg).await {
+                    return Err(SpatialError::new("OUTCOME_UNKNOWN","Transaction rollback could not be confirmed"));
+                }
+                if stopped {
+                    if let Some(pg) = client.take() { drop(Object::take(pg)); }
+                } else { client.take(); }
+            }
+            Self::Session(slot,completed) => {
+                slot.last_used = std::time::Instant::now();
+                if !success || stopped {
+                    if let Some(pg) = slot.client.take() {
+                        let confirmed=session::confirm_rollback(&pg).await;
+                        if stopped || !confirmed {drop(Object::take(pg));}
+                        if !confirmed {
+                            return Err(SpatialError::new("OUTCOME_UNKNOWN", "Session rollback could not be confirmed"));
+                        }
+                    }
+                }
+                *completed=true;
+            }
+        }
+        Ok(())
+    }
+}
+
+pub async fn verify_transaction(client: &tokio_postgres::Client,read_only: bool) -> Result<(),SpatialError> {
+    client.batch_execute("SAVEPOINT service_transaction_probe").await
+        .map_err(|_|SpatialError::new("OUTCOME_UNKNOWN","Reserved transaction is no longer active"))?;
+    let actual: String=client.query_one("SHOW transaction_read_only",&[]).await.map_err(SpatialError::database)?.get(0);
+    client.batch_execute("RELEASE SAVEPOINT service_transaction_probe").await.map_err(SpatialError::database)?;
+    if (actual=="on")!=read_only { return Err(SpatialError::new("WRITE_NOT_ALLOWED","Database transaction access mode does not match context")); }
+    Ok(())
+}
diff --git a/src/handlers/spatial/ewkb.rs b/src/handlers/spatial/ewkb.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0df1c29218a1a7c783d054257cb862cb82aeb246
--- /dev/null
+++ b/src/handlers/spatial/ewkb.rs
@@ -0,0 +1,168 @@
+use base64::{engine::general_purpose::STANDARD, Engine};
+use serde::{Deserialize, Serialize};
+use tokio_postgres::types::{FromSql, Kind, Type};
+
+use super::SpatialError;
+
+#[derive(Clone, Debug, Deserialize, Serialize, PartialEq)]
+#[serde(deny_unknown_fields)]
+pub struct SpatialValue {
+    pub kind: String,
+    pub native_type: String,
+    pub srid: Option<i32>,
+    pub dimensions: String,
+    pub encoding: String,
+    pub value: String,
+    pub is_empty: bool,
+}
+
+#[derive(Clone, Debug)]
+pub struct EwkbInfo {
+    pub srid: Option<i32>,
+    pub dimensions: &'static str,
+    pub positions: usize,
+    pub supported: bool,
+    pub invalid_xy: bool,
+}
+
+impl SpatialValue {
+    pub fn from_bytes(native_type: &str, bytes: &[u8]) -> Result<Self, SpatialError> {
+        let info = inspect(bytes)?;
+        Ok(Self {
+            kind: "spatial".into(), native_type: native_type.into(), srid: info.srid,
+            dimensions: info.dimensions.into(), encoding: "ewkb-base64".into(),
+            value: STANDARD.encode(bytes), is_empty: info.positions == 0,
+        })
+    }
+
+    pub fn bytes(&self) -> Result<(Vec<u8>, EwkbInfo), SpatialError> {
+        if self.kind != "spatial" || self.encoding != "ewkb-base64"
+            || !matches!(self.native_type.as_str(), "geometry" | "geography") {
+            return Err(SpatialError::argument("Expected a geometry/geography EWKB wrapper"));
+        }
+        let bytes = STANDARD.decode(&self.value)
+            .map_err(|_| SpatialError::geometry("Invalid EWKB base64"))?;
+        let info = inspect(&bytes)?;
+        if self.srid != info.srid || self.dimensions != info.dimensions
+            || self.is_empty != (info.positions == 0) {
+            return Err(SpatialError::geometry("EWKB wrapper metadata does not match its bytes"));
+        }
+        Ok((bytes, info))
+    }
+}
+
+pub fn base_type(mut ty: &Type) -> &Type {
+    while let Kind::Domain(base) = ty.kind() { ty = base; }
+    ty
+}
+
+pub fn native_type(ty: &Type) -> Option<&str> {
+    let base = base_type(ty);
+    (matches!(base.kind(), Kind::Simple)
+        && base.oid() >= 16_384
+        && matches!(base.name(), "geometry" | "geography"))
+        .then(|| base.name())
+}
+
+pub fn is_spatial_array(ty: &Type) -> bool {
+    match base_type(ty).kind() {
+        Kind::Array(element) => native_type(element).is_some() || is_spatial_array(element),
+        _ => false,
+    }
+}
+
+pub struct SpatialBytes(pub Vec<u8>);
+
+impl<'a> FromSql<'a> for SpatialBytes {
+    fn from_sql(_: &Type, raw: &'a [u8]) -> Result<Self, Box<dyn std::error::Error + Send + Sync>> {
+        Ok(Self(raw.to_vec()))
+    }
+    fn accepts(ty: &Type) -> bool { native_type(ty).is_some() }
+}
+
+pub fn inspect(bytes: &[u8]) -> Result<EwkbInfo, SpatialError> {
+    let mut cursor = Cursor { bytes, offset: 0 };
+    let info = cursor.geometry(0)?;
+    if cursor.offset != bytes.len() { return Err(SpatialError::geometry("Trailing EWKB bytes")); }
+    Ok(info)
+}
+
+struct Cursor<'a> { bytes: &'a [u8], offset: usize }
+
+impl Cursor<'_> {
+    fn take(&mut self, count: usize) -> Result<&[u8], SpatialError> {
+        let end = self.offset.checked_add(count).filter(|end| *end <= self.bytes.len())
+            .ok_or_else(|| SpatialError::geometry("Truncated EWKB"))?;
+        let result = &self.bytes[self.offset..end];
+        self.offset = end;
+        Ok(result)
+    }
+    fn integer(&mut self, little: bool) -> Result<u32, SpatialError> {
+        let bytes: [u8; 4] = self.take(4)?.try_into().unwrap();
+        Ok(if little { u32::from_le_bytes(bytes) } else { u32::from_be_bytes(bytes) })
+    }
+    fn count(&mut self, little: bool) -> Result<usize, SpatialError> {
+        let n = self.integer(little)? as usize;
+        if n > self.bytes.len().saturating_sub(self.offset) {
+            return Err(SpatialError::geometry("Invalid EWKB element count"));
+        }
+        Ok(n)
+    }
+    fn point(&mut self, little: bool, dimensions: usize) -> Result<(usize,bool), SpatialError> {
+        let mut xy = [0.0;2];
+        for index in 0..dimensions {
+            let bytes: [u8; 8] = self.take(8)?.try_into().unwrap();
+            let v = if little { f64::from_le_bytes(bytes) } else { f64::from_be_bytes(bytes) };
+            if let Some(coordinate)=xy.get_mut(index) { *coordinate=v; }
+        }
+        let empty=xy.iter().all(|value|value.is_nan());
+        Ok((usize::from(!empty),!empty && !xy.iter().all(|value|value.is_finite())))
+    }
+    fn geometry(&mut self, depth: usize) -> Result<EwkbInfo, SpatialError> {
+        if depth > 64 { return Err(SpatialError::geometry("EWKB nesting exceeds 64 levels")); }
+        let little = match self.take(1)?[0] { 0 => false, 1 => true,
+            _ => return Err(SpatialError::geometry("Invalid EWKB byte order")) };
+        let word = self.integer(little)?;
+        let mut geometry_type = word & 0x0fff_ffff;
+        let iso = geometry_type / 1000;
+        geometry_type %= 1000;
+        let z = word & 0x8000_0000 != 0 || matches!(iso, 1 | 3);
+        let m = word & 0x4000_0000 != 0 || matches!(iso, 2 | 3);
+        let dimensions = match (z, m) { (false, false) => "XY", (true, false) => "XYZ",
+            (false, true) => "XYM", (true, true) => "XYZM" };
+        let dim = 2 + usize::from(z) + usize::from(m);
+        let srid = if word & 0x2000_0000 != 0 {
+            let srid = self.integer(little)? as i32;
+            (srid != 0).then_some(srid)
+        } else { None };
+        let mut positions = 0usize;
+        let mut invalid_xy = false;
+        let mut supported = (1..=7).contains(&geometry_type);
+        match geometry_type {
+            1 => { let point=self.point(little,dim)?;positions=point.0;invalid_xy=point.1; },
+            2 | 8 => {
+                let n = self.count(little)?;
+                for _ in 0..n { let point=self.point(little,dim)?;positions+=point.0;invalid_xy|=point.1; }
+            }
+            3 | 17 => {
+                let n = self.count(little)?;
+                for _ in 0..n {
+                    let n = self.count(little)?;
+                    for _ in 0..n { let point=self.point(little,dim)?;positions+=point.0;invalid_xy|=point.1; }
+                }
+            }
+            4..=7 | 9..=12 | 15 | 16 => {
+                let n = self.count(little)?;
+                for _ in 0..n {
+                    let child = self.geometry(depth + 1)?;
+                    positions = positions.checked_add(child.positions)
+                        .ok_or_else(|| SpatialError::geometry("EWKB coordinate count overflow"))?;
+                    supported &= child.supported;
+                    invalid_xy |= child.invalid_xy;
+                }
+            }
+            _ => return Err(SpatialError::unsupported("Unknown EWKB geometry type")),
+        }
+        Ok(EwkbInfo { srid, dimensions, positions, supported, invalid_xy })
+    }
+}
diff --git a/src/handlers/spatial/exact.rs b/src/handlers/spatial/exact.rs
new file mode 100644
index 0000000000000000000000000000000000000000..af05ac7b0d2ac458e0e160ebe39bd0f69e99754c
--- /dev/null
+++ b/src/handlers/spatial/exact.rs
@@ -0,0 +1,148 @@
+use futures_util::{pin_mut,TryStreamExt};
+use serde::Deserialize;
+use serde_json::{json,Value};
+use tokio_postgres::{Client,types::Type};
+
+use crate::binding::PgParam;
+use super::{catalog::Catalog,SpatialError};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ExactInput {
+    pub text: String,
+    #[serde(default)]
+    pub parameters: Vec<Parameter>,
+    #[serde(default="max_rows")]
+    pub max_rows: usize,
+    #[serde(default="max_bytes")]
+    pub max_bytes: usize,
+}
+fn max_rows() -> usize { 10_000 }
+fn max_bytes() -> usize { 32*1024*1024 }
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Parameter {pub name: String,pub value: Value}
+
+pub fn validate_text(text: &str) -> Result<(),SpatialError> {
+    fn skip(bytes: &[u8],offset: &mut usize) -> Result<(),SpatialError> {
+        loop {
+            while bytes.get(*offset).is_some_and(u8::is_ascii_whitespace) {*offset+=1;}
+            if bytes.get(*offset..*offset+2)==Some(b"--") {
+                *offset+=2;while bytes.get(*offset).is_some_and(|b|*b!=b'\n') {*offset+=1;}
+            } else if bytes.get(*offset..*offset+2)==Some(b"/*") {
+                *offset+=2;let mut depth=1usize;
+                while depth>0 {
+                    if *offset>=bytes.len() {return Err(SpatialError::argument("Unterminated SQL comment"));}
+                    if bytes.get(*offset..*offset+2)==Some(b"/*") {depth+=1;*offset+=2;}
+                    else if bytes.get(*offset..*offset+2)==Some(b"*/") {depth-=1;*offset+=2;}
+                    else {*offset+=1;}
+                }
+            } else {return Ok(());}
+        }
+    }
+    fn word(bytes: &[u8],offset: &mut usize) -> Result<String,SpatialError> {
+        skip(bytes,offset)?;let start=*offset;
+        while bytes.get(*offset).is_some_and(|b|b.is_ascii_alphabetic()||*b==b'_') {*offset+=1;}
+        Ok(String::from_utf8_lossy(&bytes[start..*offset]).to_ascii_uppercase())
+    }
+    let mut offset=0;let first=word(text.as_bytes(),&mut offset)?;
+    let blocked=matches!(first.as_str(),"BEGIN"|"START"|"COMMIT"|"END"|"ROLLBACK"|"ABORT"|"SAVEPOINT"|"RELEASE"|"SET"|"RESET"|"DISCARD")
+        || (first=="PREPARE" && word(text.as_bytes(),&mut offset)?=="TRANSACTION");
+    if blocked {return Err(SpatialError::new("UNSUPPORTED_OPERATION","Transaction/session control requires the service session RPCs"));}
+    if text.trim().is_empty() {return Err(SpatialError::argument("SQL text is required"));}
+    Ok(())
+}
+
+fn bind(value: &Value,ty: &Type) -> Result<PgParam,SpatialError> {
+    let invalid=||SpatialError::argument("Parameter value does not match the PostgreSQL parameter type");
+    macro_rules! scalar {
+        ($type:ty,$convert:expr) => {{
+            if value.is_null() {return Ok(Box::new(None::<$type>));}
+            let typed: $type=$convert.ok_or_else(invalid)?;
+            return Ok(Box::new(typed));
+        }};
+    }
+    match *ty {
+        Type::BOOL=>scalar!(bool,value.as_bool()),
+        Type::INT2=>scalar!(i16,value.as_i64().or_else(||value.as_str().and_then(|v|v.parse().ok())).and_then(|v|i16::try_from(v).ok())),
+        Type::INT4=>scalar!(i32,value.as_i64().or_else(||value.as_str().and_then(|v|v.parse().ok())).and_then(|v|i32::try_from(v).ok())),
+        Type::INT8=>scalar!(i64,value.as_i64().or_else(||value.as_str().and_then(|v|v.parse().ok()))),
+        Type::FLOAT4=>scalar!(f32,value.as_f64().map(|v|v as f32).filter(|v|v.is_finite())),
+        Type::FLOAT8=>scalar!(f64,value.as_f64().filter(|v|v.is_finite())),
+        Type::TEXT|Type::VARCHAR|Type::BPCHAR|Type::NAME=>scalar!(String,value.as_str().map(str::to_string)),
+        Type::UUID=>scalar!(uuid::Uuid,value.as_str().and_then(|v|v.parse().ok())),
+        Type::NUMERIC=>scalar!(rust_decimal::Decimal,value.as_str().map(str::to_string).or_else(||value.is_number().then(||value.to_string())).and_then(|v|v.parse().ok())),
+        Type::DATE=>scalar!(chrono::NaiveDate,value.as_str().and_then(|v|v.parse().ok())),
+        Type::TIME=>scalar!(chrono::NaiveTime,value.as_str().and_then(|v|v.parse().ok())),
+        Type::TIMESTAMP=>scalar!(chrono::NaiveDateTime,value.as_str().and_then(|v|v.parse().ok())),
+        Type::TIMESTAMPTZ=>scalar!(chrono::DateTime<chrono::Utc>,value.as_str().and_then(|v|v.parse().ok())),
+        Type::JSON|Type::JSONB=>{
+            if value.is_null(){Ok(Box::new(None::<Value>))}else{Ok(Box::new(value.clone()))}
+        }
+        _=>Err(SpatialError::argument("Unsupported PostgreSQL parameter type")),
+    }
+}
+
+pub async fn execute(client: &Client,catalog: Option<&Catalog>,input: &ExactInput,scope: &crate::cancel::ScopedGuard,read_only: bool,reserved: bool) -> Result<Value,SpatialError> {
+    validate_text(&input.text)?;
+    if input.max_rows==0||input.max_rows>max_rows()||input.max_bytes==0||input.max_bytes>max_bytes() {
+        return Err(SpatialError::argument("Exact query limits exceed the supported bounds"));
+    }
+    for (index,parameter) in input.parameters.iter().enumerate() {
+        if parameter.name!=format!("${}",index+1) {return Err(SpatialError::argument("Parameters must use ordered unique contiguous $1..$n names"));}
+    }
+    let statement=client.prepare(&input.text).await.map_err(SpatialError::database)?;
+    if statement.params().len()!=input.parameters.len() {return Err(SpatialError::argument("Parameter count does not match SQL"));}
+    if let Some(catalog)=catalog {catalog.validate_columns(statement.columns())?;}
+    let values=input.parameters.iter().zip(statement.params()).map(|(parameter,ty)|bind(&parameter.value,ty)).collect::<Result<Vec<_>,_>>()?;
+    let references=values.iter().map(|v|v.as_ref() as &(dyn tokio_postgres::types::ToSql+Sync)).collect::<Vec<_>>();
+    let columns=statement.columns().iter().map(|c|c.name()).collect::<Vec<_>>();
+    let mut column_metadata=statement.columns().iter().enumerate().map(|(index,c)|json!({"name":c.name(),"column_index":index,
+        "type_oid":c.type_().oid(),"native_type":catalog.and_then(|catalog|catalog.native_type(c.type_())),
+        "srid":null,"dimensions":null})).collect::<Vec<_>>();
+    if let Some(catalog)=catalog {
+        for (index,column) in statement.columns().iter().enumerate() {
+            if catalog.native_type(column.type_()).is_some() && column.type_modifier()>=0 {
+                let query=format!("SELECT {}($1::integer),{}($1::integer)",catalog.function("postgis_typmod_srid"),catalog.function("postgis_typmod_type"));
+                let meta=client.query_one(&query,&[&column.type_modifier()]).await.map_err(SpatialError::database)?;
+                let srid: i32=meta.get(0);let shape: String=meta.get(1);
+                column_metadata[index]["srid"]=json!((srid!=0).then_some(srid));
+                column_metadata[index]["dimensions"]=json!(if shape.ends_with("ZM"){"XYZM"}else if shape.ends_with('Z'){"XYZ"}else if shape.ends_with('M'){"XYM"}else{"XY"});
+            }
+        }
+    }
+    let envelope=json!({"columns":columns,"column_metadata":column_metadata,"rows":[],"affected_rows":u64::MAX,
+        "truncated":true,"pagination":null,"limits":{"truncated":true,"reasons":["ROW_LIMIT","BYTE_LIMIT"]},
+        "page":{"next_token":null,"has_more":false,"resume_mode":"none"}});
+    let mut rows=Vec::new();let mut bytes=serde_json::to_vec(&envelope).map_err(|_|SpatialError::argument("Cannot encode query columns"))?.len();
+    if bytes>input.max_bytes {return Err(SpatialError::new("RESOURCE_LIMIT","Query column metadata exceeds the byte limit"));}
+    let mut reasons=Vec::new();let affected;
+    client.batch_execute("SAVEPOINT exact_query_stream").await.map_err(SpatialError::database)?;
+    {
+        let stream=client.query_raw(&statement,references).await.map_err(SpatialError::database)?;
+        pin_mut!(stream);
+        while let Some(row)=stream.try_next().await.map_err(SpatialError::database)? {
+            if rows.len()>=input.max_rows {reasons.push("ROW_LIMIT");break;}
+            let row=row.columns().iter().enumerate().map(|(index,_)|
+                crate::extract::extract_value_with_catalog(&row,index,catalog)).collect::<Result<Vec<_>,_>>()?;
+            let size=serde_json::to_vec(&row).map_err(|_|SpatialError::argument("Cannot encode query row"))?.len();
+            let size=size+usize::from(!rows.is_empty());
+            if bytes+size>input.max_bytes {reasons.push("BYTE_LIMIT");break;}
+            bytes+=size;rows.push(row);
+        }
+        affected=stream.rows_affected().unwrap_or(0);
+    }
+    if !reasons.is_empty() {
+        scope.stop_backend().await;
+        if !read_only || reserved {
+            let mut error=SpatialError::new("RESOURCE_LIMIT","Query result exceeded its limit; the full transaction was rolled back");
+            if reserved {error.details=json!({"session_closed":true});}
+            return Err(error);
+        }
+    }else{
+        client.batch_execute("RELEASE SAVEPOINT exact_query_stream").await.map_err(SpatialError::database)?;
+    }
+    Ok(json!({"columns":columns,"column_metadata":column_metadata,"rows":rows,"affected_rows":affected,
+        "truncated":!reasons.is_empty(),"pagination":null,"limits":{"truncated":!reasons.is_empty(),"reasons":reasons},
+        "page":{"next_token":null,"has_more":false,"resume_mode":"none"}}))
+}
diff --git a/src/handlers/spatial/mod.rs b/src/handlers/spatial/mod.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c12daf7c79a17df8a65e970ef7bf80b0ef133c23
--- /dev/null
+++ b/src/handlers/spatial/mod.rs
@@ -0,0 +1,156 @@
+pub mod ewkb;
+pub mod catalog;
+pub mod types;
+pub mod connection;
+pub mod transform;
+pub mod sql;
+pub mod table;
+pub mod exact;
+pub mod sessions;
+pub mod service;
+
+use serde::Serialize;
+use serde::Deserialize;
+use serde_json::{json, Value};
+
+#[derive(Clone, Debug, Serialize)]
+pub struct SpatialError {
+    pub code: String,
+    pub message: String,
+    pub retryable: bool,
+    pub outcome: String,
+    pub details: Value,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ColumnsInput { table: types::TableRef }
+
+pub async fn dispatch(id: Value, params: &Value, method: &str) -> Value {
+    dispatch_with_scope(id,params,method,None).await
+}
+pub async fn dispatch_with_scope(id: Value, params: &Value, method: &str,scope: Option<crate::cancel::ScopedGuard>) -> Value {
+    match run(params,method,scope).await {
+        Ok(value)=>crate::rpc::ok_response(id,value),Err(error)=>error.response(id),
+    }
+}
+
+async fn run(params: &Value,method: &str,scope: Option<crate::cancel::ScopedGuard>) -> Result<Value,SpatialError> {
+    let read_only = !matches!(method,"execute_query_exact"|"service_row"|"service_invalidate_auth");
+    let (context,mut connection)=types::DriverContext::parse(params,read_only)?;
+    let scope=match scope {Some(scope)=>scope,None=>crate::cancel::ScopedGuard::reserve(&context.connection_id,&context.request_id)?};
+    if method=="service_invalidate_auth" {
+        types::input::<service::EmptyInput>(params)?;
+        return service::invalidate(&context,&scope).await;
+    }
+    let table=match method {
+        "spatial_columns"=>Some(types::input::<ColumnsInput>(params)?.table),
+        "spatial_query_table"=>{let input=types::input::<table::TableInput>(params)?;input.validate()?;Some(input.table)},
+        "spatial_read_feature"=>Some(types::input::<table::ReadInput>(params)?.table),
+        "execute_query_exact"=>{let input=types::input::<exact::ExactInput>(params)?;exact::validate_text(&input.text)?;None},
+        "spatial_transform_values"=>{types::input::<transform::TransformInput>(params)?;None},
+        "service_test"|"service_catalog"|"service_row"=>service::validate(params,method,&context,&connection)?,
+        _=>return Err(SpatialError::new("UNSUPPORTED_OPERATION","Unknown spatial driver method")),
+    };
+    if let Some(table)=&table {
+        if context.session_handle.is_none() {connection=table.connection(&connection)?;}
+        else {table.connection(&connection)?;}
+    }
+    let deadline=tokio::time::Instant::now()+std::time::Duration::from_millis(context.deadline_ms);
+    let mut lease=tokio::time::timeout(std::time::Duration::from_millis(context.deadline_ms),
+        connection::Lease::acquire(&context,&connection,&scope)).await
+        .map_err(|_|SpatialError::new("DEADLINE_EXCEEDED","Connection acquisition deadline exceeded"))??;
+    let result=async {
+        if let Some(database)=table.as_ref().and_then(|t|t.database.as_deref()) {
+            let actual: String=lease.client().query_one("SELECT current_database()",&[]).await.map_err(SpatialError::database)?.get(0);
+            if actual!=database {return Err(SpatialError::argument("Table database does not match the reserved connection"));}
+        }
+        let catalog=catalog::Catalog::load(lease.client()).await?;
+        if method=="execute_query_exact" {
+            return exact::execute(lease.client(),catalog.as_ref(),&types::input(params)?,&scope,context.read_only,context.session_handle.is_some()).await;
+        }
+        match method {
+            "service_test"=>{
+                lease.client().query_one("SELECT 1",&[]).await.map_err(SpatialError::database)?;
+                return Ok(json!({"connected":true}));
+            },
+            "service_catalog"=>return service::catalog(lease.client(),catalog.as_ref(),types::input(params)?,&scope,context.session_handle.is_some()).await,
+            "service_row"=>return service::row(lease.client(),catalog.as_ref(),types::input(params)?,&scope,context.session_handle.is_some()).await,
+            _=>{},
+        }
+        let catalog=catalog.ok_or_else(||SpatialError::new("CAPABILITY_UNAVAILABLE","PostGIS extension is not installed"))?;
+        match method {
+            "spatial_columns"=>{
+                let input: ColumnsInput=types::input(params)?;
+                let metadata=catalog::table_columns(lease.client(),&catalog,input.table.schema(),&input.table.table).await?;
+                Ok(json!({"columns":metadata.columns}))
+            }
+            "spatial_transform_values"=>transform::transform_values(lease.client(),&catalog,&types::input(params)?).await,
+            "spatial_query_table"=>table::query_table(lease.client(),&catalog,&context.connection_id,&types::input(params)?).await,
+            "spatial_read_feature"=>table::read_feature(lease.client(),&catalog,&types::input(params)?).await,
+            _=>unreachable!(),
+        }
+    };
+    let result=match tokio::time::timeout_at(deadline,result).await {
+        Ok(result)=>result,
+        Err(_)=>{
+            scope.stop_backend().await;
+            Err(SpatialError::new("DEADLINE_EXCEEDED","Driver operation deadline exceeded"))
+        }
+    };
+    let successful=result.is_ok();
+    let finish=lease.finish(&scope,successful,context.read_only).await;
+    if let Err(mut error)=finish {
+        if !context.read_only {error.code="OUTCOME_UNKNOWN".into();error.outcome="unknown".into();}
+        if context.session_handle.is_some(){error.details=json!({"session_closed":true});}
+        return Err(error);
+    }
+    if scope.cancelled() && result.is_ok() {
+        let mut error=SpatialError::new("CANCELLED","Request was cancelled; transaction rollback was confirmed");
+        if context.session_handle.is_some(){error.details=json!({"session_closed":true});}
+        return Err(error);
+    }
+    result.map_err(|mut error| {
+        if error.code=="CANCELLED" && !scope.cancelled(){error.code="DEADLINE_EXCEEDED".into();}
+        if context.session_handle.is_some(){error.details=json!({"session_closed":true});}
+        error
+    })
+}
+
+impl SpatialError {
+    pub fn new(code: &str, message: &str) -> Self {
+        Self { code: code.into(), message: message.into(), retryable: false,
+            outcome: if code=="OUTCOME_UNKNOWN" {"unknown"} else {"not_applied"}.into(), details: Value::Null }
+    }
+    pub fn argument(message: &str) -> Self { Self::new("INVALID_ARGUMENT", message) }
+    pub fn geometry(message: &str) -> Self { Self::new("INVALID_GEOMETRY", message) }
+    pub fn unsupported(message: &str) -> Self { Self::new("UNSUPPORTED_TYPE", message) }
+    pub fn database(error: tokio_postgres::Error) -> Self {
+        let code = match error.code().map(|c| c.code()) {
+            Some("57014") => "CANCELLED", Some("25006") => "WRITE_NOT_ALLOWED",
+            Some("42501") => "PERMISSION_DENIED", Some("XX000" | "22023" | "22003") => "INVALID_GEOMETRY",
+            Some("42601" | "42P18" | "42703" | "42P01" | "42883") => "INVALID_ARGUMENT",
+            _ => "DRIVER_EXITED",
+        };
+        let message = match code {
+            "CANCELLED" => "Database statement was cancelled",
+            "WRITE_NOT_ALLOWED" => "Database rejected a write in a read-only transaction",
+            "PERMISSION_DENIED" => "Database permission denied",
+            "INVALID_GEOMETRY" => "PostGIS rejected the geometry or coordinate transformation",
+            _ => "Database operation failed",
+        };
+        Self::new(code, message)
+    }
+    pub fn response(&self, id: Value) -> Value {
+        json!({ "jsonrpc": "2.0", "id": id, "error": { "code": -32000,
+            "message": "Driver operation failed", "data": self } })
+    }
+}
+
+impl std::fmt::Display for SpatialError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "{}: {}", self.code, self.message)
+    }
+}
+
+impl std::error::Error for SpatialError {}
diff --git a/src/handlers/spatial/service.rs b/src/handlers/spatial/service.rs
new file mode 100644
index 0000000000000000000000000000000000000000..db44164e6b9971788202f3b1246663d9b3687337
--- /dev/null
+++ b/src/handlers/spatial/service.rs
@@ -0,0 +1,152 @@
+use serde::Deserialize;
+use serde_json::{json, Map, Value};
+use tokio_postgres::Client;
+
+use crate::{cancel::ScopedGuard, models::ConnectionParams, utils::identifiers::{qualified, quote_identifier}};
+use super::{catalog::Catalog, exact::{self, ExactInput, Parameter}, types::{self, DriverContext, RowIdentity, TableRef}, SpatialError};
+
+#[derive(Deserialize)]
+#[serde(tag = "operation", deny_unknown_fields)]
+pub enum CatalogInput {
+    #[serde(rename = "catalog.databases")]
+    Databases,
+    #[serde(rename = "catalog.schemas")]
+    Schemas { database: String },
+    #[serde(rename = "catalog.objects")]
+    Objects { database: String, schema: Option<String> },
+    #[serde(rename = "catalog.describe")]
+    Describe { table: TableRef },
+}
+#[derive(Deserialize)]
+#[serde(tag = "operation", deny_unknown_fields)]
+pub enum RowInput {
+    #[serde(rename = "row.insert")]
+    Insert { table: TableRef, values: Map<String, Value> },
+    #[serde(rename = "row.update")]
+    Update { table: TableRef, identity: RowIdentity, changes: Map<String, Value> },
+    #[serde(rename = "row.delete")]
+    Delete { table: TableRef, identity: RowIdentity },
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct EmptyInput {}
+
+pub fn validate(params: &Value, method: &str, context: &DriverContext, connection: &ConnectionParams) -> Result<Option<TableRef>, SpatialError> {
+    if method == "service_row" && context.read_only {
+        return Err(SpatialError::new("WRITE_NOT_ALLOWED", "Row mutations require a write context"));
+    }
+    let (database, table) = match method {
+        "service_test" | "service_invalidate_auth" => { types::input::<EmptyInput>(params)?; (None, None) },
+        "service_catalog" => match types::input::<CatalogInput>(params)? {
+            CatalogInput::Databases => (None, None),
+            CatalogInput::Schemas { database } | CatalogInput::Objects { database, .. } => (Some(database), None),
+            CatalogInput::Describe { table } => (table.database.clone(), Some(table)),
+        },
+        "service_row" => {
+            let table = match types::input::<RowInput>(params)? {
+                RowInput::Insert { table, values } => { validate_values(&values)?; table },
+                RowInput::Update { table, changes, .. } => { validate_values(&changes)?; table },
+                RowInput::Delete { table, .. } => table,
+            };
+            (table.database.clone(), Some(table))
+        },
+        _ => return Err(SpatialError::new("UNSUPPORTED_OPERATION", "Unknown fixed service operation")),
+    };
+    let configured = crate::client::normalize_service_params(connection)?;
+    if database.as_deref().is_some_and(|database| configured.database.as_deref() != Some(database)) {
+        return Err(SpatialError::argument("Input database does not match connection settings"));
+    }
+    if let Some(table) = &table { table.connection(&configured)?; }
+    Ok(table)
+}
+
+fn validate_values(values: &Map<String, Value>) -> Result<(), SpatialError> {
+    if values.is_empty() || values.keys().any(|name| name.is_empty() || name.contains('\0')) {
+        return Err(SpatialError::argument("A nonempty column-to-value object is required"));
+    }
+    Ok(())
+}
+fn exact_input(text: String, values: Vec<Value>) -> ExactInput {
+    ExactInput { text, parameters: values.into_iter().enumerate().map(|(index, value)| Parameter { name: format!("${}", index + 1), value }).collect(), max_rows: 10_000, max_bytes: 32 * 1024 * 1024 }
+}
+fn row_objects(result: &Value) -> Result<Vec<Value>, SpatialError> {
+    let columns = result["columns"].as_array().ok_or_else(|| SpatialError::argument("Missing catalog columns"))?;
+    result["rows"].as_array().ok_or_else(|| SpatialError::argument("Missing catalog rows"))?.iter().map(|row| {
+        let row = row.as_array().ok_or_else(|| SpatialError::argument("Invalid catalog row"))?;
+        let values = columns.iter().zip(row).map(|(name, value)| Ok((name.as_str().ok_or_else(|| SpatialError::argument("Invalid catalog column"))?.to_string(), value.clone()))).collect::<Result<Map<_, _>, SpatialError>>()?;
+        Ok(Value::Object(values))
+    }).collect()
+}
+
+pub async fn catalog(client: &Client, catalog: Option<&Catalog>, input: CatalogInput, scope: &ScopedGuard, reserved: bool) -> Result<Value, SpatialError> {
+    let (key, text, values, strings) = match input {
+        CatalogInput::Databases => ("databases", "SELECT datname::text AS name FROM pg_catalog.pg_database WHERE datallowconn AND pg_catalog.has_database_privilege(oid,'CONNECT') ORDER BY datname".to_string(), vec![], true),
+        CatalogInput::Schemas { .. } => ("schemas", "SELECT nspname::text AS name FROM pg_catalog.pg_namespace WHERE pg_catalog.has_schema_privilege(oid,'USAGE') ORDER BY nspname".to_string(), vec![], true),
+        CatalogInput::Objects { schema, .. } => ("objects", "SELECT n.nspname::text AS schema,c.relname::text AS name,CASE c.relkind WHEN 'v' THEN 'view' WHEN 'm' THEN 'materialized_view' WHEN 'f' THEN 'foreign_table' ELSE 'table' END::text AS kind FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace WHERE c.relkind IN ('r','p','v','m','f') AND ($1::text IS NULL OR n.nspname=$1) AND pg_catalog.has_schema_privilege(n.oid,'USAGE') AND pg_catalog.has_table_privilege(c.oid,'SELECT') ORDER BY n.nspname,c.relname".to_string(), vec![schema.map(Value::String).unwrap_or(Value::Null)], false),
+        CatalogInput::Describe { table } => ("columns", "SELECT a.attname::text AS name,(row_number() OVER (ORDER BY a.attnum)-1)::integer AS column_index,a.atttypid::bigint AS type_oid,pg_catalog.format_type(a.atttypid,a.atttypmod)::text AS data_type,NOT a.attnotnull AS nullable,COALESCE(a.attnum=ANY(pk.conkey),false) AS is_primary_key,pg_catalog.array_position(pk.conkey,a.attnum)::integer AS primary_key_position,COALESCE((SELECT json_agg(pa.attname ORDER BY k.ordinality) FROM unnest(pk.conkey) WITH ORDINALITY k(attnum,ordinality) JOIN pg_catalog.pg_attribute pa ON pa.attrelid=c.oid AND pa.attnum=k.attnum),'[]'::json) AS primary_key,pg_catalog.pg_get_expr(d.adbin,d.adrelid)::text AS default_value,(a.attidentity<>'' OR a.attgenerated<>'' OR pg_catalog.pg_get_expr(d.adbin,d.adrelid) LIKE 'nextval(%') AS generated FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace JOIN pg_catalog.pg_attribute a ON a.attrelid=c.oid LEFT JOIN pg_catalog.pg_constraint pk ON pk.conrelid=c.oid AND pk.contype='p' LEFT JOIN pg_catalog.pg_attrdef d ON d.adrelid=c.oid AND d.adnum=a.attnum WHERE n.nspname=$1 AND c.relname=$2 AND a.attnum>0 AND NOT a.attisdropped AND pg_catalog.has_schema_privilege(n.oid,'USAGE') AND pg_catalog.has_table_privilege(c.oid,'SELECT') ORDER BY a.attnum".to_string(), vec![json!(table.schema()), json!(table.table)], false),
+    };
+    let result = exact::execute(client, catalog, &exact_input(text, values), scope, true, reserved).await?;
+    let objects = row_objects(&result)?;
+    let rows = if strings { objects.into_iter().map(|row| row["name"].clone()).collect::<Vec<_>>() } else { objects };
+    Ok(json!({key: rows,"limits":result["limits"],"page":result["page"]}))
+}
+
+async fn primary_key(client: &Client, table: &TableRef) -> Result<Vec<String>, SpatialError> {
+    let rows = client.query("SELECT a.attname::text FROM pg_catalog.pg_constraint p JOIN pg_catalog.pg_class c ON c.oid=p.conrelid JOIN pg_catalog.pg_namespace n ON n.oid=c.relnamespace JOIN unnest(p.conkey) WITH ORDINALITY k(attnum,ordinality) ON true JOIN pg_catalog.pg_attribute a ON a.attrelid=c.oid AND a.attnum=k.attnum WHERE p.contype='p' AND n.nspname=$1 AND c.relname=$2 ORDER BY k.ordinality", &[&table.schema(), &table.table]).await.map_err(SpatialError::database)?;
+    Ok(rows.iter().map(|row| row.get(0)).collect())
+}
+pub fn validate_identity(identity: &RowIdentity, primary_key: &[String]) -> Result<(), SpatialError> {
+    if primary_key.is_empty() { return Err(SpatialError::new("UNSUPPORTED_OPERATION", "Update and delete require a primary key")); }
+    if identity.columns != primary_key || identity.values.len() != primary_key.len() || identity.values.iter().any(Value::is_null) {
+        return Err(SpatialError::argument("Identity must contain the complete ordered non-null primary key"));
+    }
+    Ok(())
+}
+pub async fn row(client: &Client, catalog: Option<&Catalog>, input: RowInput, scope: &ScopedGuard, reserved: bool) -> Result<Value, SpatialError> {
+    let table = match &input { RowInput::Insert { table, .. } | RowInput::Update { table, .. } | RowInput::Delete { table, .. } => table };
+    let pk = primary_key(client, table).await?;
+    let relation = qualified(table.schema(), &table.table);
+    let returning = if pk.is_empty() { String::new() } else { format!(" RETURNING {}", pk.iter().map(|name| quote_identifier(name)).collect::<Vec<_>>().join(",")) };
+    let (text, values, insert) = match input {
+        RowInput::Insert { values, .. } => {
+            validate_values(&values)?;
+            let columns = values.keys().map(|name| quote_identifier(name)).collect::<Vec<_>>().join(",");
+            let placeholders = (1..=values.len()).map(|index| format!("${index}")).collect::<Vec<_>>().join(",");
+            (format!("INSERT INTO {relation} ({columns}) VALUES ({placeholders}){returning}"), values.into_iter().map(|(_, value)| value).collect(), true)
+        },
+        RowInput::Update { identity, changes, .. } => {
+            validate_identity(&identity, &pk)?; validate_values(&changes)?;
+            let sets = changes.keys().enumerate().map(|(index, name)| format!("{}=${}", quote_identifier(name), index + 1)).collect::<Vec<_>>().join(",");
+            let predicate = identity.columns.iter().enumerate().map(|(index, name)| format!("{}=${}", quote_identifier(name), changes.len() + index + 1)).collect::<Vec<_>>().join(" AND ");
+            let mut values = changes.into_iter().map(|(_, value)| value).collect::<Vec<_>>(); values.extend(identity.values);
+            (format!("UPDATE {relation} SET {sets} WHERE {predicate}"), values, false)
+        },
+        RowInput::Delete { identity, .. } => {
+            validate_identity(&identity, &pk)?;
+            let predicate = identity.columns.iter().enumerate().map(|(index, name)| format!("{}=${}", quote_identifier(name), index + 1)).collect::<Vec<_>>().join(" AND ");
+            (format!("DELETE FROM {relation} WHERE {predicate}"), identity.values, false)
+        },
+    };
+    let result = exact::execute(client, catalog, &exact_input(text, values), scope, false, reserved).await?;
+    let mut data = json!({"affected_rows":result["affected_rows"]});
+    if insert && !pk.is_empty() { data["generated_keys"] = json!(row_objects(&result)?); }
+    Ok(data)
+}
+
+pub async fn invalidate(context: &DriverContext, scope: &ScopedGuard) -> Result<Value, SpatialError> {
+    if context.auth.is_some() || context.session_handle.is_some() {
+        return Err(SpatialError::argument("Authentication invalidation accepts only an opaque connection context"));
+    }
+    scope.seal();
+    let connection = context.connection_id.clone();
+    let cancel = tokio::spawn(async move {
+        let requests = crate::cancel::cancel_connection(&connection).await;
+        let sessions = crate::session::invalidate_service_connection(&connection).await;
+        let cursors = super::table::invalidate_connection(&connection);
+        (requests,sessions,cursors)
+    });
+    let (requests,sessions,cursors) = tokio::time::timeout(std::time::Duration::from_millis(context.deadline_ms), cancel).await
+        .map_err(|_| SpatialError::new("DEADLINE_EXCEEDED", "Authentication invalidation deadline exceeded"))?
+        .map_err(|_| SpatialError::new("DRIVER_EXITED", "Authentication invalidation could not be accepted"))?;
+    Ok(json!({"accepted":true,"discarded_sessions":sessions,"cancelled_requests":requests,"invalidated_cursors":cursors}))
+}
diff --git a/src/handlers/spatial/sessions.rs b/src/handlers/spatial/sessions.rs
new file mode 100644
index 0000000000000000000000000000000000000000..a628132b1e36f4ee10b989001daaf960d94dcdca
--- /dev/null
+++ b/src/handlers/spatial/sessions.rs
@@ -0,0 +1,79 @@
+use serde::Deserialize;
+use serde_json::{json,Value};
+
+use crate::{cancel::ScopedGuard,session};
+use super::{connection::{Lease,verify_transaction},types::{self,DriverContext},SpatialError};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct OpenInput {database: Option<String>,mode: Mode}
+#[derive(Deserialize,PartialEq)]
+#[serde(rename_all="snake_case")]
+enum Mode {ReadOnly,Write}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct FinishInput {action: Action}
+#[derive(Deserialize,PartialEq)]
+#[serde(rename_all="snake_case")]
+enum Action {Commit,Rollback,Close}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct EmptyInput {}
+
+pub async fn dispatch(id: Value,params: &Value,method: &str) -> Value {
+    dispatch_with_scope(id,params,method,None).await
+}
+pub async fn dispatch_with_scope(id: Value,params: &Value,method: &str,scope: Option<ScopedGuard>) -> Value {
+    match run(params,method,scope).await {Ok(value)=>crate::rpc::ok_response(id,value),Err(error)=>error.response(id)}
+}
+async fn run(params: &Value,method: &str,scope: Option<ScopedGuard>) -> Result<Value,SpatialError> {
+    let (context,mut connection)=DriverContext::parse(params,false)?;
+    let scope=match scope {Some(scope)=>scope,None=>ScopedGuard::reserve(&context.connection_id,&context.request_id)?};
+    if method=="service_session_open" {
+        let input: OpenInput=types::input(params)?;
+        if context.session_handle.is_some() || (input.mode==Mode::ReadOnly)!=context.read_only {
+            return Err(SpatialError::argument("Session open context does not match the requested mode"));
+        }
+        if let Some(database)=input.database {connection.database=Some(database);}
+        let mut lease=tokio::time::timeout(std::time::Duration::from_millis(context.deadline_ms),Lease::acquire(&context,&connection,&scope)).await
+            .map_err(|_|SpatialError::new("DEADLINE_EXCEEDED","Session acquisition deadline exceeded"))??;
+        scope.settle().await;
+        if scope.cancelled(){return Err(SpatialError::new("CANCELLED","Session open was cancelled"));}
+        let Lease::Owned(client)=&mut lease else {unreachable!()};
+        let handle=session::open_service(client.take().unwrap(),context.connection_id.clone(),context.read_only).await;
+        scope.seal();scope.settle().await;
+        if scope.cancelled() {
+            if let Ok(mut slot)=session::lock_service(&handle,&context.connection_id,context.read_only).await {
+                if let Some(client)=slot.client.take(){drop(deadpool_postgres::Object::take(client));}
+            }
+            session::forget_service(&handle).await;
+            return Err(SpatialError::new("CANCELLED","Session open was cancelled"));
+        }
+        return Ok(json!({"session_handle":handle,"in_transaction":true,"rollback_confirmed":false}));
+    }
+    let handle=context.session_handle.as_deref().ok_or_else(||SpatialError::argument("session_handle is required"))?;
+    let mut slot=tokio::time::timeout(std::time::Duration::from_millis(context.deadline_ms),session::lock_service(handle,&context.connection_id,context.read_only)).await
+        .map_err(|_|SpatialError::new("DEADLINE_EXCEEDED","Session lock deadline exceeded"))??;
+    if method=="service_session_discard" {
+        types::input::<EmptyInput>(params)?;
+        if let Some(client)=slot.client.take(){drop(deadpool_postgres::Object::take(client));}
+        drop(slot);session::forget_service(handle).await;
+        return Ok(json!({"session_handle":handle,"in_transaction":false,"rollback_confirmed":false}));
+    }
+    let input: FinishInput=types::input(params)?;
+    if let Err(error)=verify_transaction(slot.client.as_ref().unwrap(),context.read_only).await {
+        if let Some(client)=slot.client.take(){drop(deadpool_postgres::Object::take(client));}
+        drop(slot);session::forget_service(handle).await;return Err(error);
+    }
+    let mut lease=Lease::Owned(Box::new(slot.client.take()));
+    scope.attach(lease.client(),connection).await;
+    let commit=input.action==Action::Commit;
+    let outcome=lease.finish(&scope,commit,false).await;
+    drop(slot);session::forget_service(handle).await;
+    if let Err(mut error)=outcome {error.details=json!({"session_closed":true});return Err(error);}
+    if scope.cancelled(){
+        let mut error=SpatialError::new("CANCELLED","Session finish was cancelled; rollback was confirmed");
+        error.details=json!({"session_closed":true});return Err(error);
+    }
+    Ok(json!({"session_handle":handle,"in_transaction":false,"rollback_confirmed":!commit}))
+}
diff --git a/src/handlers/spatial/sql.rs b/src/handlers/spatial/sql.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7276bf74a9dceb6e64ae5f4df5f3c94e837d71a8
--- /dev/null
+++ b/src/handlers/spatial/sql.rs
@@ -0,0 +1,116 @@
+use tokio_postgres::types::{ToSql, Type};
+use serde_json::Value;
+
+use crate::utils::identifiers::{qualified,quote_identifier};
+use super::{catalog::{Catalog,TableCatalog,SpatialColumn},table::TableInput,types::RowIdentity, SpatialError};
+
+#[derive(Default)]
+pub struct Sql {
+    pub text: String,
+    pub values: Vec<Box<dyn ToSql + Send + Sync>>,
+    pub types: Vec<Type>,
+}
+impl Sql {
+    pub fn new() -> Self { Self { text: String::new(),values: Vec::new(),types: Vec::new() } }
+    pub fn push<T: ToSql + Send + Sync + 'static>(&mut self,value: T,ty: Type) -> String {
+        self.values.push(Box::new(value));self.types.push(ty);format!("${}",self.values.len())
+    }
+    pub fn references(&self) -> Vec<&(dyn ToSql + Sync)> {
+        self.values.iter().map(|value| value.as_ref() as &(dyn ToSql+Sync)).collect()
+    }
+}
+
+pub fn identity_values(sql: &mut Sql, table: &TableCatalog, identity: &RowIdentity) -> Result<Vec<String>, SpatialError> {
+    validate_keyset(table)?;
+    if identity.columns != table.primary_key || identity.values.len()!=table.primary_key.len()
+        || identity.values.iter().any(Value::is_null) || table.primary_key.is_empty() {
+        return Err(SpatialError::argument("Identity must contain the ordered complete primary key"));
+    }
+    identity.columns.iter().zip(&identity.values).map(|(column,value)| {
+        let ty = table.column_types.get(column).ok_or_else(|| SpatialError::argument("Primary key column does not exist"))?;
+        let text = match value { Value::String(value)=>value.clone(),Value::Number(_) | Value::Bool(_)=>value.to_string(),
+            _=>return Err(SpatialError::argument("Unsupported primary key value")) };
+        let placeholder = sql.push(text,Type::TEXT);
+        Ok(format!("CAST({placeholder} AS {ty})"))
+    }).collect()
+}
+
+pub fn validate_keyset(table: &TableCatalog) -> Result<(),SpatialError> {
+    if !table.keyset_supported {
+        return Err(SpatialError::new("UNSUPPORTED_OPERATION","Primary key type does not support a stable scalar keyset binding"));
+    }
+    Ok(())
+}
+
+pub fn viewport_query(catalog: &Catalog, table: &TableCatalog,column: &SpatialColumn,input: &TableInput,
+    keyset: Option<&RowIdentity>, count: usize) -> Result<Sql, SpatialError> {
+    let viewport=&input.viewport;let source_srid=input.source_srid;let srid_filter=input.srid_filter;
+    let schema=input.table.schema();let name=&input.table.table;
+    let f = |name| catalog.function(name);
+    let mut sql = Sql::new();
+    let geography = column.native_type=="geography";
+    let source = if let Some(known)=column.srid {
+        if source_srid.is_some_and(|source| source!=known) || srid_filter.is_some_and(|filter| filter!=known) {
+            return Err(SpatialError::argument("SRID override/filter conflicts with column SRID"));
+        }
+        known
+    } else {
+        let source = source_srid.filter(|s| (1..=999_999).contains(s))
+            .ok_or_else(|| SpatialError::new("SRID_REQUIRED", "Mixed/unknown table SRIDs require source_srid and srid_filter"))?;
+        let filter = srid_filter.filter(|s| (0..=999_999).contains(s))
+            .ok_or_else(|| SpatialError::new("SRID_REQUIRED", "Mixed/unknown table SRIDs require source_srid and srid_filter"))?;
+        if filter>0 && filter!=source { return Err(SpatialError::argument("source_srid conflicts with selected known SRID")); }
+        source
+    };
+    let pieces = viewport.pieces(geography)?;
+    let full_world=viewport.world && viewport.south== -90.0 && viewport.north==90.0;
+    if geography && !full_world {
+        return Err(SpatialError::new("UNSUPPORTED_OPERATION","Geography viewport coverage is only validated for the full world latitude range"));
+    }
+    if !full_world && !matches!(source,4326|3857) {
+        return Err(SpatialError::new("UNSUPPORTED_OPERATION", "Viewport coverage is only validated for EPSG:4326 and EPSG:3857"));
+    }
+    if !full_world && source==3857 && (viewport.south< -85.05112878 || viewport.north>85.05112878) {
+        return Err(SpatialError::new("UNSUPPORTED_OPERATION", "Viewport exceeds the validated EPSG:3857 latitude range"));
+    }
+    let col = quote_identifier(&column.column);
+    let geometry_type = format!("{}.geometry",quote_identifier(&catalog.schema));
+    let native = if geography { format!("{col}::{geometry_type}") } else { col.clone() };
+    let source_parameter = sql.push(source,Type::INT4);
+    let effective = if column.srid.is_none() {
+        format!("CASE WHEN {}({native})=0 THEN {}({native},{source_parameter}) ELSE {native} END",f("st_srid"),f("st_setsrid"))
+    } else { native.clone() };
+    let mut predicates = vec![format!("{col} IS NOT NULL")];
+    let filter = srid_filter.unwrap_or(source);
+    let filter_parameter = sql.push(filter,Type::INT4);
+    predicates.push(format!("{}({native})={filter_parameter}",f("st_srid")));
+    if !full_world {
+        let mut intersects = Vec::new();
+        for [west,south,east,north] in pieces {
+            let w=sql.push(west,Type::FLOAT8);let s=sql.push(south,Type::FLOAT8);
+            let e=sql.push(east,Type::FLOAT8);let n=sql.push(north,Type::FLOAT8);
+            let boundary = if west==east && south==north { format!("{}({}({w},{s}),4326)",f("st_setsrid"),f("st_makepoint")) }
+                else if west==east || south==north { format!("{}({}({}({w},{s}),{}({e},{n})),4326)",f("st_setsrid"),f("st_makeline"),f("st_makepoint"),f("st_makepoint")) }
+                else { format!("{}({w},{s},{e},{n},4326)",f("st_makeenvelope")) };
+            let boundary = format!("{}({boundary},1.0)",f("st_segmentize"));
+            if geography {
+                intersects.push(format!("{}({col},({boundary})::{}.geography)",f("st_intersects"),quote_identifier(&catalog.schema)));
+            } else {
+                let boundary=format!("{}({boundary},{source_parameter})",f("st_transform"));
+                intersects.push(format!("({native} && {boundary} AND {}({effective},{boundary}))",f("st_intersects")));
+            }
+        }
+        predicates.push(format!("CASE WHEN {}({native})={filter_parameter} THEN ({}) ELSE false END",f("st_srid"),intersects.join(" OR ")));
+    }
+    if let Some(keyset)=keyset {
+        let values = identity_values(&mut sql,table,keyset)?;
+        let columns = table.primary_key.iter().map(|c|quote_identifier(c)).collect::<Vec<_>>();
+        predicates.push(format!("({}) > ({})",columns.join(","),values.join(",")));
+    }
+    let order = if table.primary_key.is_empty() { String::new() } else {
+        format!(" ORDER BY {}",table.primary_key.iter().map(|c|quote_identifier(c)).collect::<Vec<_>>().join(","))
+    };
+    let limit=sql.push(i64::try_from(count).map_err(|_| SpatialError::argument("Invalid row count"))?,Type::INT8);
+    sql.text=format!("SELECT * FROM {} WHERE {}{order} LIMIT {limit}",qualified(schema,name),predicates.join(" AND "));
+    Ok(sql)
+}
diff --git a/src/handlers/spatial/table.rs b/src/handlers/spatial/table.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e3d28a445f0fc61f2d1a3cee42af8a23db027e70
--- /dev/null
+++ b/src/handlers/spatial/table.rs
@@ -0,0 +1,321 @@
+use std::{collections::HashMap,sync::{Arc,LazyLock,Mutex},time::{Duration,Instant}};
+use base64::{engine::general_purpose::URL_SAFE_NO_PAD,Engine};
+use futures_util::{pin_mut,TryStreamExt};
+use serde::{Deserialize,Serialize};
+use serde_json::{json,Map,Value};
+use tokio_postgres::{Client,Row};
+
+use super::{catalog::{self,Catalog,TableCatalog},ewkb::SpatialValue,sql,transform::{self,LongitudeMode},
+    types::{FeatureLimits,RowIdentity,TableRef,Viewport,positions},SpatialError};
+
+#[derive(Clone,Deserialize,Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct TableInput {
+    pub table: TableRef,
+    pub column: String,
+    pub viewport: Viewport,
+    pub source_srid: Option<i32>,
+    pub srid_filter: Option<i32>,
+    #[serde(default)]
+    pub longitude_mode: LongitudeMode,
+    #[serde(default)]
+    pub skip_invalid: bool,
+    pub keyset: Option<RowIdentity>,
+    pub next_token: Option<String>,
+    #[serde(default="page_size")]
+    pub page_size: usize,
+    #[serde(default)]
+    pub limits: FeatureLimits,
+    #[serde(default)]
+    pub export_limit_bytes: Option<usize>,
+}
+fn page_size() -> usize { 1000 }
+
+impl TableInput {
+    pub fn validate(&self) -> Result<(), SpatialError> {
+        match self.export_limit_bytes {
+            Some(limit)=>self.limits.validate_export(limit)?,
+            None=>self.limits.validate()?,
+        }
+        if self.page_size==0 || self.page_size>1000 {return Err(SpatialError::argument("page_size must be between 1 and 1000"));}
+        if self.next_token.is_some() && self.keyset.is_some() {return Err(SpatialError::argument("Specify either keyset or next_token"));}
+        Ok(())
+    }
+}
+
+fn snapshot_input(input: &TableInput) -> TableInput {
+    let mut effective=input.clone();
+    if input.export_limit_bytes.is_some() {
+        let display=FeatureLimits::default();
+        effective.limits.max_features=effective.limits.max_features.min(display.max_features);
+        effective.limits.max_coordinates=effective.limits.max_coordinates.min(display.max_coordinates);
+        effective.limits.max_bytes=effective.limits.max_bytes.min(display.max_bytes);
+    }
+    effective
+}
+
+#[derive(Clone)]
+struct Feature { feature: Value,reference: Value,coordinates: usize,bytes: usize }
+#[derive(Clone,Default)]
+struct Counts { features: usize,coordinates: usize,bytes: usize,ordinal: usize,skipped: usize }
+#[derive(Clone)]
+enum CursorData {
+    Keyset { key: RowIdentity,counts: Counts,truncated: bool },
+    Snapshot { features: Arc<Vec<Feature>>,offset: usize,errors: Arc<Vec<Value>>,warnings: Arc<Vec<String>>,truncated: bool },
+}
+#[derive(Clone)]
+struct Cursor { connection: String,fingerprint: String,expires: Instant,data: CursorData }
+static CURSORS: LazyLock<Mutex<HashMap<String,Cursor>>> = LazyLock::new(||Mutex::new(HashMap::new()));
+
+pub fn invalidate_connection(connection: &str) -> usize {
+    let Ok(mut cursors) = CURSORS.lock() else { return 0; };
+    let before = cursors.len();
+    cursors.retain(|_, cursor| cursor.connection != connection);
+    before - cursors.len()
+}
+
+fn fingerprint(input: &TableInput) -> Result<String,SpatialError> {
+    let mut stable=input.clone();stable.next_token=None;stable.keyset=None;
+    serde_json::to_string(&stable).map_err(|_|SpatialError::argument("Cannot encode cursor source"))
+}
+fn save_cursor(connection: &str,fingerprint: &str,data: CursorData) -> Result<String,SpatialError> {
+    let mut cursors=CURSORS.lock().map_err(|_|SpatialError::new("RESOURCE_LIMIT","Cursor store unavailable"))?;
+    cursors.retain(|_,cursor|cursor.expires>Instant::now());
+    if cursors.len()>=64 { return Err(SpatialError::new("RESOURCE_LIMIT","Cursor store is full")); }
+    let retained=cursors.values().filter_map(|cursor|match &cursor.data {
+        CursorData::Snapshot { features,.. }=>Some(features.iter().map(|feature|feature.bytes).sum::<usize>()),_=>None,
+    }).sum::<usize>();
+    let added=match &data { CursorData::Snapshot { features,.. }=>features.iter().map(|feature|feature.bytes).sum(),_=>0 };
+    if retained+added>128*1024*1024 { return Err(SpatialError::new("RESOURCE_LIMIT","Snapshot store is full")); }
+    let token=uuid::Uuid::new_v4().to_string();
+    cursors.insert(token.clone(),Cursor { connection:connection.into(),fingerprint:fingerprint.into(),
+        expires:Instant::now()+Duration::from_secs(900),data });
+    Ok(token)
+}
+fn take_cursor(connection: &str,fingerprint: &str,token: &str) -> Result<CursorData,SpatialError> {
+    let mut cursors=CURSORS.lock().map_err(|_|SpatialError::new("RESOURCE_LIMIT","Cursor store unavailable"))?;
+    let cursor=cursors.get(token).ok_or_else(||SpatialError::new("INVALID_PAGE_TOKEN","Unknown spatial cursor"))?;
+    if cursor.connection!=connection || cursor.fingerprint!=fingerprint {
+        return Err(SpatialError::new("INVALID_PAGE_TOKEN","Cursor belongs to another connection or viewport"));
+    }
+    if cursor.expires<=Instant::now() { cursors.remove(token);return Err(SpatialError::new("CURSOR_EXPIRED","Spatial cursor expired")); }
+    Ok(cursors.remove(token).unwrap().data)
+}
+
+fn feature_id(identity: &RowIdentity) -> Result<String,SpatialError> {
+    let bytes=serde_json::to_vec(identity).map_err(|_|SpatialError::argument("Invalid feature identity"))?;
+    Ok(format!("pk:{}",URL_SAFE_NO_PAD.encode(bytes)))
+}
+fn original_row(row: &Row,catalog: &Catalog) -> Result<Map<String,Value>,SpatialError> {
+    row.columns().iter().enumerate().map(|(index,column)|
+        crate::extract::extract_value_with_catalog(row,index,Some(catalog)).map(|value|(column.name().to_string(),value))).collect()
+}
+fn identity(properties: &Map<String,Value>,catalog: &TableCatalog) -> Option<RowIdentity> {
+    (!catalog.primary_key.is_empty()).then(||RowIdentity { columns:catalog.primary_key.clone(),
+        values:catalog.primary_key.iter().map(|name|properties.get(name).cloned().unwrap_or(Value::Null)).collect() })
+}
+
+async fn make_feature(client: &Client,catalog: &Catalog,input: &TableInput,properties: Map<String,Value>,
+    identity: Option<RowIdentity>,snapshot: &str,ordinal: usize) -> Result<Feature,SpatialError> {
+    let wrapper: Option<SpatialValue>=serde_json::from_value(properties.get(&input.column).cloned().unwrap_or(Value::Null))
+        .map_err(|_|SpatialError::unsupported("Column is not a spatial scalar"))?;
+    let geometry=match wrapper {
+        None=>Value::Null,Some(wrapper)=>transform::transform_one(client,catalog,&wrapper,input.source_srid,input.longitude_mode).await?,
+    };
+    let coordinates=positions(&geometry)?;
+    let feature_id=match &identity { Some(key)=>feature_id(key)?,None=>format!("{snapshot}:{ordinal}") };
+    let feature=json!({"type":"Feature","id":feature_id,"geometry":geometry,"properties":properties});
+    let mut reference=json!({"feature_id":feature_id,"identity":identity,"row_ordinal":ordinal});
+    if identity.is_none() { reference["snapshot_id"]=json!(snapshot); }
+    let bytes=serde_json::to_vec(&feature).map_err(|_|SpatialError::geometry("Cannot serialize feature"))?.len()
+        +serde_json::to_vec(&reference).map_err(|_|SpatialError::geometry("Cannot serialize reference"))?.len();
+    if coordinates>input.limits.max_coordinates.min(100_000) || bytes>input.limits.max_bytes.min(8*1024*1024) {
+        return Err(SpatialError::new("FEATURE_TOO_LARGE","A complete feature exceeds the page limit"));
+    }
+    Ok(Feature {feature,reference,coordinates,bytes})
+}
+
+fn response(features: &[Feature],next: Option<String>,limits: (bool,Vec<&str>),warnings: Vec<String>,errors: Vec<Value>,materialized: bool) -> Value {
+    let has_more=next.is_some();let (truncated,reasons)=limits;
+    json!({"features":features.iter().map(|f|&f.feature).collect::<Vec<_>>(),
+        "row_references":features.iter().map(|f|&f.reference).collect::<Vec<_>>(),
+        "page":{"next_token":next,"has_more":has_more,"resume_mode":if has_more {if materialized {"materialized"} else {"native"}} else {"none"}},
+        "limits":{"truncated":truncated,"reasons":reasons},"warnings":warnings,"feature_errors":errors})
+}
+
+fn envelope_size(errors: &[Value],warnings: &[String]) -> Result<usize,SpatialError> {
+    let mut reserved=vec!["DIMENSIONS_REDUCED_TO_XY".to_string()];
+    for warning in warnings {if !reserved.contains(warning) {reserved.push(warning.clone());}}
+    let envelope=response(&[],Some("00000000-0000-0000-0000-000000000000".into()),
+        (true,vec!["LAYER_LIMIT","SKIPPED_FEATURES"]),reserved,errors.to_vec(),true);
+    serde_json::to_vec(&envelope).map(|bytes|bytes.len()).map_err(|_|SpatialError::geometry("Cannot encode page envelope"))
+}
+
+fn bounded_response(value: Value,limit: usize) -> Result<Value,SpatialError> {
+    if serde_json::to_vec(&value).map_err(|_|SpatialError::geometry("Cannot serialize feature page"))?.len()>limit.min(8*1024*1024) {
+        if let Some(token)=value["page"]["next_token"].as_str() {
+            if let Ok(mut cursors)=CURSORS.lock(){cursors.remove(token);}
+        }
+        return Err(SpatialError::new("RESOURCE_LIMIT","Feature page exceeds its serialized byte limit"));
+    }
+    Ok(value)
+}
+
+fn bound_snapshot(features: &mut Vec<Feature>,input: &TableInput,errors: &[Value],warnings: &[String]) -> Result<bool,SpatialError> {
+    let overhead=envelope_size(errors,warnings)?;
+    if overhead>input.limits.max_bytes.min(8*1024*1024) {
+        return Err(SpatialError::new("RESOURCE_LIMIT","Snapshot metadata exceeds its byte limit"));
+    }
+    let mut total=0usize;let mut page_bytes=overhead;let mut page_coordinates=0usize;let mut page_features=0usize;
+    let mut accepted=0;
+    for feature in features.iter() {
+        if feature.bytes+2+overhead>input.limits.max_bytes.min(8*1024*1024) {
+            return Err(SpatialError::new("FEATURE_TOO_LARGE","A feature cannot fit in the page envelope"));
+        }
+        if page_features>=input.page_size || page_bytes+feature.bytes+2>input.limits.max_bytes.min(8*1024*1024)
+            || page_coordinates+feature.coordinates>input.limits.max_coordinates.min(100_000) {
+            page_bytes=overhead;page_coordinates=0;page_features=0;
+        }
+        let size=feature.bytes+2+if page_features==0 {overhead}else{0};
+        if total+size>input.limits.max_bytes {break;}
+        total+=size;page_bytes+=feature.bytes+2;page_coordinates+=feature.coordinates;page_features+=1;accepted+=1;
+    }
+    let truncated=accepted<features.len();features.truncate(accepted);Ok(truncated)
+}
+
+fn snapshot_page(connection: &str,fingerprint: &str,input: &TableInput,data: &CursorData) -> Result<Value,SpatialError> {
+    let CursorData::Snapshot {features,offset,errors,warnings,truncated}=data else {unreachable!()};
+    let offset=*offset;let truncated=*truncated;
+    let mut end=offset;let mut coordinates=0;let mut bytes=envelope_size(errors,warnings)?;
+    while end<features.len() && end-offset<input.page_size {
+        let feature=&features[end];
+        if coordinates+feature.coordinates>input.limits.max_coordinates.min(100_000)
+            || bytes+feature.bytes+2>input.limits.max_bytes.min(8*1024*1024) { break; }
+        coordinates+=feature.coordinates;bytes+=feature.bytes+2;end+=1;
+    }
+    if bytes>input.limits.max_bytes.min(8*1024*1024) {return Err(SpatialError::new("RESOURCE_LIMIT","Page metadata exceeds its byte limit"));}
+    if end==offset && end<features.len() {return Err(SpatialError::new("FEATURE_TOO_LARGE","A feature cannot fit in a page"));}
+    let more=end<features.len();
+    let next=if more {Some(save_cursor(connection,fingerprint,CursorData::Snapshot {
+        features:features.clone(),offset:end,errors:errors.clone(),warnings:warnings.clone(),truncated })?)} else {None};
+    let mut reasons=Vec::new();if truncated {reasons.push("LAYER_LIMIT");}
+    if !errors.is_empty(){reasons.push("SKIPPED_FEATURES");}
+    bounded_response(response(&features[offset..end],next,(truncated||!errors.is_empty(),reasons),
+        warnings.as_ref().clone(),errors.as_ref().clone(),true),input.limits.max_bytes)
+}
+
+pub async fn query_table(client: &Client,catalog: &Catalog,connection: &str,input: &TableInput) -> Result<Value,SpatialError> {
+    input.validate()?;
+    let fingerprint=fingerprint(input)?;
+    let cursor=input.next_token.as_deref().map(|token|take_cursor(connection,&fingerprint,token)).transpose()?;
+    if let Some(snapshot @ CursorData::Snapshot {..})=cursor.as_ref() {
+        return snapshot_page(connection,&fingerprint,&snapshot_input(input),snapshot);
+    }
+    let table=catalog::table_columns(client,catalog,input.table.schema(),&input.table.table).await?;
+    sql::validate_keyset(&table)?;
+    let column=table.columns.iter().find(|column|column.column==input.column)
+        .ok_or_else(||SpatialError::unsupported("Column is not a PostGIS geometry/geography scalar"))?;
+    if table.primary_key.is_empty() && input.keyset.is_some() {return Err(SpatialError::argument("Keyset requires a primary key"));}
+    let effective=table.primary_key.is_empty().then(||snapshot_input(input));
+    let input=effective.as_ref().unwrap_or(input);
+    let (mut key,mut counts,mut truncated)=match cursor {
+        Some(CursorData::Keyset {key,counts,truncated})=>(Some(key),counts,truncated),
+        None=>(input.keyset.clone(),Counts::default(),false),_=>unreachable!(),
+    };
+    let remaining=input.limits.max_features.saturating_sub(counts.features);
+    if remaining==0 {return bounded_response(response(&[],None,(true,vec!["LAYER_LIMIT"]),vec![],vec![],false),input.limits.max_bytes);}
+    let count=if table.primary_key.is_empty(){remaining+1}else{input.page_size.min(remaining)+1};
+    let sql=sql::viewport_query(catalog,&table,column,input,key.as_ref(),count)?;
+    let statement=client.prepare_typed(&sql.text,&sql.types).await.map_err(SpatialError::database)?;
+    catalog.validate_columns(statement.columns())?;
+    let mut rows=Vec::new();let mut row_bytes=0usize;let mut raw_limit=false;
+    {
+        let stream=client.query_raw(&statement,sql.references()).await.map_err(SpatialError::database)?;
+        pin_mut!(stream);
+        while let Some(row)=stream.try_next().await.map_err(SpatialError::database)? {
+            let properties=original_row(&row,catalog)?;
+            let size=serde_json::to_vec(&properties).map_err(|_|SpatialError::geometry("Cannot serialize source row"))?.len();
+            if size>32*1024*1024 {return Err(SpatialError::new("FEATURE_TOO_LARGE","A source row exceeds the snapshot limit"));}
+            if row_bytes+size>32*1024*1024 {raw_limit=true;break;}
+            row_bytes+=size;rows.push(properties);
+        }
+    }
+    let snapshot=uuid::Uuid::new_v4().to_string();
+    let mut features=Vec::new();let mut errors=Vec::new();let mut warnings=Vec::new();
+    if table.primary_key.is_empty() && input.export_limit_bytes.is_some() {
+        warnings.push("PRIMARY_KEYLESS_EXPORT_USES_DISPLAY_LIMITS".to_string());
+    }
+    let mut coordinates=0usize;let mut bytes=0usize;let mut has_more=raw_limit;let mut counted_envelope=false;
+    if table.primary_key.is_empty() && raw_limit {truncated=true;}
+    for (raw_ordinal,properties) in rows.into_iter().enumerate() {
+        let row_identity=identity(&properties,&table);
+        if row_identity.as_ref().is_some_and(|identity|identity.values.iter().any(|value|value.is_null()||value.is_array()||value.is_object())) {
+            return Err(SpatialError::new("UNSUPPORTED_OPERATION","Primary key value cannot be represented by a stable scalar keyset binding"));
+        }
+        if !table.primary_key.is_empty() && (features.len()>=input.page_size || raw_ordinal>=count-1) {
+            has_more=true;break;
+        }
+        if input.skip_invalid {client.batch_execute("SAVEPOINT spatial_feature").await.map_err(SpatialError::database)?;}
+        let transformed=make_feature(client,catalog,input,properties,row_identity.clone(),&snapshot,counts.ordinal).await;
+        let feature=match transformed {
+            Ok(feature)=>{
+                if input.skip_invalid {client.batch_execute("RELEASE SAVEPOINT spatial_feature").await.map_err(SpatialError::database)?;}
+                feature
+            }
+            Err(error) if input.skip_invalid && matches!(error.code.as_str(),"UNSUPPORTED_TYPE"|"INVALID_GEOMETRY"|"FEATURE_TOO_LARGE")=>{
+                client.batch_execute("ROLLBACK TO SAVEPOINT spatial_feature; RELEASE SAVEPOINT spatial_feature").await.map_err(SpatialError::database)?;
+                errors.push(json!({"index":counts.ordinal,"code":error.code,"message":error.message}));
+                counts.ordinal+=1;counts.skipped+=1;key=row_identity;continue;
+            }
+            Err(error)=>return Err(error),
+        };
+        let overhead=envelope_size(&errors,&warnings)?;
+        if feature.bytes+2+overhead>input.limits.max_bytes.min(8*1024*1024) {
+            return Err(SpatialError::new("FEATURE_TOO_LARGE","A complete feature cannot fit in the page envelope"));
+        }
+        let addition=feature.bytes+2+if !table.primary_key.is_empty() && !counted_envelope {overhead}else{0};
+        if counts.features+1>input.limits.max_features || counts.coordinates+feature.coordinates>input.limits.max_coordinates
+            || counts.bytes+addition>input.limits.max_bytes {
+            truncated=true;break;
+        }
+        if !table.primary_key.is_empty() && (coordinates+feature.coordinates>100_000 || bytes+feature.bytes+2+overhead>input.limits.max_bytes.min(8*1024*1024)) {
+            if features.is_empty(){return Err(SpatialError::new("FEATURE_TOO_LARGE","A complete feature cannot fit in the page envelope"));}
+            has_more=true;break;
+        }
+        if feature.feature["properties"][&input.column]["dimensions"].as_str().is_some_and(|d|d!="XY")
+            && !warnings.iter().any(|w|w=="DIMENSIONS_REDUCED_TO_XY") {
+            warnings.push("DIMENSIONS_REDUCED_TO_XY".to_string());
+        }
+        counts.features+=1;counts.coordinates+=feature.coordinates;counts.bytes+=addition;counts.ordinal+=1;counted_envelope=true;
+        coordinates+=feature.coordinates;bytes+=feature.bytes+2;key=row_identity;features.push(feature);
+    }
+    if table.primary_key.is_empty() {
+        truncated|=bound_snapshot(&mut features,input,&errors,&warnings)?;
+        return snapshot_page(connection,&fingerprint,input,&CursorData::Snapshot {features:Arc::new(features),offset:0,errors:Arc::new(errors),warnings:Arc::new(warnings),truncated});
+    }
+    if envelope_size(&errors,&warnings)?>input.limits.max_bytes.min(8*1024*1024) {return Err(SpatialError::new("RESOURCE_LIMIT","Page metadata exceeds its byte limit"));}
+    if has_more && (counts.features>=input.limits.max_features || counts.coordinates>=input.limits.max_coordinates
+        || counts.bytes>=input.limits.max_bytes) {has_more=false;truncated=true;}
+    let skipped=counts.skipped;
+    let next=if has_more {Some(save_cursor(connection,&fingerprint,CursorData::Keyset {
+        key:key.ok_or_else(||SpatialError::new("FEATURE_TOO_LARGE","No feature can fit in a page"))?,counts,truncated })?)} else {None};
+    let mut reasons=Vec::new();if truncated{reasons.push("LAYER_LIMIT");}
+    if skipped>0{reasons.push("SKIPPED_FEATURES");}
+    bounded_response(response(&features,next,(truncated||skipped>0,reasons),warnings,errors,false),input.limits.max_bytes)
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ReadInput {pub table: TableRef,pub identity: RowIdentity}
+
+pub async fn read_feature(client: &Client,catalog: &Catalog,input: &ReadInput) -> Result<Value,SpatialError> {
+    let table=catalog::table_columns(client,catalog,input.table.schema(),&input.table.table).await?;
+    let mut sql=sql::Sql::new();let values=sql::identity_values(&mut sql,&table,&input.identity)?;
+    let predicate=table.primary_key.iter().zip(values).map(|(column,value)|format!("{}={value}",crate::utils::identifiers::quote_identifier(column)))
+        .collect::<Vec<_>>().join(" AND ");
+    sql.text=format!("SELECT * FROM {} WHERE {predicate}",crate::utils::identifiers::qualified(input.table.schema(),&input.table.table));
+    let statement=client.prepare_typed(&sql.text,&sql.types).await.map_err(SpatialError::database)?;
+    catalog.validate_columns(statement.columns())?;
+    let row=client.query_opt(&statement,&sql.references()).await.map_err(SpatialError::database)?;
+    Ok(json!({"row":row.as_ref().map(|row|original_row(row,catalog)).transpose()?,"identity":input.identity,"source":"current_row"}))
+}
diff --git a/src/handlers/spatial/transform.rs b/src/handlers/spatial/transform.rs
new file mode 100644
index 0000000000000000000000000000000000000000..5bdf00cd7c411968e0fcc73b379fed891c79e6e2
--- /dev/null
+++ b/src/handlers/spatial/transform.rs
@@ -0,0 +1,188 @@
+use serde::Deserialize;
+use serde_json::{json, Value};
+use tokio_postgres::Client;
+
+use super::{catalog::Catalog, ewkb::SpatialValue, types::positions, SpatialError};
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct TransformInput {
+    pub values: Vec<Option<SpatialValue>>,
+    pub source_srid: Option<i32>,
+    #[serde(default)]
+    pub longitude_mode: LongitudeMode,
+    #[serde(default)]
+    pub skip_invalid: bool,
+}
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, serde::Serialize, PartialEq)]
+#[serde(rename_all = "snake_case")]
+pub enum LongitudeMode { #[default] Preserve, Shortest }
+
+pub fn validate_source(value: &SpatialValue, source: Option<i32>) -> Result<i32, SpatialError> {
+    if source.is_some_and(|s| !(1..=999_999).contains(&s)) {
+        return Err(SpatialError::argument("source_srid must be between 1 and 999999"));
+    }
+    let (_, info) = value.bytes()?;
+    if !info.supported { return Err(SpatialError::unsupported("Curves, TIN and polyhedral surfaces cannot be displayed")); }
+    if info.invalid_xy { return Err(SpatialError::geometry("Non-finite XY coordinates cannot be displayed")); }
+    if let Some(srid) = info.srid {
+        if source.is_some_and(|source| source != srid) {
+            return Err(SpatialError::argument("source_srid conflicts with the original SRID"));
+        }
+        Ok(srid)
+    } else { source.ok_or_else(|| SpatialError::new("SRID_REQUIRED", "An explicit source_srid is required")) }
+}
+
+pub async fn transform_values(client: &Client, catalog: &Catalog, input: &TransformInput) -> Result<Value, SpatialError> {
+    if input.values.len() > 128 { return Err(SpatialError::argument("Transform batches cannot exceed 128 values")); }
+    let mut geometries = Vec::with_capacity(input.values.len());
+    let mut errors = Vec::new();
+    let mut warnings = Vec::new();
+    let mut bytes = 0usize;
+    let mut coordinates = 0usize;
+    for (index,value) in input.values.iter().enumerate() {
+        if input.skip_invalid { client.batch_execute("SAVEPOINT spatial_transform").await.map_err(SpatialError::database)?; }
+        let result = match value {
+            None => Ok(Value::Null),
+            Some(value) => transform_one(client,catalog,value,input.source_srid,input.longitude_mode).await,
+        };
+        let result = result.and_then(|geometry| {
+            let n = positions(&geometry)?;
+            let size = serde_json::to_vec(&geometry).map_err(|_| SpatialError::geometry("Cannot encode GeoJSON"))?.len();
+            if n > 100_000 || size > 8*1024*1024 {
+                return Err(SpatialError::new("FEATURE_TOO_LARGE", "A geometry exceeds the page limit"));
+            }
+            if coordinates+n>100_000 || bytes+size>8*1024*1024 {
+                return Err(SpatialError::new("RESOURCE_LIMIT", "Transform batch exceeds the page limit"));
+            }
+            coordinates += n; bytes += size;
+            Ok(geometry)
+        });
+        match result {
+            Ok(geometry) => {
+                if input.skip_invalid { client.batch_execute("RELEASE SAVEPOINT spatial_transform").await.map_err(SpatialError::database)?; }
+                if value.as_ref().is_some_and(|value| value.dimensions!="XY")
+                    && !warnings.contains(&"DIMENSIONS_REDUCED_TO_XY") {
+                    warnings.push("DIMENSIONS_REDUCED_TO_XY");
+                }
+                geometries.push(geometry);
+            }
+            Err(error) if input.skip_invalid && matches!(error.code.as_str(), "UNSUPPORTED_TYPE"|"INVALID_GEOMETRY"|"FEATURE_TOO_LARGE") => {
+                client.batch_execute("ROLLBACK TO SAVEPOINT spatial_transform; RELEASE SAVEPOINT spatial_transform")
+                    .await.map_err(SpatialError::database)?;
+                errors.push(json!({ "index": index, "code": error.code, "message": error.message }));
+                geometries.push(Value::Null);
+            }
+            Err(error) => return Err(error),
+        }
+    }
+    let result=json!({ "geometries": geometries,"feature_errors": errors,"warnings": warnings,
+        "limits": { "truncated": !errors.is_empty(), "reasons": if errors.is_empty() { vec![] } else { vec!["SKIPPED_FEATURES"] } } });
+    if serde_json::to_vec(&result).map_err(|_|SpatialError::geometry("Cannot encode transform result"))?.len()>8*1024*1024 {
+        return Err(SpatialError::new("RESOURCE_LIMIT","Transform result exceeds the byte limit"));
+    }
+    Ok(result)
+}
+
+pub async fn transform_one(client: &Client, catalog: &Catalog, value: &SpatialValue,
+    source: Option<i32>, mode: LongitudeMode) -> Result<Value, SpatialError> {
+    if value.value.len() > 12*1024*1024 { return Err(SpatialError::new("FEATURE_TOO_LARGE", "EWKB exceeds the input limit")); }
+    let (bytes, info) = value.bytes()?;
+    if info.positions > 100_000 || bytes.len() > 8*1024*1024 {
+        return Err(SpatialError::new("FEATURE_TOO_LARGE", "EWKB exceeds the page limit"));
+    }
+    let source = validate_source(value,source)?;
+    let f = |name| catalog.function(name);
+    let decoded = format!("{}($1::bytea)",f("st_geomfromewkb"));
+    let g = format!("CASE WHEN {}({decoded})=0 THEN {}({decoded},$2::integer) ELSE {decoded} END",f("st_srid"),f("st_setsrid"));
+    let geography = value.native_type=="geography";
+    let type_name = format!("{}.geography", crate::utils::identifiers::quote_identifier(&catalog.schema));
+    let display = if geography {
+        format!("{}({}(({}(g))::{} ,100000.0)::{}.geometry,4326)",f("st_transform"),f("st_segmentize"),f("st_force2d"),type_name,
+            crate::utils::identifiers::quote_identifier(&catalog.schema))
+    } else { format!("{}({}(g),4326)",f("st_transform"),f("st_force2d")) };
+    let polar = if geography {
+        format!("CASE WHEN {}(g) IN ('ST_Polygon','ST_MultiPolygon') THEN \
+            {}(g::{type_name}) >= 255032810862044.0 OR \
+            {}(g::{type_name},{}({}(0,90),4326)::{type_name}) OR \
+            {}(g::{type_name},{}({}(0,-90),4326)::{type_name}) ELSE false END",
+            f("st_geometrytype"),f("st_area"),f("st_intersects"),f("st_setsrid"),f("st_makepoint"),
+            f("st_intersects"),f("st_setsrid"),f("st_makepoint"))
+    } else { "false".into() };
+    let sql = format!("WITH original AS (SELECT {g} AS g), display AS \
+        (SELECT {}({display}) AS d,{}(g) AS valid,{polar} AS polar FROM original), oriented AS \
+        (SELECT CASE WHEN {}(d) IN ('ST_Polygon','ST_MultiPolygon') THEN {}(d) ELSE d END AS d,valid,polar FROM display) \
+        SELECT valid,polar,{}(d,15,0)::jsonb,{}(d) FROM oriented",
+        f("st_force2d"),f("st_isvalid"),f("st_geometrytype"),f("st_forcepolygonccw"),f("st_asgeojson"),f("st_asewkb"));
+    let row = client.query_one(&sql,&[&bytes,&source]).await.map_err(SpatialError::database)?;
+    if row.get::<_,bool>(1) { return Err(SpatialError::unsupported("Hemisphere and polar geography polygons cannot be displayed")); }
+    if !row.get::<_,bool>(0) { return Err(SpatialError::geometry("Invalid geometry; no automatic repair was applied")); }
+    let mut geometry: Value = row.get(2);
+    orient_polygons(&mut geometry);
+    if !geography && mode==LongitudeMode::Preserve { return Ok(geometry); }
+    let display_bytes: Vec<u8> = row.get(3);
+    let sql = format!("SELECT ({}({}($1::bytea))).geom AS g",f("st_dump"),f("st_geomfromewkb"));
+    let components = client.query(&sql,&[&display_bytes]).await.map_err(SpatialError::database)?;
+    let mut transformed = Vec::new();
+    for component in components {
+        let raw = crate::extract::extract_value_checked(&component,0)?;
+        let component: SpatialValue = serde_json::from_value(raw).map_err(|_| SpatialError::geometry("Invalid display component"))?;
+        let (component_bytes,_) = component.bytes()?;
+        let json_sql = format!("SELECT {}({}($1::bytea),15,0)::jsonb",f("st_asgeojson"),f("st_geomfromewkb"));
+        let component_json: Value = client.query_one(&json_sql,&[&component_bytes]).await.map_err(SpatialError::database)?.get(0);
+        let (dateline,greenwich) = component_edges(&component_json);
+        if dateline && greenwich { return Err(SpatialError::unsupported("A connected component requires ambiguous Greenwich/dateline normalization")); }
+        let shifted = if dateline { format!("{}(g)",f("st_shiftlongitude")) } else { "g".into() };
+        let sql = format!("SELECT {}({}({shifted},180,-360),15,0)::jsonb \
+            FROM (SELECT {}($1::bytea) AS g) component",f("st_asgeojson"),f("st_wrapx"),f("st_geomfromewkb"));
+        let mut normalized: Value = client.query_one(&sql,&[&component_bytes]).await.map_err(SpatialError::database)?.get(0);
+        orient_polygons(&mut normalized);
+        transformed.push(normalized);
+    }
+    if transformed.len()==1 { Ok(transformed.remove(0)) }
+    else if transformed.is_empty() { Ok(geometry) }
+    else { Ok(json!({ "type": "GeometryCollection", "geometries": transformed })) }
+}
+
+fn orient_polygons(geometry: &mut Value) {
+    fn polygon(value: &mut Value) {
+        let Some(rings)=value.as_array_mut() else {return;};
+        for (index,ring) in rings.iter_mut().enumerate() {
+            let Some(points)=ring.as_array_mut() else {continue;};
+            let area=points.windows(2).map(|edge| {
+                let a=&edge[0];let b=&edge[1];
+                a[0].as_f64().unwrap_or(0.0)*b[1].as_f64().unwrap_or(0.0)
+                    -b[0].as_f64().unwrap_or(0.0)*a[1].as_f64().unwrap_or(0.0)
+            }).sum::<f64>();
+            if (index==0 && area<0.0)||(index>0 && area>0.0) {points.reverse();}
+        }
+    }
+    match geometry["type"].as_str() {
+        Some("Polygon")=>polygon(&mut geometry["coordinates"]),
+        Some("MultiPolygon")=>if let Some(polygons)=geometry["coordinates"].as_array_mut(){
+            for value in polygons {polygon(value);}
+        },
+        Some("GeometryCollection")=>if let Some(geometries)=geometry["geometries"].as_array_mut(){
+            for geometry in geometries {orient_polygons(geometry);}
+        },
+        _=>{},
+    }
+}
+
+fn component_edges(geometry: &Value) -> (bool,bool) {
+    fn visit(value: &Value, flags: &mut (bool,bool)) {
+        let Some(values) = value.as_array() else { return; };
+        if values.first().is_some_and(|v| v.as_array().is_some_and(|p| p.first().is_some_and(Value::is_number))) {
+            for edge in values.windows(2) {
+                let a = edge[0][0].as_f64().unwrap_or(0.0);
+                let b = edge[1][0].as_f64().unwrap_or(0.0);
+                if (a-b).abs()>180.0 { flags.0 = true; }
+                else if a*b<0.0 { flags.1 = true; }
+            }
+        } else { for value in values { visit(value,flags); } }
+    }
+    let mut flags = (false,false);
+    visit(&geometry["coordinates"],&mut flags);
+    flags
+}
diff --git a/src/handlers/spatial/types.rs b/src/handlers/spatial/types.rs
new file mode 100644
index 0000000000000000000000000000000000000000..e5f2bf157a442ff3e736aace9eef43eafc2d7647
--- /dev/null
+++ b/src/handlers/spatial/types.rs
@@ -0,0 +1,171 @@
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+use crate::models::ConnectionParams;
+use super::SpatialError;
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct DriverContext {
+    pub protocol_version: u32,
+    pub connection_id: String,
+    pub request_id: String,
+    #[serde(default = "deadline")]
+    pub deadline_ms: u64,
+    #[serde(default = "read_only")]
+    pub read_only: bool,
+    #[serde(default)]
+    pub auth: Option<Value>,
+    #[serde(default)]
+    pub session_handle: Option<String>,
+}
+fn deadline() -> u64 { 30_000 }
+fn read_only() -> bool { true }
+
+impl DriverContext {
+    pub fn parse(params: &Value, spatial: bool) -> Result<(Self, ConnectionParams), SpatialError> {
+        let context: Self = serde_json::from_value(params.get("driver_context").cloned().unwrap_or(Value::Null))
+            .map_err(|_| SpatialError::argument("driver_context is required"))?;
+        if context.protocol_version != 1 { return Err(SpatialError::new("PROTOCOL_MISMATCH", "Unsupported driver protocol")); }
+        if context.connection_id.is_empty() || context.connection_id.chars().count() > 128
+            || context.request_id.is_empty() || context.request_id.chars().count() > 128
+            || context.deadline_ms == 0 || context.deadline_ms > 120_000 {
+            return Err(SpatialError::argument("Invalid driver context"));
+        }
+        if spatial && !context.read_only { return Err(SpatialError::new("WRITE_NOT_ALLOWED", "Spatial operations require read-only context")); }
+        let connection = params.get("params").filter(|p| p.is_object())
+            .ok_or_else(|| SpatialError::argument("Connection params are required"))?;
+        let mut connection = ConnectionParams::from_value(connection);
+        if let Some(auth) = &context.auth {
+            #[derive(Deserialize)]
+            #[serde(deny_unknown_fields)]
+            struct PasswordAuth { kind: String, password: String, identity: String }
+            if auth.get("kind").and_then(Value::as_str) != Some("db_password") {
+                return Err(SpatialError::new("UNSUPPORTED_OPERATION", "Unsupported PostgreSQL authentication kind"));
+            }
+            let auth: PasswordAuth = serde_json::from_value(auth.clone()).map_err(|_| SpatialError::argument("Invalid database authentication context"))?;
+            if auth.kind != "db_password" || auth.identity.is_empty() || auth.identity.chars().count() > 512 {
+                return Err(SpatialError::argument("Invalid database authentication identity"));
+            }
+            connection.password = Some(auth.password);
+        }
+        Ok((context, connection))
+    }
+}
