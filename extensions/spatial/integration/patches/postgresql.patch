+    // given
+    let fixture = Fixture::new("spatial_fixture").await;
+    let other = format!("{}-other",fixture.schema);
+    let first = fixture.open(&fixture.schema,true).await;
+    let second = fixture.open(&other,true).await;
+    let legacy_id = format!("{}-legacy",fixture.schema);
+    let legacy = fixture.send(json!({"jsonrpc":"2.0","id":8,"method":"execute_query_batch","params":{"params":fixture.params,"session_id":legacy_id,"queries":["BEGIN","SELECT pg_backend_pid()"]}})).await;
+    // when
+    let (invalidated,dead,alive,legacy_after) = fixture.invalidate_isolation(first,second,&other,&legacy_id).await;
+    // then
+    assert_eq!(invalidated["result"]["accepted"],true);
+    assert_eq!(invalidated["result"]["discarded_sessions"],1);
+    assert!(invalidated["result"].get("rollback_confirmed").is_none());
+    assert_eq!(dead["error"]["data"]["code"],"CURSOR_EXPIRED");
+    assert!(alive.get("error").is_none(),"{alive}");
+    assert!(legacy_after.get("error").is_none(),"{legacy_after}");
+    assert_eq!(legacy_after["result"]["results"][0]["rows"][0][0],legacy["result"]["results"][1]["rows"][0][0]);
+}
