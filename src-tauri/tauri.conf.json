{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tabularis Extended",
  "mainBinaryName": "tabularis-extended",
  "version": "0.27.0+extended.1",
  "identifier": "io.github.hei5enbug.tabularis.extended",
  "build": {
    "frontendDist": "../packages/web-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Tabularis Extended",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#020617"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/connection-icons/**"
        ]
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "active": true,
    "category": "DeveloperTool",
    "targets": "all",
    "resources": {
      "../packages/web-ui/dist/": "web-ui/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libsecret-1-0"
        ],
        "desktopTemplate": "linux/tabularis-extended.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/tabularis-extended.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "tabularis-extended"
        ]
      }
    }
  }
}